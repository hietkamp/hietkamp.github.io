{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import hero %}

{% block content %}
{{ hero(hero_data) }}

{% for group in workproduct_groups %}
<h2 class="m-0 mb-3{% if not loop.first %} mt-10{% else %} mt-8{% endif %} border-b border-slate-300 pb-2 font-serif text-[1.6rem] font-semibold text-slate-900">{{ group.practice }}</h2>
<div class="wp-grid grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-3.5">
  {% for wp in group.workproducts %}
  <a href="{{ wp.href }}" class="wp-card">
    <div class="wc-top {{ wp.topbar }}"></div>
    <div class="wc-body">
      <h4>{{ wp.title }}</h4>
      <p>{{ wp.desc }}</p>
      <div class="wc-open">Bekijk werkproduct →</div>
    </div>
  </a>
  {% endfor %}
</div>
{% endfor %}
{% endblock %}
