{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import breadcrumb, hero, panel, act_space, rdf_prose %}
{% from "_card_activity.html.j2" import activity_card %}

{% block content %}
{{ breadcrumb(crumbs) }}
{{ hero(hero_data) }}

{% if inherited_context %}
<div class="context-banner mb-6 grid grid-cols-[auto_1fr] items-start gap-4 rounded-xl border border-l-4 border-slate-700/20 border-l-slate-700 bg-slate-700/5 px-5 py-4 [&_.ctx-icon]:text-[1.6rem] [&_.ctx-icon]:leading-none [&_.ctx-body_h3]:m-0 [&_.ctx-body_h3]:mb-1 [&_.ctx-body_h3]:font-serif [&_.ctx-body_h3]:text-[1.05rem] [&_.ctx-body_h3]:font-semibold [&_.ctx-body_h3]:text-slate-700 [&_.ctx-body_p]:m-0 [&_.ctx-body_p]:text-[0.88rem] [&_.ctx-body_p]:text-slate-500 [&_.ctx-body_a]:font-semibold [&_.ctx-body_a]:text-slate-700 [&_.ctx-body_a]:no-underline hover:[&_.ctx-body_a]:underline">
  <div class="ctx-icon">⤵</div>
  <div class="ctx-body">
    <h3>{{ inherited_context.title }}</h3>
    <p>{{ inherited_context.body | safe }}</p>
  </div>
</div>
{% endif %}

<section class="sec mt-[38px] scroll-mt-[164px]" id="process">
  <h2 class="sh m-0 mb-1 font-serif text-[1.4rem] font-semibold">{{ activities.title }}</h2>
  {{ rdf_prose(activities.intro, 'sec-intro my-1.5 mb-[18px]') }}

  {% if activities.domains_title %}
  <h2 class="sh m-0 mb-3 mt-[26px] font-serif text-[1.4rem] font-semibold">{{ activities.domains_title }}</h2>
  {% endif %}

  <div class="amap mt-2 flex flex-col">
    {% for domain in activities.domains %}

    <div class="amap-domain overflow-hidden rounded-2xl border-[1.5px] border-slate-300 bg-white">
      <div class="amap-dhdr flex flex-wrap items-center justify-between gap-2 px-[22px] py-[13px] {% if domain.header_light %}text-slate-800{% else %}text-white{% endif %} [&_.amap-dname]:font-mono [&_.amap-dname]:text-[11px] [&_.amap-dname]:font-bold [&_.amap-dname]:uppercase [&_.amap-dname]:tracking-[0.2em] [&_.amap-dalphas]:font-mono [&_.amap-dalphas]:text-[9.5px] [&_.amap-dalphas]:tracking-wide [&_.amap-dalphas]:opacity-80 {{ domain.css }} bg-gradient-to-br {{ domain.gradient }}">
        <span class="amap-dname">{{ domain.name }}</span>
        <span class="amap-dalphas">{{ domain.alphas }}</span>
      </div>
      <div class="amap-body flex flex-col gap-3 px-5 py-[18px]">
        {% if domain.desc_html %}
        {{ rdf_prose(domain.desc_html, 'amap-dphase-desc border-b border-dashed border-slate-300 pb-3') }}
        {% endif %}
        {% for item in domain['items'] %}
          {% if item.type == 'space' or item.type == 'space_gap' %}
            {{ act_space({'code': item.code, 'name': item.name, 'desc': item.desc | default(''), 'gap': item.type == 'space_gap'}) }}
          {% elif item.type == 'activity' %}
            {{ activity_card(item, href=item.href|default('#'), num_color=item.num_color|default(domain.num_color, true), num_text_color=item.num_text_color|default(domain.num_text_color|default('text-white'), true), spoor=spoor) }}
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% set conn = domain.connector_after | default({}) %}
    {% if not loop.last or (conn is mapping and conn.is_gate) %}
    {% if conn is mapping and conn.is_gate %}
    <div class="amap-conn-gate relative my-0">
      <div class="absolute left-1/2 top-0 h-3 w-px -translate-x-1/2 bg-slate-300"></div>
      <div class="mx-auto mt-3 flex items-start gap-3 rounded-lg border border-indigo-500 bg-indigo-100 px-5 py-3 shadow-sm">
        <span class="mt-0.5 shrink-0 text-base font-bold text-indigo-700">✓</span>
        <div class="min-w-0 flex-1">
          <div class="text-sm font-semibold text-indigo-900">{{ conn.name }}</div>
          {% if conn.brief %}<div class="mt-0.5 text-xs text-indigo-600">{{ conn.brief }}</div>{% endif %}
          {% if conn.govern_href %}<a href="{{ conn.govern_href }}" class="mt-1.5 inline-flex items-center gap-1 rounded-full border border-indigo-500 bg-white px-2.5 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-[0.1em] text-indigo-700 hover:bg-indigo-50">→ {{ conn.govern_name }}</a>{% endif %}
        </div>
      </div>
      <div class="mx-auto mt-0 h-4 w-px bg-slate-300"></div>
    </div>
    {% else %}
    <div class="amap-conn relative flex h-9 items-center justify-center before:absolute before:bottom-0 before:left-1/2 before:top-0 before:w-px before:-translate-x-1/2 before:bg-slate-300 before:content-['']"><span class="amap-conn-lbl relative z-[1] rounded-full border border-slate-300 bg-white px-3.5 py-1 font-mono text-[10px] uppercase tracking-[0.1em] text-slate-500">↓</span></div>
    {% endif %}
    {% endif %}

    {% endfor %}

    <div class="amap-legend mt-3 flex flex-wrap gap-3.5 font-mono text-[10px] tracking-wide">
      <div class="amap-li flex items-center gap-[7px] text-slate-500"><div class="amap-li-dot h-2.5 w-2.5 shrink-0 rounded-sm analyse bg-blue-700"></div> Analyse-fase (01–02)</div>
      <div class="amap-li flex items-center gap-[7px] text-slate-500"><div class="amap-li-dot h-2.5 w-2.5 shrink-0 rounded-sm dev bg-slate-700"></div> Ontwerp- en ontwikkelwerk (03–06)</div>
      <div class="amap-li flex items-center gap-[7px] text-slate-500"><div class="amap-li-dot h-2.5 w-2.5 shrink-0 rounded-sm gap border border-orange-700/30 bg-orange-700/15"></div> Werkgebied niet gedekt in deze practiceset</div>
    </div>
  </div>
</section>

{% if diff_grid %}
<section class="sec mt-[38px] scroll-mt-[164px]" id="niveaus">
  <h2 class="sh m-0 mb-1 font-serif text-[1.4rem] font-semibold">{{ diff_grid.title }}</h2>
  <div class="diff-grid grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
    {% for card in diff_grid.cards %}
    <div class="diff-card overflow-hidden rounded-[13px] border border-slate-300 [&_.dc-head]:px-4 [&_.dc-head]:py-[11px] [&_.dc-head]:text-white [&_.dc-level]:mb-0.5 [&_.dc-level]:font-mono [&_.dc-level]:text-[9px] [&_.dc-level]:uppercase [&_.dc-level]:tracking-[0.18em] [&_.dc-level]:opacity-85 [&_.dc-head_h3]:m-0 [&_.dc-head_h3]:font-serif [&_.dc-head_h3]:text-[1.05rem] [&_.dc-head_h3]:font-semibold [&_.dc-body]:bg-white [&_.dc-body]:px-4 [&_.dc-body]:py-[13px] [&_.dc-body_p]:m-0 [&_.dc-body_p]:mb-2 [&_.dc-body_p]:text-[0.88rem] [&_.dc-body_p]:text-slate-500 [&_.dc-body_ul]:m-0 [&_.dc-body_ul]:pl-[18px] [&_.dc-body_ul]:text-[0.88rem] [&_.dc-body_ul]:text-slate-500 dc-{{ card.id }} [&_.dc-head]:{{ card.head_color }}">
      <div class="dc-head">
        <div class="dc-level">{{ card.level }}</div>
        <h3>{{ card.role }}</h3>
      </div>
      <div class="dc-body">
        <ul>
          {% for item in card['items'] %}<li>{{ item | safe }}</li>{% endfor %}
        </ul>
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if role %}
<section class="sec mt-[38px] scroll-mt-[164px]" id="roles">
  <h2 class="sh m-0 mb-1 font-serif text-[1.4rem] font-semibold">Rol</h2>
  <p class="sec-intro my-1.5 mb-[18px] text-[0.98rem] text-slate-500">{{ role.intro }}</p>
  <div class="role-grid mt-3.5 grid grid-cols-1 gap-4 max-w-[600px] max-[900px]:grid-cols-1">
    <div class="role-card overflow-hidden rounded-[13px] border border-slate-300 [&_.rc-head]:flex [&_.rc-head]:flex-col [&_.rc-head]:gap-[3px] [&_.rc-head]:px-4 [&_.rc-head]:py-[13px] [&_.rc-head]:text-white [&_.rc-level]:font-mono [&_.rc-level]:text-[9px] [&_.rc-level]:uppercase [&_.rc-level]:tracking-[0.18em] [&_.rc-level]:opacity-85 [&_.rc-head_h3]:m-0 [&_.rc-head_h3]:font-serif [&_.rc-head_h3]:text-[1.15rem] [&_.rc-head_h3]:font-semibold [&_.rc-body]:bg-white [&_.rc-body]:px-4 [&_.rc-body]:py-[13px] [&_.rc-body_p]:m-0 [&_.rc-body_p]:mb-2.5 [&_.rc-body_p]:text-[0.88rem] [&_.rc-body_p]:text-slate-500 rc-{{ role.id }} [&_.rc-head]:{{ role.head_color }}">
      <div class="rc-head">
        <span class="rc-level">{{ role.level }}</span>
        <h3>{{ role.name }}</h3>
      </div>
      <div class="rc-body">
        <p>{{ role.desc }}</p>
        <div class="rc-comps flex flex-wrap gap-[5px]">
          {% for comp in role.competencies %}
          <span class="rc-comp rounded-full border border-indigo-700/20 bg-indigo-700/10 px-[9px] py-[3px] font-mono text-[9.5px] font-semibold text-indigo-700">{{ comp }}</span>
          {% endfor %}
        </div>
        <div class="rc-acts mt-2.5 border-t border-dashed border-slate-300 pt-2 font-mono text-[0.8rem] text-slate-500 [&_b]:text-slate-900"><b>Primair eigenaar van:</b> {{ role.owns }}</div>
      </div>
    </div>
  </div>
</section>
{% endif %}

<div class="panel transition-shadow mt-[18px] rounded-[13px] border border-l-4 border-slate-300 border-l-[var(--prac)] bg-slate-50 px-5 py-[18px] [&_h3]:m-0 [&_h3]:mb-1.5 [&_h3]:font-serif [&_h3]:text-[1.16rem] [&_p]:mb-2.5 [&_p]:text-[0.95rem] [&_p]:text-slate-500 [&_p:last-child]:mb-0 [&_a]:font-semibold [&_a]:text-[var(--prac)] [&_a]:no-underline hover:[&_a]:underline">
  <h3>{{ closing_panel.title }}</h3>
  {% for para in closing_panel.body %}<p>{{ para | safe }}</p>{% endfor %}
</div>
{% endblock %}
