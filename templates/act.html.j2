{% extends "_base.html.j2" %}
{% block content %}
<div class="breadcrumb flex flex-wrap items-center gap-2 pt-[18px] font-mono text-[11px] text-slate-500 [&_a]:font-semibold [&_a]:text-[var(--prac)] [&_a]:no-underline hover:[&_a]:underline">
  {% for parent in breadcrumb.parents %}
  <a href="{{ parent.href }}">{{ parent.label }}</a>
  <span>›</span>
  {% endfor %}
  <span>{{ breadcrumb.current }}</span>
</div>

<header class="hero border-b-2 border-[var(--prac)] py-14 pb-8 [&_h1]:m-0 [&_h1]:mb-[0.45em] [&_h1]:font-serif [&_h1]:text-[clamp(2.3rem,5.6vw,4.4rem)] [&_h1]:font-black [&_h1]:leading-none [&_h1_em]:font-medium [&_h1_em]:italic [&_h1_em]:text-[var(--prac)] max-[600px]:py-8 max-[600px]:pb-4 max-[600px]:[&_h1]:text-[clamp(1.9rem,8vw,3rem)]">
  <div class="act-meta mb-4 flex flex-wrap items-center gap-2">
    {% if act_num %}<span class="act-num rounded-full border-[1.5px] border-blue-700 px-3 py-1 font-mono text-[11px] font-bold uppercase tracking-[0.1em] text-blue-700">{{ act_num }}</span>{% endif %}
    {% if chips is defined and chips.space is defined %}<span class="act-chip rounded-full border px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.12em] chip-space border-blue-700/25 bg-blue-700/10 text-blue-700">{{ chips.space }}</span>{% endif %}
    {% if chips is defined and chips.comp is defined %}<span class="act-chip rounded-full border px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.12em] chip-comp border-indigo-700/25 bg-indigo-700/10 text-indigo-700">{{ chips.comp }}</span>{% endif %}
    {% for chip in extra_chips | default([]) %}
    <span class="act-chip rounded-full border px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.12em] {{ chip.css }}">{{ chip.label }}</span>
    {% endfor %}
    <span class="act-chip rounded-full border px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.12em] chip-prac border-emerald-700/25 bg-emerald-700/10 text-[var(--prac)]">MVA</span>
  </div>
  <h1>{{ act_name | default(title) | default('') }}</h1>
  {% if title_en %}<p class="hero-title-en m-0 -mt-[0.25em] mb-[0.5em] font-serif italic text-[clamp(1.5rem,3.8vw,3rem)] font-normal leading-tight text-slate-500">{{ title_en }}</p>{% endif %}
  <p class="lede m-0 text-[clamp(1rem,1.5vw,1.16rem)] leading-relaxed text-slate-500">{{ lede | default(desc) | default('') }}</p>
  {% if alpha_bar %}
  <div class="alpha-bar mt-5 flex flex-wrap items-center gap-2 rounded-[10px] border border-[var(--prac)]/20 bg-slate-50 px-3.5 py-2.5 font-mono text-[11px]">
    <span class="ab-label font-bold tracking-wide text-[var(--prac)]">Beweegt de alphas:</span>
    <span class="ab-states text-slate-500 [&_b]:text-[var(--prac)]">{{ alpha_bar | safe }}</span>
  </div>
  {% endif %}
</header>

{% if sequence %}
<div class="act-sequence mt-6 flex flex-wrap items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-[0.82rem]">
  <span class="shrink-0 font-mono text-[9px] font-bold uppercase tracking-[0.14em] text-slate-400">Volgorde</span>
  {% for pre in sequence.predecessors %}
  <a href="{{ pre.href }}" class="inline-flex items-center gap-1 rounded-full border border-slate-300 bg-white px-2.5 py-1 font-medium text-slate-600 no-underline transition hover:border-[var(--prac)] hover:text-[var(--prac)]">
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 2L3 5l3 3"/></svg>
    {{ pre.name }}
  </a>
  {% endfor %}
  {% if sequence.predecessors %}
  <svg class="shrink-0 text-slate-300" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 8h8M9 5l3 3-3 3"/></svg>
  {% endif %}
  <span class="inline-flex items-center rounded-full border-[1.5px] border-[var(--prac)] bg-white px-2.5 py-1 font-semibold text-[var(--prac)]">{{ act_name }}</span>
  {% if sequence.successors %}
  <svg class="shrink-0 text-slate-300" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 8h8M9 5l3 3-3 3"/></svg>
  {% endif %}
  {% for suc in sequence.successors %}
  <a href="{{ suc.href }}" class="inline-flex items-center gap-1 rounded-full border border-slate-300 bg-white px-2.5 py-1 font-medium text-slate-600 no-underline transition hover:border-[var(--prac)] hover:text-[var(--prac)]">
    {{ suc.name }}
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 2l3 3-3 3"/></svg>
  </a>
  {% endfor %}
</div>
{% endif %}

<section class="sec mt-[38px] scroll-mt-[164px] [&_h2]:mb-4 [&_h2]:border-b [&_h2]:border-slate-300 [&_h2]:pb-2 [&_h2]:font-serif [&_h2]:text-[1.45rem] [&_h2]:font-semibold [&_h2]:text-slate-900" id="beschrijving">
  <h2>Beschrijving</h2>
  {% for para in prose | default([]) %}
  <p class="prose">{{ para | safe }}</p>
  {% endfor %}
  {% if steps %}
  <ul class="steps mt-3 mb-0 list-none space-y-2 p-0 [counter-reset:step] [&>li]:relative [&>li]:rounded-xl [&>li]:border [&>li]:border-slate-300 [&>li]:bg-white [&>li]:p-4 [&>li]:pl-12">
    {% for step in steps %}
    <li>
      <div class="step-body flex flex-col gap-1 [&_strong]:font-semibold [&_span]:text-slate-500">
        <strong>{{ step.title }}</strong>
        <span>{{ step.desc }}</span>
      </div>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if cots_box %}
  <div class="cots-box mt-3 rounded-[11px] border border-l-4 border-slate-300 border-l-amber-800 bg-slate-50 px-4 py-3.5 [&_.cots-label]:mb-1.5 [&_.cots-label]:font-mono [&_.cots-label]:text-[9.5px] [&_.cots-label]:font-bold [&_.cots-label]:uppercase [&_.cots-label]:tracking-[0.18em] [&_.cots-label]:text-amber-800 [&_p]:m-0 [&_p]:text-[0.9rem] [&_p]:text-slate-500">
    <div class="cots-label">COTS / koop-en-configureer context</div>
    {{ cots_box | safe }}
  </div>
  {% endif %}
</section>

<section class="sec mt-[38px] scroll-mt-[164px] [&_h2]:mb-4 [&_h2]:border-b [&_h2]:border-slate-300 [&_h2]:pb-2 [&_h2]:font-serif [&_h2]:text-[1.45rem] [&_h2]:font-semibold [&_h2]:text-slate-900" id="aanpak">
  <h2>Aanpak</h2>
  {% if approach and approach.desc %}
  <div class="approach-body mb-5 [&_p]:m-0 [&_p]:mb-2.5 [&_p]:text-[0.95rem] [&_p]:leading-relaxed [&_p]:text-slate-600">
    {{ approach.desc | safe }}
  </div>
  {% endif %}
  {% if actions %}
  <h3 class="m-0 mb-2.5 font-serif text-[1.05rem] font-semibold text-slate-900">Acties</h3>
  <ul class="m-0 mb-6 list-none space-y-1.5 p-0">
    {% for a in actions %}
    <li class="flex items-center gap-2.5 rounded-lg border border-slate-200 bg-white px-3 py-2">
      <span class="shrink-0 rounded-full border px-2 py-[2px] font-mono text-[9px] font-semibold uppercase tracking-[0.1em] {{ a.kind_css }}">{{ a.kind_nl }}</span>
      <span class="min-w-0 flex-1 text-[0.88rem] font-medium text-slate-700">
        {% if a.href %}<a href="{{ a.href }}" class="text-[var(--prac)] no-underline hover:underline">{{ a.target }}</a>{% else %}{{ a.target }}{% endif %}
      </span>
      <span class="shrink-0 font-mono text-[9px] uppercase tracking-wide text-slate-400">{{ a.type }}</span>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if work_products %}
  <h3 class="m-0 mb-2.5 font-serif text-[1.05rem] font-semibold text-slate-900">Werkproducten</h3>
  <div class="wp-grid grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-3.5">
    {% for wp in work_products %}
    {% set wp_class = "wp-card block overflow-hidden rounded-xl border border-slate-300 bg-white text-inherit no-underline transition hover:-translate-y-0.5 hover:shadow-sm [&_.wc-top]:h-[5px] [&_.wc-top]:bg-amber-800 [&_.wc-body]:px-3.5 [&_.wc-body]:py-3 [&_.wc-type]:mb-1 [&_.wc-type]:font-mono [&_.wc-type]:text-[9px] [&_.wc-type]:font-semibold [&_.wc-type]:uppercase [&_.wc-type]:tracking-[0.14em] [&_.wc-type]:text-amber-800 [&_h4]:m-0 [&_h4]:mb-1 [&_h4]:font-serif [&_h4]:text-[1.05rem] [&_h4]:font-semibold [&_p]:m-0 [&_p]:mb-2 [&_p]:text-[0.84rem] [&_p]:text-slate-500 [&_.wc-proves]:border-t [&_.wc-proves]:border-dashed [&_.wc-proves]:border-slate-300 [&_.wc-proves]:pt-1.5 [&_.wc-proves]:font-mono [&_.wc-proves]:text-[9.5px] [&_.wc-proves]:text-emerald-700 [&_.wc-open]:mt-1 [&_.wc-open]:font-mono [&_.wc-open]:text-[9px] [&_.wc-open]:uppercase [&_.wc-open]:tracking-[0.1em] [&_.wc-open]:text-amber-800" %}
    {% if wp.href %}
    <a href="{{ wp.href }}" class="{{ wp_class }}">
    {% else %}
    <div class="{{ wp_class }} cursor-default">
    {% endif %}
      <div class="wc-top"></div>
      <div class="wc-body">
        <div class="wc-type">Work Product · MVA</div>
        <h4>{{ wp.title }}</h4>
        <p>{{ wp.desc }}</p>
        <div class="wc-proves">{{ wp.proves }}</div>
        {% if wp.href %}<div class="wc-open">Uitwerking &amp; sjabloon →</div>{% endif %}
      </div>
    {% if wp.href %}
    </a>
    {% else %}
    </div>
    {% endif %}
    {% endfor %}
  </div>
  {% endif %}
</section>

{% if completion_criteria %}
<section class="sec mt-[38px] scroll-mt-[164px] [&_h2]:mb-4 [&_h2]:border-b [&_h2]:border-slate-300 [&_h2]:pb-2 [&_h2]:font-serif [&_h2]:text-[1.45rem] [&_h2]:font-semibold [&_h2]:text-slate-900" id="criteria">
  <h2>Voltooiingscriteria</h2>
  <ul class="m-0 mt-3 list-none space-y-1.5 p-0">
    {% for c in completion_criteria %}
    <li class="flex items-center gap-2.5 rounded-lg border border-slate-200 bg-white px-3 py-2">
      {% if c.alpha %}<span class="shrink-0 rounded-full border border-emerald-700/30 bg-emerald-700/10 px-2 py-[2px] font-mono text-[9px] font-semibold uppercase tracking-[0.1em] text-emerald-700">{{ c.alpha }}</span>{% endif %}
      <span class="text-[0.88rem] text-slate-700">{{ c.state }}</span>
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if roles is defined %}
<section class="sec mt-[38px] scroll-mt-[164px] [&_h2]:mb-4 [&_h2]:border-b [&_h2]:border-slate-300 [&_h2]:pb-2 [&_h2]:font-serif [&_h2]:text-[1.45rem] [&_h2]:font-semibold [&_h2]:text-slate-900" id="rollen">
  <h2>Rollen per niveau</h2>
  <p class="prose">{{ roles.intro }}</p>
  <div class="level-grid mt-3 grid grid-cols-2 gap-4 max-[900px]:grid-cols-1">
    {% for card in roles.cards %}
    <div class="level-card overflow-hidden rounded-[13px] border border-slate-300 [&_.lc-head]:px-4 [&_.lc-head]:py-3 [&_.lc-head]:text-white [&_.lc-level]:mb-[3px] [&_.lc-level]:font-mono [&_.lc-level]:text-[9px] [&_.lc-level]:uppercase [&_.lc-level]:tracking-[0.18em] [&_.lc-level]:opacity-85 [&_.lc-head_h3]:m-0 [&_.lc-head_h3]:font-serif [&_.lc-head_h3]:text-[1.1rem] [&_.lc-head_h3]:font-semibold [&_.lc-body]:bg-white [&_.lc-body]:px-4 [&_.lc-body]:py-3.5 [&_.lc-scope]:mb-2 [&_.lc-scope]:font-mono [&_.lc-scope]:text-[9.5px] [&_.lc-scope]:uppercase [&_.lc-scope]:tracking-[0.08em] [&_.lc-scope]:text-slate-500 [&_.lc-body_p]:m-0 [&_.lc-body_p]:mb-2.5 [&_.lc-body_p]:text-[0.88rem] [&_.lc-body_p]:text-slate-500 [&_.lc-wp]:border-t [&_.lc-wp]:border-dashed [&_.lc-wp]:border-slate-300 [&_.lc-wp]:pt-2 [&_.lc-wp]:text-[0.84rem] [&_.lc-wp]:text-slate-500 [&_.lc-wp_b]:text-slate-900 [&_.lc-comps]:mt-2 [&_.lc-comps]:flex [&_.lc-comps]:flex-wrap [&_.lc-comps]:gap-[5px] {{ card.lc_css }} scroll-mt-[112px]"{% if card.id %} id="{{ card.id }}"{% endif %}>
      <div class="lc-head">
        <div class="lc-level">{{ card.level_label }}</div>
        <h3>{{ card.role }}</h3>
      </div>
      <div class="lc-body">
        <div class="lc-scope">{{ card.scope }}</div>
        <p>{{ card.desc | safe }}</p>
        <div class="lc-wp"><b>{{ card.makes_label | default('Maakt') }}:</b> {{ card.makes }}</div>
        <div class="lc-comps">
          {% for comp in card.competencies %}
          <span class="lc-comp rounded-full border border-indigo-700/20 bg-indigo-700/10 px-2 py-[3px] font-mono text-[9px] font-semibold text-indigo-700">{{ comp }}</span>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

<nav class="act-nav mt-[42px] grid grid-cols-[1fr_auto_1fr] items-center gap-3 border-t border-slate-300 pt-[18px] max-[480px]:grid-cols-2 [&_a]:inline-block [&_a]:rounded-full [&_a]:border-[1.5px] [&_a]:border-[var(--prac)] [&_a]:px-3.5 [&_a]:py-[7px] [&_a]:font-mono [&_a]:text-[11px] [&_a]:font-semibold [&_a]:tracking-wide [&_a]:text-[var(--prac)] [&_a]:no-underline [&_a]:transition hover:[&_a]:bg-[var(--prac)] hover:[&_a]:text-white" aria-label="Activiteitennavigatie">
  <div class="an-prev text-left">
    {% if nav.prev %}
    <a href="{{ nav.prev.href }}">{{ nav.prev.label }}</a>
    {% else %}
    <span class="an-ghost opacity-40 pointer-events-none">← Vorige</span>
    {% endif %}
  </div>
  <div class="an-center text-center max-[480px]:hidden">
    <a href="{{ nav.overview }}">Procesoverzicht</a>
  </div>
  <div class="an-next text-right">
    {% if nav.next %}
    <a href="{{ nav.next.href }}">{{ nav.next.label }}</a>
    {% else %}
    <span class="an-ghost opacity-40 pointer-events-none">Volgende →</span>
    {% endif %}
  </div>
</nav>
{% endblock %}
