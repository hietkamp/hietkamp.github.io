{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import rdf_prose, sec_head, criterion_cards %}
{% block content %}
{% set nsec = namespace(n=0) %}
<div class="breadcrumb flex flex-wrap items-center gap-2 pt-[18px] font-mono text-[11px] text-slate-500 [&_a]:font-semibold [&_a]:text-[var(--prac)] [&_a]:no-underline hover:[&_a]:underline">
  {% for parent in breadcrumb.parents %}
  <a href="{{ parent.href }}">{{ parent.label }}</a>
  <span>›</span>
  {% endfor %}
  <span>{{ breadcrumb.current }}</span>
</div>

<header class="hero border-b-2 border-[var(--prac)] py-14 pb-8 [&_h1]:m-0 [&_h1]:mb-[0.45em] [&_h1]:font-serif [&_h1]:text-[clamp(2.3rem,5.6vw,4.4rem)] [&_h1]:font-black [&_h1]:leading-none [&_h1_em]:font-medium [&_h1_em]:italic [&_h1_em]:text-[var(--prac)] max-[600px]:py-8 max-[600px]:pb-4 max-[600px]:[&_h1]:text-[clamp(1.9rem,8vw,3rem)]">
  <div class="act-meta mb-4 flex flex-wrap items-center gap-2">
    {% if act_num %}<span class="act-num rounded-full border-[1.5px] border-[var(--prac)] px-3 py-1 font-mono text-[11px] font-bold uppercase tracking-[0.1em] text-[var(--prac)]">{{ act_num }}</span>{% endif %}
    {% if chips is defined and chips.space is defined %}<span class="act-chip rounded-full border-[1.5px] border-dashed px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.12em] chip-space {{ chips.space_css | default('border-slate-400/40 bg-slate-100 text-slate-600') }}">{{ chips.space }}</span>{% endif %}
    {% for chip in extra_chips | default([]) %}
    <span class="act-chip rounded-full border px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.12em] {{ chip.css }}">{{ chip.label }}</span>
    {% endfor %}
  </div>
  <h1>{{ act_name | default(title) | default('') }}</h1>
  <p class="lede m-0 text-[clamp(1rem,1.5vw,1.16rem)] leading-relaxed text-slate-500">{{ lede | default(desc) | default('') }}</p>
  {% if role_chips %}
  <div class="role-chips mt-4 flex flex-wrap gap-2">
    {% for r in role_chips %}
    <a href="{{ r.href }}" class="inline-flex items-center rounded-full px-3 py-1 font-mono text-[11px] font-semibold uppercase tracking-[0.1em] no-underline transition {{ r.css }}">{{ r.role }}</a>
    {% endfor %}
  </div>
  {% endif %}
  {% if alpha_bar %}
  <div class="alpha-bar mt-5 flex flex-wrap items-center gap-2 rounded-[10px] border border-[var(--prac)]/20 bg-slate-50 px-3.5 py-2.5 font-mono text-[11px]">
    <span class="ab-label font-bold tracking-wide text-[var(--prac)]">Beweegt de alphas:</span>
    <span class="ab-states text-slate-500 [&_b]:text-[var(--prac)]">{{ alpha_bar | safe }}</span>
  </div>
  {% endif %}
</header>

{% if sequence %}
<div class="act-sequence mt-6 flex flex-wrap items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-[0.82rem]">
  <span class="shrink-0 font-mono text-[9px] font-bold uppercase tracking-[0.14em] text-slate-400">Volgorde</span>
  {% for pre in sequence.predecessors %}
  <a href="{{ pre.href }}" class="inline-flex items-center gap-1 rounded-full border border-slate-300 bg-white px-2.5 py-1 font-medium text-slate-600 no-underline transition hover:border-[var(--prac)] hover:text-[var(--prac)]">
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 2L3 5l3 3"/></svg>
    {{ pre.name }}
  </a>
  {% endfor %}
  {% if sequence.predecessors %}
  <svg class="shrink-0 text-slate-300" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 8h8M9 5l3 3-3 3"/></svg>
  {% endif %}
  <span class="inline-flex items-center rounded-full border-[1.5px] border-[var(--prac)] bg-white px-2.5 py-1 font-semibold text-[var(--prac)]">{{ act_name }}</span>
  {% if sequence.successors %}
  <svg class="shrink-0 text-slate-300" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 8h8M9 5l3 3-3 3"/></svg>
  {% endif %}
  {% for suc in sequence.successors %}
  <a href="{{ suc.href }}" class="inline-flex items-center gap-1 rounded-full border border-slate-300 bg-white px-2.5 py-1 font-medium text-slate-600 no-underline transition hover:border-[var(--prac)] hover:text-[var(--prac)]">
    {{ suc.name }}
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 2l3 3-3 3"/></svg>
  </a>
  {% endfor %}
</div>
{% endif %}

<section class="sec mt-[38px] scroll-mt-[164px]" id="beschrijving">
  {% set nsec.n = nsec.n + 1 %}
  {{ sec_head('%02d'|format(nsec.n), 'Beschrijving') }}
  {{ rdf_prose(desc_html) }}
  {% if steps %}
  <ul class="steps mt-3 mb-0 list-none space-y-2 p-0 [counter-reset:step] [&>li]:relative [&>li]:rounded-xl [&>li]:border [&>li]:border-slate-300 [&>li]:bg-white [&>li]:p-4 [&>li]:pl-12">
    {% for step in steps %}
    <li>
      <div class="step-body flex flex-col gap-1 [&_strong]:font-semibold [&_span]:text-slate-500">
        <strong>{{ step.title }}</strong>
        <span>{{ step.desc }}</span>
      </div>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if cots_box %}
  <div class="cots-box mt-3 rounded-[11px] border border-l-4 border-slate-300 border-l-amber-800 bg-slate-50 px-4 py-3.5 [&_.cots-label]:mb-1.5 [&_.cots-label]:font-mono [&_.cots-label]:text-[9.5px] [&_.cots-label]:font-bold [&_.cots-label]:uppercase [&_.cots-label]:tracking-[0.18em] [&_.cots-label]:text-amber-800 [&_p]:m-0 [&_p]:text-[0.9rem] [&_p]:text-slate-500">
    <div class="cots-label">COTS / koop-en-configureer context</div>
    {{ cots_box | safe }}
  </div>
  {% endif %}
</section>

{% if entry_criteria %}
<section class="sec mt-[38px] scroll-mt-[164px]" id="toegangscriteria">
  {% set nsec.n = nsec.n + 1 %}
  {{ sec_head('%02d'|format(nsec.n), 'Toegangscriteria') }}
  {{ criterion_cards(entry_criteria) }}
</section>
{% endif %}

<section class="sec mt-[38px] scroll-mt-[164px]" id="aanpak">
  {% set nsec.n = nsec.n + 1 %}
  {{ sec_head('%02d'|format(nsec.n), 'Aanpak') }}
  {% if approach and approach.desc %}
  {{ rdf_prose(approach.desc) }}
  {% endif %}
</section>

{% if action_groups %}
<section class="sec mt-[38px] scroll-mt-[164px]" id="acties">
  {% set nsec.n = nsec.n + 1 %}
  {{ sec_head('%02d'|format(nsec.n), 'Acties') }}
  {% for group in action_groups %}
  <h3 class="m-0 mb-2.5{% if not loop.first %} mt-6{% endif %} font-serif text-[1.05rem] font-semibold text-slate-900">{{ group.kind_nl }}</h3>
  <div class="wp-grid grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-3.5">
    {% for a in group.cards %}
    {% set card_class = "wp-card block overflow-hidden rounded-xl border border-slate-300 bg-white text-inherit no-underline transition hover:-translate-y-0.5 hover:shadow-sm [&_.wc-top]:h-[5px] [&_.wc-body]:px-3.5 [&_.wc-body]:py-3 [&_h4]:m-0 [&_h4]:font-serif [&_h4]:text-[1.05rem] [&_h4]:font-semibold" %}
    {% if a.href %}
    <a href="{{ a.href }}" class="{{ card_class }}">
    {% else %}
    <div class="{{ card_class }} cursor-default">
    {% endif %}
      <div class="wc-top {{ a.topbar }}"></div>
      <div class="wc-body">
        <span class="inline-block rounded-full border border-slate-300 bg-slate-100 px-2 py-[2px] font-mono text-[9px] font-semibold uppercase tracking-[0.1em] text-slate-600">{{ a.type }}</span>
        <h4 class="mt-1.5">{{ a.title }}</h4>
      </div>
    {% if a.href %}
    </a>
    {% else %}
    </div>
    {% endif %}
    {% endfor %}
  </div>
  {% endfor %}
</section>
{% endif %}

{% if completion_criteria %}
<section class="sec mt-[38px] scroll-mt-[164px]" id="criteria">
  {% set nsec.n = nsec.n + 1 %}
  {{ sec_head('%02d'|format(nsec.n), 'Voltooiingscriteria') }}
  {{ criterion_cards(completion_criteria) }}
</section>
{% endif %}

{% if nav %}
<nav class="act-pager mt-12 flex items-stretch justify-between gap-3 border-t border-slate-300 pt-5" aria-label="Activiteitnavigatie">
  {% if nav.prev %}
  <a href="{{ nav.prev.href }}" class="inline-flex max-w-[45%] items-center rounded-xl border border-slate-300 bg-white px-4 py-3 text-[0.88rem] font-medium text-slate-700 no-underline transition hover:border-[var(--prac)] hover:text-[var(--prac)]">{{ nav.prev.label }}</a>
  {% else %}<span></span>{% endif %}
  <a href="{{ nav.overview }}" class="inline-flex items-center px-2 py-3 font-mono text-[11px] uppercase tracking-[0.1em] text-slate-500 no-underline transition hover:text-[var(--prac)]">Overzicht</a>
  {% if nav.next %}
  <a href="{{ nav.next.href }}" class="inline-flex max-w-[45%] items-center rounded-xl border border-slate-300 bg-white px-4 py-3 text-right text-[0.88rem] font-medium text-slate-700 no-underline transition hover:border-[var(--prac)] hover:text-[var(--prac)]">{{ nav.next.label }}</a>
  {% else %}<span></span>{% endif %}
</nav>
{% endif %}

{% endblock %}
