{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import hero %}

{% block content %}
{{ hero(hero_data) }}

<div class="wp-grid mt-8 grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-3.5">
  {% for role in roles %}
  <a href="{{ role.href }}" class="wp-card">
    <div class="wc-top {{ role.topbar }}"></div>
    <div class="wc-body">
      {% if role.level %}<div class="wc-type">{{ role.level }}</div>{% endif %}
      <h4>{{ role.title }}</h4>
      <p>{{ role.desc }}</p>
      <div class="wc-open">Bekijk rol →</div>
    </div>
  </a>
  {% endfor %}
</div>
{% endblock %}
