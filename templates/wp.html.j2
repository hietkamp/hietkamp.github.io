{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import rdf_prose, sec_head, download_strip %}
{% block content %}
{% set nsec = namespace(n=0) %}
<div class="breadcrumb flex flex-wrap items-center gap-2 pt-[18px] font-mono text-[11px] text-slate-500 [&_a]:font-semibold [&_a]:text-[var(--prac)] [&_a]:no-underline hover:[&_a]:underline">
  <a href="{{ breadcrumb.parent_href }}">{{ breadcrumb.parent_label }}</a>
  <span>›</span>
  <span>{{ breadcrumb.current }}</span>
</div>

<header class="hero border-b-2 border-[var(--prac)] py-14 pb-8 [&_h1]:m-0 [&_h1]:mb-[0.45em] [&_h1]:font-serif [&_h1]:text-[clamp(2.3rem,5.6vw,4.4rem)] [&_h1]:font-black [&_h1]:leading-none [&_h1_em]:font-medium [&_h1_em]:italic [&_h1_em]:text-[var(--prac)] max-[600px]:py-8 max-[600px]:pb-4 max-[600px]:[&_h1]:text-[clamp(1.9rem,8vw,3rem)]">
  <div class="kicker mb-3.5 block font-mono text-[11px] uppercase tracking-[0.28em] text-[var(--prac)]">{{ kicker }}</div>
  <h1>{{ h1_pre }}</h1>
  <p class="lede m-0 text-[clamp(1rem,1.5vw,1.16rem)] leading-relaxed text-slate-500">{{ lede | safe }}</p>
  <div class="meta-pills mt-5 flex flex-wrap gap-2 [&_span]:rounded-full [&_span]:border [&_span]:border-slate-300 [&_span]:bg-slate-50 [&_span]:px-3 [&_span]:py-[5px] [&_span]:font-mono [&_span]:text-[11px] [&_span]:tracking-wide [&_span]:text-slate-500">
    {% for pill in meta_pills %}
    <span>{{ pill }}</span>
    {% endfor %}
  </div>
</header>

{% for sec in sections %}
<section class="content-section mt-[38px] mb-8 scroll-mt-[164px]{% if sec.extra_class %} {{ sec.extra_class }}{% endif %}" data-section-kind="{{ sec.section_kind | default('content') }}"{% if sec.id %} id="{{ sec.id }}"{% endif %}>
  {% set nsec.n = nsec.n + 1 %}
  {{ sec_head('%02d'|format(nsec.n), sec.h2) }}
  {% if sec.section_kind == 'cards' %}
  <div class="wp-grid grid {{ 'grid-cols-1 gap-3' if sec.stacked else 'grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-3.5' }}">
    {% for card in sec.cards %}
    {% if card.href %}
    <a href="{{ card.href }}" class="wp-card">
    {% else %}
    <div class="wp-card cursor-default">
    {% endif %}
      <div class="wc-top {{ card.topbar | default('') }}"></div>
      <div class="wc-body">
        {% if card.type %}<div class="wc-type">{{ card.type }}</div>{% endif %}
        <h4>{{ card.title }}</h4>
        {% if card.desc %}<p>{{ card.desc }}</p>{% endif %}
        {% if card.checklist %}
        <div class="mt-1.5 border-t border-dashed border-slate-200 pt-1.5">
          <div class="mb-1 font-mono text-[9px] font-semibold uppercase tracking-[0.1em] text-slate-500">Checklist</div>
          <ul class="m-0 mb-2 list-disc space-y-1 pl-4 text-[0.84rem] text-slate-500">
            {% for item in card.checklist %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
        {% if card.href %}<div class="wc-open">Bekijk activiteit →</div>{% endif %}
      </div>
    {% if card.href %}
    </a>
    {% else %}
    </div>
    {% endif %}
    {% endfor %}
  </div>
  {% elif sec.section_kind == 'competencies' %}
  <div class="comp-groups flex flex-col gap-5">
    {% for group in sec.groups %}
    <div class="comp-group">
      <div class="mb-2 flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">
        <span class="h-2 w-2 rounded-full {{ group.dot }}"></span>{{ group.label }}
      </div>
      <div class="comp-list flex flex-col gap-2.5">
        {% for c in group['items'] %}
        <div class="comp-row flex flex-col gap-2.5 rounded-xl border px-4 py-3.5 transition {% if c.checked %}{{ c.chip_css }}{% else %}border-slate-200 bg-slate-50{% endif %}">
          <div class="flex items-start gap-2.5">
            <span class="comp-check mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full {% if c.checked %}{{ c.dot }} {{ c.dot_text }}{% else %}border border-slate-300 bg-white{% endif %}" aria-hidden="true">
              {% if c.checked %}
              <svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6.5l2.5 2.5 4.5-5.5"/></svg>
              {% endif %}
            </span>
            <div>
              <div class="font-semibold text-[0.92rem] {{ 'text-slate-900' if c.checked else 'text-slate-500' }}">{{ c.name }}</div>
              {% if c.brief %}<p class="m-0 mt-0.5 text-[0.8rem] leading-snug {{ 'text-slate-600' if c.checked else 'text-slate-400' }}">{{ c.brief }}</p>{% endif %}
            </div>
          </div>
          <div class="comp-levels flex flex-wrap items-center gap-1.5 pl-[30px]">
            {% for lv in c['levels'] %}
            <span class="level-pill group relative cursor-default rounded-full border px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-wide {% if lv.checked %}{{ c.dot }} {{ c.dot_text }} border-transparent{% else %}border-slate-200 bg-white text-slate-400{% endif %}"{% if lv.brief %} tabindex="0"{% endif %}>
              {{ lv.name }}
              {% if lv.brief %}
              <span class="pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 w-52 -translate-x-1/2 rounded-lg bg-slate-900 px-2.5 py-1.5 text-center font-sans text-[11px] font-normal normal-case leading-snug text-white opacity-0 shadow-lg transition duration-150 group-hover:opacity-100 group-focus:opacity-100">{{ lv.brief }}</span>
              {% endif %}
            </span>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% elif sec.section_kind == 'stepper' %}
  <ol class="stepper m-0 list-none p-0">
    {% for step in sec.steps %}
    <li class="stepper-item">
      <span class="stepper-dot {{ step.dot }} {{ step.dot_text }}">{{ loop.index }}</span>
      {% if not loop.last %}<span class="stepper-line"></span>{% endif %}
      <div class="stepper-body">
        <h4 class="m-0 mb-1 font-serif text-[1.05rem] font-semibold">{{ step.title }}</h4>
        {% if step.desc %}<p class="m-0 mb-2 text-[0.84rem] text-slate-500">{{ step.desc }}</p>{% endif %}
        {% if step.checklist %}
        <div class="mt-1.5 border-t border-dashed border-slate-200 pt-1.5">
          <div class="mb-1 font-mono text-[9px] font-semibold uppercase tracking-[0.1em] text-slate-500">Checklist</div>
          <ul class="m-0 mb-0 list-disc space-y-1 pl-4 text-[0.84rem] text-slate-500">
            {% for item in step.checklist %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
      </div>
    </li>
    {% endfor %}
  </ol>
  {% else %}
  {{ rdf_prose(sec.body_html) }}
  {% endif %}
</section>
{% endfor %}

{{ download_strip(download) }}


{% if lod_list %}
<section class="content-section mt-[38px] mb-8 scroll-mt-[164px]" id="lod">
  {% set nsec.n = nsec.n + 1 %}
  {{ sec_head('%02d'|format(nsec.n), 'Detailniveaus') }}
  <ol class="m-0 list-none space-y-2 p-0">
    {% for lod in lod_list %}
    <li class="overflow-hidden rounded-xl border {% if lod.sufficient %}border-[var(--prac)]/40 bg-[var(--prac)]/5{% else %}border-slate-200 bg-white{% endif %}">
      <div class="flex items-center gap-3 px-4 py-3">
        <span class="flex-1 font-serif text-[1rem] font-semibold text-slate-900">{{ lod.name }}</span>
        {% if lod.sufficient %}<span class="shrink-0 rounded-full border border-[var(--prac)]/30 bg-[var(--prac)]/10 px-2 py-[2px] font-mono text-[9px] font-semibold uppercase tracking-[0.1em] text-[var(--prac)]">Voldoende</span>{% endif %}
      </div>
      {% if lod.desc or lod.checks %}
      <div class="border-t border-slate-100 px-4 pb-3 pt-2">
        {% if lod.desc %}{{ rdf_prose(lod.desc, 'mb-2') }}{% endif %}
        {% for check in lod.checks %}
        <p class="m-0 flex items-start gap-2 text-[0.84rem] text-slate-600"><span class="mt-0.5 text-slate-500">✓</span>{{ check }}</p>
        {% endfor %}
      </div>
      {% endif %}
    </li>
    {% endfor %}
  </ol>
</section>
{% endif %}

{% if resources %}
<section class="content-section mt-[38px] mb-8 scroll-mt-[164px]" id="resources">
  {% set nsec.n = nsec.n + 1 %}
  {{ sec_head('%02d'|format(nsec.n), 'Bronnen') }}
  <ul class="m-0 list-none space-y-1.5 p-0">
    {% for url in resources %}
    <li class="flex items-center gap-2.5 rounded-lg border border-slate-200 bg-white px-3 py-2">
      <svg class="shrink-0 text-slate-400" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 8.5l3-3M8 5l1.5-1.5a2.12 2.12 0 013 3L11 8M6 9l-1.5 1.5a2.12 2.12 0 01-3-3L3 6"/></svg>
      {% if url.startswith('http://') or url.startswith('https://') %}
      <a href="{{ url }}" class="text-[0.88rem] text-[var(--prac)] no-underline hover:underline" target="_blank" rel="noopener">{{ url }}</a>
      {% else %}
      <span class="text-[0.88rem] text-slate-600">{{ url }}</span>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% endblock %}
