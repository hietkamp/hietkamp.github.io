{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import hero, domain_legend_row %}

{% block content %}
{{ hero(hero_data) }}
{{ domain_legend_row(domain_legend) }}

{% for group in activity_groups %}
<h2 class="m-0 mb-3{% if not loop.first %} mt-10{% else %} mt-8{% endif %} border-b border-slate-300 pb-2 font-serif text-[1.6rem] font-semibold text-slate-900">{{ group.domain }}</h2>
{% for space in group.spaces %}
<h3 class="m-0 mb-2.5{% if not loop.first %} mt-6{% endif %} font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">{{ space.space }}</h3>
<div class="wp-grid grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-3.5">
  {% for act in space.activities %}
  <a href="{{ act.href }}" class="wp-card">
    <div class="wc-top {{ act.topbar }}"></div>
    <div class="wc-body">
      {% if act.practice %}<div class="wc-type">{{ act.practice }}</div>{% endif %}
      <h4>{{ act.title }}</h4>
      <p>{{ act.desc }}</p>
      <div class="wc-open">Bekijk activiteit →</div>
    </div>
  </a>
  {% endfor %}
</div>
{% endfor %}
{% endfor %}
{% endblock %}
