{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import hero %}

{% block content %}
{{ hero(hero_data) }}

{% for group in alpha_groups %}
<h2 class="m-0 mb-3{% if not loop.first %} mt-10{% else %} mt-8{% endif %} border-b border-slate-300 pb-2 font-serif text-[1.6rem] font-semibold text-slate-900">{{ group.domain }}</h2>
<div class="wp-grid grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-3.5">
  {% for alpha in group.alphas %}
  {% set card_class = "wp-card block overflow-hidden rounded-xl border border-slate-300 bg-white text-inherit no-underline transition hover:-translate-y-0.5 hover:shadow-sm [&_.wc-top]:h-[5px] [&_.wc-body]:px-3.5 [&_.wc-body]:py-3 [&_h4]:m-0 [&_h4]:mb-1 [&_h4]:font-serif [&_h4]:text-[1.05rem] [&_h4]:font-semibold [&_p]:m-0 [&_p]:mb-2 [&_p]:text-[0.84rem] [&_p]:text-slate-500 [&_.wc-open]:mt-1 [&_.wc-open]:font-mono [&_.wc-open]:text-[10px] [&_.wc-open]:uppercase [&_.wc-open]:tracking-[0.1em] [&_.wc-open]:text-slate-600" %}
  <a href="{{ alpha.href }}" class="{{ card_class }}">
    <div class="wc-top {{ alpha.topbar }}"></div>
    <div class="wc-body">
      <h4>{{ alpha.title }}</h4>
      <p>{{ alpha.desc }}</p>
      <div class="wc-open">Bekijk alpha →</div>
    </div>
  </a>
  {% endfor %}
</div>
{% endfor %}
{% endblock %}
