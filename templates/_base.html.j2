{% import "_macros.html.j2" as m %}
<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>
{% if description %}<meta name="description" content="{{ description }}">
{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,900&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="{{ css_path | default('style.css') }}">
<style>:root{--header-h:100px}</style>
</head>
<body{% if data_prac %} data-prac="{{ data_prac }}"{% endif %} class="min-h-screen bg-white text-[var(--fg)] antialiased">
{% set has_leftnav = sidenav and sidenav.links %}
{# no_sidenav only opts a page out of the left siblings-nav (e.g. the five flat
   overview pages, which have no meaningful "siblings" one level above the top
   of each hierarchy) — it must NOT also collapse the right-hand on-page TOC's
   reserved margin, or those pages lose the mr-[220px] every other page (incl.
   index.html) gets and their content visibly drifts right. #}
{% set has_toc = not no_page_toc %}
<a class="skip-link absolute -top-full left-0 z-[999] rounded-br-lg bg-slate-900 px-[18px] py-2.5 text-[13px] font-semibold text-white no-underline focus-visible:top-0" href="#main-content">Ga naar de hoofdinhoud</a>
<header class="topnav fixed inset-x-0 top-0 z-[200] border-b border-slate-200 bg-white" role="banner" aria-label="Sitenavigatie">
  <!-- rij 1: logo + github -->
  <div class="flex h-14 items-center gap-2 px-5 max-[480px]:px-3">
    <a class="topnav-logo flex shrink-0 items-center gap-[9px] text-slate-900 no-underline" href="{{ root | default('') }}index.html">
      <span class="topnav-mark flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-slate-900 [&_svg]:block" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><rect x="2" y="2" width="10" height="2" rx="1" fill="white"/><rect x="2" y="6" width="7" height="2" rx="1" fill="white"/><rect x="2" y="10" width="10" height="2" rx="1" fill="white"/></svg></span>
      <span class="topnav-name whitespace-nowrap text-sm font-semibold text-slate-900 [&_span]:font-normal [&_span]:text-slate-500">Essence <span>in Architecture</span></span>
    </a>
    <span class="flex-1"></span>
    <a class="topnav-gh flex shrink-0 items-center rounded-md p-1.5 text-slate-500 no-underline transition hover:bg-slate-50 hover:text-slate-900 [&_svg]:block [&_svg]:fill-current" href="https://github.com/hietkamp/hietkamp.github.io" aria-label="GitHub" target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 98 96" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.324-3.015.324-3.015 4.934.326 7.523 5.052 7.523 5.052 4.367 7.496 11.404 5.378 14.235 4.074.404-3.178 1.699-5.378 3.074-6.6-10.839-1.141-22.243-5.378-22.243-24.283 0-5.378 1.94-9.778 5.014-13.2-.485-1.222-2.184-6.275.486-13.038 0 0 4.125-1.304 13.426 5.052a46.97 46.97 0 0 1 12.214-1.63c4.125 0 8.33.571 12.213 1.63 9.302-6.356 13.427-5.052 13.427-5.052 2.67 6.763.97 11.816.485 13.038 3.155 3.422 5.015 7.822 5.015 13.2 0 18.905-11.404 23.06-22.324 24.283 1.78 1.548 3.316 4.481 3.316 9.126 0 6.6-.08 11.897-.08 13.526 0 1.304.89 2.364 3.316 2.364 19.412-6.52 33.405-24.935 33.405-46.691C97.707 22 75.788 0 48.854 0z"/></svg>
    </a>
    {% if has_leftnav %}
    <button class="topnav-toggle flex-col h-[34px] w-[34px] shrink-0 cursor-pointer items-center justify-center rounded-md border-0 bg-transparent p-0 text-slate-500 hover:bg-slate-50 hover:text-slate-900 hidden max-[900px]:flex" aria-label="Sidenav openen" aria-expanded="false">
      <span class="bar"></span><span class="bar"></span><span class="bar"></span>
    </button>
    {% endif %}
  </div>
  <!-- rij 2: hoofdnavigatie — op mobiel (<900px) klapt deze rij in achter een hamburger -->
  <nav class="topnav-links relative flex h-11 items-center border-t border-slate-100 px-5 max-[480px]:px-3" aria-label="Hoofdnavigatie">
    <button class="navbar-toggle hidden max-[900px]:flex ml-auto h-9 cursor-pointer items-center gap-2.5 rounded-md border-0 bg-transparent px-2.5 text-[15px] font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900" aria-label="Menu openen" aria-expanded="false" aria-controls="navbar-menu">
      <span class="navbar-toggle-bars flex shrink-0 flex-col items-center justify-center"><span class="bar"></span><span class="bar"></span><span class="bar"></span></span>
      Menu
    </button>
    <div id="navbar-menu" class="navbar-menu">
      <a class="topnav-link inline-flex h-9 items-center gap-2 rounded-md px-3.5 text-[15px] font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-slate-900" href="{{ root | default('') }}index.html">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6.5L8 2l6 4.5V14a1 1 0 01-1 1H3a1 1 0 01-1-1V6.5z"/><path d="M6 15v-5h4v5"/></svg>
        Start
      </a>
      <a class="topnav-link inline-flex h-9 items-center gap-2 rounded-md px-3.5 text-[15px] font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-slate-900" href="{{ root | default('') }}alphas.html">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="6"/><circle cx="8" cy="8" r="2"/></svg>
        Alphas
      </a>
      <a class="topnav-link inline-flex h-9 items-center gap-2 rounded-md px-3.5 text-[15px] font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-slate-900" href="{{ root | default('') }}practices.html">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/><rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/></svg>
        Practices
      </a>
      <a class="topnav-link inline-flex h-9 items-center gap-2 rounded-md px-3.5 text-[15px] font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-slate-900" href="{{ root | default('') }}activiteiten.html">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><rect x="1" y="2" width="14" height="2.5" rx="1"/><rect x="1" y="6.75" width="10" height="2.5" rx="1"/><rect x="1" y="11.5" width="6" height="2.5" rx="1"/></svg>
        Activiteiten
      </a>
      <a class="topnav-link inline-flex h-9 items-center gap-2 rounded-md px-3.5 text-[15px] font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-slate-900" href="{{ root | default('') }}roles.html">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="5" r="2.75"/><path d="M2.5 14c0-2.76 2.46-5 5.5-5s5.5 2.24 5.5 5"/></svg>
        Rollen
      </a>
      <a class="topnav-link inline-flex h-9 items-center gap-2 rounded-md px-3.5 text-[15px] font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-slate-900" href="{{ root | default('') }}workproducts.html">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 1.5h5.5L12.5 4.5V14.5h-8.5z"/><path d="M9.5 1.5V4.5h3"/></svg>
        Werkproducten
      </a>
    </div>
  </nav>
</header>
{% if has_leftnav %}
<div id="sidenav-overlay" class="sidenav-overlay hidden fixed inset-x-0 bottom-0 top-[var(--header-h)] z-[90] bg-black/25"></div>
{% endif %}
<div class="page-shell flex min-h-screen pt-[var(--header-h)]">
  {% if has_leftnav %}
  <aside id="sidenav" class="sidenav fixed bottom-0 left-0 top-[var(--header-h)] z-[100] w-[240px] overflow-y-auto overflow-x-hidden border-r border-slate-300 bg-white pb-6 max-[900px]:-translate-x-full max-[900px]:transition-transform" aria-label="Paginanavigatie">
    <div class="snav-section">{{ sidenav.group_label }}</div>
    {% for item in sidenav.links %}
    <a href="{{ item.href }}" class="snav-link group{% if item.current %} current{% endif %}"{% if item.current %} aria-current="page"{% endif %}>{{ m.sidenav_icon(sidenav.icon, item, sidenav.icon_css | default('')) }}<span class="snav-label">{{ item.label }}</span></a>
    {% endfor %}
  </aside>
  {% endif %}
  <main class="page-main relative {{ 'ml-[240px]' if has_leftnav }} {{ 'mr-[220px] max-[1100px]:mr-0' if has_toc }} min-w-0 flex-1 before:pointer-events-none before:absolute before:inset-x-0 before:top-0 before:z-0 before:h-[340px] before:bg-gradient-to-b before:from-slate-50 before:to-white before:content-[''] max-[900px]:ml-0" id="main-content">
    <div class="wrap relative z-[1] mx-auto {{ wrap_class | default('max-w-[1300px]') }} px-[26px] pb-[90px]">
{% block content %}{% endblock %}
    </div>
  </main>
  {% if has_toc %}
  <aside id="page-toc" class="page-toc fixed bottom-0 right-0 top-[var(--header-h)] z-[100] w-[220px] overflow-y-auto overflow-x-hidden border-l border-slate-300 bg-white pb-6 max-[1100px]:hidden" aria-label="Op deze pagina"></aside>
  {% endif %}
</div>
<div class="site-contribute relative z-[120] border-t border-slate-300 bg-slate-950 text-slate-300">
  <div class="site-contribute-inner mx-auto flex max-w-[980px] items-start gap-3 px-6 py-5 text-[0.86rem] leading-relaxed [&_a]:font-semibold [&_a]:text-white [&_a]:underline [&_p]:m-0">
    <svg class="site-contribute-icon mt-0.5 shrink-0 fill-current text-slate-400" width="22" height="22" viewBox="0 0 98 96" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.324-3.015.324-3.015 4.934.326 7.523 5.052 7.523 5.052 4.367 7.496 11.404 5.378 14.235 4.074.404-3.178 1.699-5.378 3.074-6.6-10.839-1.141-22.243-5.378-22.243-24.283 0-5.378 1.94-9.778 5.014-13.2-.485-1.222-2.184-6.275.486-13.038 0 0 4.125-1.304 13.426 5.052a46.97 46.97 0 0 1 12.214-1.63c4.125 0 8.33.571 12.213 1.63 9.302-6.356 13.427-5.052 13.427-5.052 2.67 6.763.97 11.816.485 13.038 3.155 3.422 5.015 7.822 5.015 13.2 0 18.905-11.404 23.06-22.324 24.283 1.78 1.548 3.316 4.481 3.316 9.126 0 6.6-.08 11.897-.08 13.526 0 1.304.89 2.364 3.316 2.364 19.412-6.52 33.405-24.935 33.405-46.691C97.707 22 75.788 0 48.854 0z" fill="#c9d1d9"/></svg>
    <p><strong>Open practice.</strong> Deze practices zijn open voor bijdragen van de community. <a href="https://github.com/hietkamp/hietkamp.github.io/issues/new/choose" target="_blank" rel="noopener">Open een GitHub-issue</a> om een verbetering aan een bestaande practice voor te stellen, een nieuwe practice te introduceren of een sjabloon bij te dragen — issues zijn het startpunt voor elke wijziging.</p>
  </div>
</div>
<script src="{{ root | default('') }}nav.js"></script>
</body>
</html>
