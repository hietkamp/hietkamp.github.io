{# ─── Essence Activity Card ───────────────────────────────────────────────────
   Een standalone Jinja2 macro voor één activity card.
   Layout: gelijk aan de act-row kaarten op wow-enterprise-architecture.html.

   Gebruik:
     {% from "_card_activity.html.j2" import activity_card %}
     {{ activity_card(act, href='act/envision-the-architecture.html#enterprise', spoor='enterprise') }}

   Verwachte velden in `act` (na node_to_dict uit de RDF vocab):

   Beide typen:
     title / name     – Nederlandse naam  (bijv. "Begrijpen")
     desc             – korte omschrijving
     chips.space      – Activity Space chip  (bijv. "AS 1–2 · Understand Stakeholder Needs")
     actions          – ess:Action's (op werkproduct én alpha) gegroepeerd per CRUD-kind,
                         zelfde kind_nl/kind_css als de "Acties"-lijst op de activiteitpagina:
                         [{"kind", "kind_nl", "kind_css", "wps": [{"name"}]}]

   Level-specific (enterprise-begrijpen, solution-richten, ...):
     num              – volgnummer  ("01")
     phase            – "analyse" | "dev"

   Top-level practice-activiteiten (envision-the-architecture, ...):
     act_num          – "Activiteit 02 / 05"
     act_name / title – Nederlandse naam
     lede             – langere intro-tekst (valt terug op desc)
     alpha_bar        – alpha-progressiebalk HTML  ("Drivers → <b>Quantified</b>")
#}

{% macro activity_card(act, href='', num_color='', num_text_color='text-white', spoor='enterprise') %}

{# ── Afleidbare display-waarden ──────────────────────────────────────────── #}
{% set _title = act.title | default(act.name | default(act.act_name | default(''))) %}
{% set _desc  = act.desc  | default(act.lede  | default('')) %}
{% set _href  = href or act.href | default('#') %}
{% set _phase = act.phase | default('dev') %}

{# Volgnummer: ewow:num (level-specific) of extraheer uit ewow:actNum ("Activiteit 02 / 05") #}
{% set _num_raw = act.num | default('') %}
{% if not _num_raw and act.act_num %}
  {% set _num_parts = act.act_num.split(' ') %}
  {% set _num_raw = _num_parts[1] if _num_parts | length > 1 else '·' %}
{% endif %}
{% set _num = _num_raw if _num_raw else '·' %}

{# Badge-kleur: argument (domeinkleur) wint; zonder domein-tag neutraal slate #}
{% set _num_color = num_color if num_color else 'bg-slate-700' %}

{# ── Card markup ─────────────────────────────────────────────────────────── #}
<a href="{{ _href }}"
   class="act-row grid grid-cols-[52px_1fr_auto] overflow-hidden rounded-[13px]
          border border-slate-300 bg-white text-inherit no-underline transition
          hover:-translate-y-0.5 hover:shadow-sm
          [&_.ar-num]:flex [&_.ar-num]:items-center [&_.ar-num]:justify-center
          [&_.ar-num]:font-serif [&_.ar-num]:text-[1.4rem] [&_.ar-num]:font-bold [&_.ar-num]:{{ num_text_color }}
          [&_.ar-body]:px-4 [&_.ar-body]:py-[13px]
          [&_.ar-title]:m-0 [&_.ar-title]:mb-[3px] [&_.ar-title]:font-serif
          [&_.ar-title]:text-[1.12rem] [&_.ar-title]:font-semibold
          [&_.ar-desc]:m-0 [&_.ar-desc]:mb-[7px] [&_.ar-desc]:text-[0.86rem] [&_.ar-desc]:text-slate-500
          [&_.ar-meta]:flex [&_.ar-meta]:flex-wrap [&_.ar-meta]:gap-1.5
          [&_.ar-arrow]:flex [&_.ar-arrow]:items-center [&_.ar-arrow]:px-[18px]
          [&_.ar-arrow]:font-mono [&_.ar-arrow]:text-lg [&_.ar-arrow]:text-slate-500
          a-{{ _phase }} [&_.ar-num]:{{ _num_color }}">

  {# ── Nummer badge ──────────────────────────────────────────────────────── #}
  <div class="ar-num">{{ _num }}</div>

  {# ── Card body ─────────────────────────────────────────────────────────── #}
  <div class="ar-body">

    {# Nederlandse naam #}
    <div class="ar-title">{{ _title }}</div>

    {# Korte omschrijving (max. ~200 tekens voor de card) #}
    <div class="ar-desc">{{ _desc | truncate(200) }}</div>

    {# Alpha-progressiebalk (alleen top-level practice-activiteiten) #}
    {% if act.alpha_bar %}
    <div class="ar-alpha mb-[7px] mt-1 rounded-md border border-slate-300 bg-slate-50
                px-2.5 py-1.5 font-mono text-[9px] text-slate-600 [&_b]:text-slate-900">{{ act.alpha_bar | safe }}</div>
    {% endif %}

    {# Activity Space chip — neutraal; domeinkleur zit al in het num-badge #}
    {% if act.chips and act.chips.space %}
    <div class="ar-meta">
      <span class="ar-chip rounded-full border border-slate-400/40 bg-slate-100 px-2 py-[3px] font-mono
                   text-[9px] font-semibold uppercase tracking-[0.1em] text-slate-600">{{ act.chips.space }}</span>
    </div>
    {% endif %}

    {# Work products per ess:Action CRUD-kind (Aanmaken/Lezen/Wijzigen/Verwijderen) #}
    {% if act.actions %}
    <div class="ar-flow mt-2 flex flex-col gap-[5px] border-t border-dashed border-slate-300 pt-2">
      {% for group in act.actions %}
      <div class="ar-flow-row flex flex-wrap items-start gap-[5px]">
        <span class="ar-flow-lbl w-[76px] shrink-0 rounded-full border px-2 py-[2px] text-center font-mono text-[9px] font-semibold
                     uppercase tracking-[0.1em] {{ group.kind_css }}">{{ group.kind_nl }}</span>
        {% for wp in group.wps %}
        <span class="ar-chip rounded-full px-2 py-[3px] font-mono text-[9px] font-semibold
                     uppercase tracking-[0.1em] border border-slate-300 bg-slate-100 text-slate-500">{{ wp.name }}</span>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

  </div>

  {# ── Pijl rechts ───────────────────────────────────────────────────────── #}
  <div class="ar-arrow">→</div>

</a>
{% endmacro %}
