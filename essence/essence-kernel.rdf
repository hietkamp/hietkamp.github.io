        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Recognized_3">
