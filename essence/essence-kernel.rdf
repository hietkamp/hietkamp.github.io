        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work"/>
        <ess:name xml:lang="nl">Voortgang bewaken</ess:name>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EndeavorAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#UnderstandStakeholderNeeds">
        <ess:briefDescription xml:lang="nl">In gesprek met de stakeholders wordt hier duidelijk wat zij nodig hebben, zodat het werk de juiste resultaten oplevert.</ess:briefDescription>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#UnderstandStakeholderNeeds_CC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#UnderstandStakeholderNeeds_CC_2"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#UnderstandStakeholderNeeds_EC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#UnderstandStakeholderNeeds_EC_2"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System"/>
        <ess:name xml:lang="nl">Stakeholderbehoeften begrijpen</ess:name>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#CustomerAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#UnderstandtheRequirements">
        <ess:briefDescription xml:lang="nl">Hier ontstaat een gezamenlijk beeld van wat het te bouwen systeem moet kunnen.</ess:briefDescription>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#UnderstandtheRequirements_CC_1"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work"/>
        <ess:name xml:lang="nl">Requirements begrijpen</ess:name>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SolutionAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#UsetheSystem">
        <ess:briefDescription xml:lang="nl">Hier wordt geobserveerd hoe het systeem in de praktijk wordt gebruikt en welk voordeel dat de stakeholders oplevert.</ess:briefDescription>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#UsetheSystem_CC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#UsetheSystem_CC_2"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#UsetheSystem_EC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#UsetheSystem_EC_2"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System"/>
        <ess:name xml:lang="nl">Systeem gebruiken</ess:name>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#CustomerAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:Alpha rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking">
        <ess:briefDescription xml:lang="nl">De Werkwijze omvat de practices en hulpmiddelen die een team op maat heeft samengesteld om het eigen werk te sturen en te ondersteunen.</ess:briefDescription>
        <ess:name xml:lang="nl">Werkwijze</ess:name>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_FoundationEstablished"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InPlace"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InUse"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_PrinciplesEstablished"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_Retired"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell"/>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EndeavorAreaOfConcern"/>
      </ess:Alpha>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:AlphaAssociation rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_guides_Work">
            <ess:description xml:lang="nl">De Werkwijze geeft richting aan hoe het Work wordt gedaan.</ess:description>
        <ess:end1 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking"/>
        <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work"/>
        <ess:name xml:lang="nl">stuurt</ess:name>
      </ess:AlphaAssociation>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:Alpha rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work">
        <ess:briefDescription xml:lang="nl">Work is de inspanning — mentaal of fysiek — die wordt geleverd om tot een resultaat te komen.</ess:briefDescription>
        <ess:name xml:lang="nl">Werk</ess:name>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Concluded"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Initiated"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Prepared"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Started"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl"/>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EndeavorAreaOfConcern"/>
      </ess:Alpha>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:AlphaAssociation rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_setuptoaddress_Opportunity">
            <ess:description xml:lang="nl">Het Work is zo ingericht dat het de uitdaging aanpakt.</ess:description>
        <ess:end1 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work"/>
        <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity"/>
        <ess:name xml:lang="nl">ingericht om te benutten</ess:name>
      </ess:AlphaAssociation>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:AlphaAssociation rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_updatesandchanges_System">
            <ess:description xml:lang="nl">Via het Work wordt het System bijgewerkt en aangepast.</ess:description>
        <ess:end1 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work"/>
        <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System"/>
        <ess:name xml:lang="nl">werkt bij en verandert</ess:name>
      </ess:AlphaAssociation>
    </ess:ownedElements>
  </ess:Kernel>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InUse_6">
    <ess:description xml:lang="nl">De practices en hulpmiddelen maken communicatie en samenwerking binnen het team makkelijker.</ess:description>
    <ess:name>6</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Fulfilled">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Fulfilled_1">
        <ess:description xml:lang="nl">De stakeholders erkennen dat de requirements precies vastleggen wat nodig is om volledig aan de behoefte te voldoen.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Fulfilled_2">
        <ess:description xml:lang="nl">Niets in de requirements staat nog in de weg om het systeem als volledig conform te accepteren.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Fulfilled_3">
        <ess:description xml:lang="nl">De stakeholders accepteren het systeem als volledig in lijn met de requirements.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="nl">Wat er van de requirements is gerealiseerd, dekt de volledige behoefte aan een nieuw systeem.</ess:description>
    <ess:name xml:lang="nl">Vervuld</ess:name>
  </ess:State>
  <ess:EntryCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#TrackProgress_EC_3">
    <ess:description xml:lang="nl">Werk::Gestart</ess:description>
    <ess:state>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Started">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Started_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Started_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Started_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Started_4"/>
        <ess:description xml:lang="nl">Het werk is in gang gezet.</ess:description>
        <ess:name xml:lang="nl">Gestart</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl"/>
      </ess:State>
    </ess:state>
  </ess:EntryCriterion>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#TesttheSystem_CC_2">
    <ess:description xml:lang="nl">Systeem::Gereed</ess:description>
    <ess:state>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready_3"/>
        <ess:description xml:lang="nl">Het complete systeem is goedgekeurd om naar een productieomgeving te gaan.</ess:description>
        <ess:name xml:lang="nl">Gereed</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Operational"/>
      </ess:State>
    </ess:state>
  </ess:CompletionCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Demonstrable_1">
    <ess:description xml:lang="nl">De belangrijkste architectuurkenmerken zijn in de praktijk getoond.</ess:description>
    <ess:name>1</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_1">
        <ess:description xml:lang="nl">Ieders individuele verantwoordelijkheden zijn duidelijk.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_10">
        <ess:description xml:lang="nl">Elk teamlid zegt toe te werken volgens de vastgestelde teamopzet.</ess:description>
        <ess:name>10</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_2">
        <ess:description xml:lang="nl">Er zijn genoeg mensen aangetrokken om het werk op gang te krijgen.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_3">
        <ess:description xml:lang="nl">Ieder teamlid snapt hoe het team is ingericht en wat zijn eigen rol daarin is.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_4">
        <ess:description xml:lang="nl">Alle teamleden weten hoe ze hun werk moeten aanpakken.</ess:description>
        <ess:name>4</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_5">
        <ess:description xml:lang="nl">De teamleden hebben kennisgemaakt (eventueel online) en beginnen elkaar te leren kennen.</ess:description>
        <ess:name>5</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_6">
        <ess:description xml:lang="nl">De teamleden begrijpen hun verantwoordelijkheden en hoe die aansluiten op hun competenties.</ess:description>
        <ess:name>6</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_7">
        <ess:description xml:lang="nl">Teamleden nemen werk aan.</ess:description>
        <ess:name>7</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_8">
        <ess:description xml:lang="nl">Externe samenwerkingspartners — organisaties, teams of personen — zijn in kaart gebracht.</ess:description>
        <ess:name>8</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_9">
        <ess:description xml:lang="nl">Vastgelegd is hoe het team onderling communiceert.</ess:description>
        <ess:name>9</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="nl">Er zijn genoeg gemotiveerde mensen aan het team toegevoegd om aan de missie te beginnen.</ess:description>
    <ess:name xml:lang="nl">Gevormd</ess:name>
    <ess:successor>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Collaborating">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Collaborating_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Collaborating_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Collaborating_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Collaborating_4"/>
        <ess:description xml:lang="nl">De teamleden trekken samen op als één geheel.</ess:description>
        <ess:name xml:lang="nl">Samenwerkend</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Performing"/>
      </ess:State>
    </ess:successor>
  </ess:State>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_5">
    <ess:description xml:lang="nl">Het systeem is toereikend gedocumenteerd.</ess:description>
    <ess:name>5</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Prepared_6">
    <ess:description xml:lang="nl">Acceptatiecriteria zijn vastgesteld en afgestemd met de klant.</ess:description>
    <ess:name>6</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Operational_3">
    <ess:description xml:lang="nl">Het systeem wordt volledig ondersteund volgens de afgesproken serviceniveaus.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_1">
        <ess:description xml:lang="nl">Gebruikers kunnen zelfstandig met het systeem werken.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_2">
        <ess:description xml:lang="nl">De functionaliteit van het systeem is getest.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_3">
        <ess:description xml:lang="nl">De stakeholders vinden de prestaties van het systeem voldoende.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_4">
        <ess:description xml:lang="nl">Het aantal defecten is voor de stakeholders acceptabel.</ess:description>
        <ess:name>4</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_5"/>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_6">
        <ess:description xml:lang="nl">Duidelijk is welke systeemelementen zijn uitgebracht.</ess:description>
        <ess:name>6</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_7">
        <ess:description xml:lang="nl">De meerwaarde van het systeem is aantoonbaar.</ess:description>
        <ess:name>7</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_8">
        <ess:description xml:lang="nl">Er is documentatie beschikbaar over het uitrollen en gebruiken van het systeem in de beoogde omgeving.</ess:description>
        <ess:name>8</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="nl">Het systeem is inzetbaar en laat alle kwaliteitskenmerken van een productiesysteem zien.</ess:description>
    <ess:name xml:lang="nl">Bruikbaar</ess:name>
    <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready"/>
  </ess:State>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Prepared_7">
    <ess:description xml:lang="nl">Het werk is voldoende opgedeeld om productief te beginnen.</ess:description>
    <ess:name>7</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InPlace_3">
    <ess:description xml:lang="nl">Het hele team denkt mee over het evalueren en bijstellen van de werkwijze.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded_1">
    <ess:description xml:lang="nl">De stakeholders bij zowel de uitdaging als de voorgestelde oplossing zijn in kaart gebracht.</ess:description>
    <ess:name>1</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Started_4">
    <ess:description xml:lang="nl">Teamleden pakken taken op en brengen ze verder.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:EntryCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#OperatetheSystem_EC_1">
    <ess:description xml:lang="nl">Systeem::Gereed</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready"/>
  </ess:EntryCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_FoundationEstablished_2">
    <ess:description xml:lang="nl">Het team heeft genoeg practices afgesproken om te kunnen starten.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_ValueEstablished_5">
    <ess:description xml:lang="nl">De gewenste uitkomsten van de oplossing zijn helder en meetbaar gemaakt.</ess:description>
    <ess:name>5</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_PrinciplesEstablished_4">
    <ess:description xml:lang="nl">Er ligt een advies over de te volgen aanpak.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_5">
    <ess:description xml:lang="nl">Uit de requirements blijkt wat het op te leveren systeem wezenlijk moet kunnen.</ess:description>
    <ess:name>5</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable_3">
    <ess:description xml:lang="nl">Helder is welke waarde het realiseren van de requirements oplevert.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#UnderstandStakeholderNeeds_CC_2">
    <ess:description xml:lang="nl">Uitdaging::Haalbaar</ess:description>
    <ess:state>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_4"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_5"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_6"/>
        <ess:description xml:lang="nl">Men is het erover eens dat een oplossing snel en goedkoop genoeg te realiseren is om de uitdaging daadwerkelijk aan te pakken.</ess:description>
        <ess:name xml:lang="nl">Haalbaar</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Addressed"/>
      </ess:State>
    </ess:state>
  </ess:CompletionCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InUse_4">
    <ess:description xml:lang="nl">Het team staat achter het gebruik van de practices en hulpmiddelen.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:EntryCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#ImplementtheSystem_EC_1">
    <ess:description xml:lang="nl">Systeem::Architectuur gekozen</ess:description>
    <ess:state>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_4"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_5"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_6"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_7"/>
        <ess:description xml:lang="nl">Er ligt een architectuurkeuze die de belangrijkste technische risico's ondervangt en rekening houdt met de geldende organisatorische randvoorwaarden.</ess:description>
        <ess:name xml:lang="nl">Architectuur gekozen</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Demonstrable"/>
      </ess:State>
    </ess:state>
  </ess:EntryCriterion>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#UnderstandStakeholderNeeds_CC_1">
    <ess:description xml:lang="nl">Stakeholders::Eensgezind</ess:description>
    <ess:state>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement_4"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement_5"/>
        <ess:description xml:lang="nl">De stakeholdervertegenwoordigers trekken op dezelfde lijn.</ess:description>
        <ess:name xml:lang="nl">Eensgezind</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_SatisfiedforDeployment"/>
      </ess:State>
    </ess:state>
  </ess:CompletionCriterion>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Concluded">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Concluded_1">
        <ess:description xml:lang="nl">Wat nog open staat, is administratieve afhandeling of voorbereiding van het volgende stuk werk.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Concluded_2">
        <ess:description xml:lang="nl">De beoogde resultaten zijn gerealiseerd.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Concluded_3">
        <ess:description xml:lang="nl">De stakeholder(s) heeft/hebben het opgeleverde systeem geaccepteerd.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="nl">Het opleveren van de resultaten is klaar.</ess:description>
    <ess:name xml:lang="nl">Afgerond</ess:name>
    <ess:successor>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed_4"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed_5"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed_6"/>
        <ess:description xml:lang="nl">De laatste losse eindjes zijn afgehandeld en het werk is formeel afgesloten.</ess:description>
        <ess:name xml:lang="nl">Gesloten</ess:name>
      </ess:State>
    </ess:successor>
  </ess:State>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Initiated_7">
    <ess:description xml:lang="nl">De prioriteit van dit werk staat vast.</ess:description>
    <ess:name>7</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_1">
    <ess:description xml:lang="nl">Er ligt een schets van een oplossing.</ess:description>
    <ess:name>1</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl_1">
        <ess:description xml:lang="nl">Taken komen af.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl_2">
        <ess:description xml:lang="nl">Ongepland werk blijft beheersbaar.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl_3">
        <ess:description xml:lang="nl">Risico's zijn beheerst: zowel de kans erop als de impact ervan zijn teruggebracht tot een acceptabel niveau.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl_4">
        <ess:description xml:lang="nl">Schattingen worden bijgesteld aan de hand van hoe het team daadwerkelijk presteert.</ess:description>
        <ess:name>4</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl_5">
        <ess:description xml:lang="nl">Er zijn cijfers beschikbaar die voortgang en snelheid laten zien.</ess:description>
        <ess:name>5</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl_6">
        <ess:description xml:lang="nl">Herstelwerk blijft binnen de perken.</ess:description>
        <ess:name>6</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl_7">
        <ess:description xml:lang="nl">Taken worden structureel op tijd en binnen schatting afgerond.</ess:description>
        <ess:name>7</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="nl">Het werk verloopt naar wens: risico's zijn beheerst en het tempo ligt hoog genoeg voor een goed resultaat.</ess:description>
    <ess:name xml:lang="nl">Onder controle</ess:name>
    <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Concluded"/>
  </ess:State>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Identified">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Identified_1">
        <ess:description xml:lang="nl">Er ligt een idee om de bestaande werkwijze te verbeteren, marktaandeel te winnen, of een nieuw of vernieuwend systeem in te zetten.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Identified_2">
        <ess:description xml:lang="nl">Minstens één stakeholder is bereid te investeren om de uitdaging en de bijbehorende waarde beter te doorgronden.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Identified_3">
        <ess:description xml:lang="nl">Ook de overige stakeholders die deze uitdaging delen, zijn in beeld gebracht.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="nl">Er ligt een commerciële, maatschappelijke of zakelijke uitdaging — een probleem, een kans of een verplichting — waarvoor een systeemoplossing uitkomst zou kunnen bieden.</ess:description>
    <ess:name xml:lang="nl">Geïdentificeerd</ess:name>
    <ess:successor>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded_4"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded_5"/>
        <ess:description xml:lang="nl">Vastgesteld is dat er behoefte bestaat aan een systeemgebaseerde oplossing.</ess:description>
        <ess:name xml:lang="nl">Oplossing nodig</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_ValueEstablished"/>
      </ess:State>
    </ess:successor>
  </ess:State>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Performing">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Performing_1">
        <ess:description xml:lang="nl">Het team maakt zijn toezeggingen keer op keer waar.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Performing_2">
        <ess:description xml:lang="nl">Het team stelt zich voortdurend bij op een veranderende context.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Performing_3">
        <ess:description xml:lang="nl">Het team signaleert en lost problemen zelfstandig op, zonder hulp van buiten.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Performing_4">
        <ess:description xml:lang="nl">Er wordt goede voortgang geboekt, met weinig vermijdbaar terugval- of herstelwerk.</ess:description>
        <ess:name>4</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Performing_5">
        <ess:description xml:lang="nl">Verspilling en de kans daarop worden doorlopend opgespoord en weggewerkt.</ess:description>
        <ess:name>5</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="nl">Het team levert effectief en efficiënt werk.</ess:description>
    <ess:name xml:lang="nl">Presterend</ess:name>
    <ess:successor>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Adjourned">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Adjourned_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Adjourned_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Adjourned_3"/>
        <ess:description xml:lang="nl">Het team draagt geen verantwoordelijkheid meer voor de missie.</ess:description>
        <ess:name xml:lang="nl">Ontbonden</ess:name>
      </ess:State>
    </ess:successor>
  </ess:State>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InPlace">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InPlace_1">
        <ess:description xml:lang="nl">Het volledige team zet de practices en hulpmiddelen in voor het dagelijkse werk.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InPlace_2">
        <ess:description xml:lang="nl">Alle teamleden kunnen beschikken over de practices en hulpmiddelen die ze nodig hebben.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InPlace_3"/>
    <ess:description xml:lang="nl">Het hele team past de werkwijze toe om het werk te doen.</ess:description>
    <ess:name xml:lang="nl">Ingevoerd</ess:name>
    <ess:successor>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell_4"/>
        <ess:description xml:lang="nl">De werkwijze bewijst zich goed voor het team dat ermee werkt.</ess:description>
        <ess:name xml:lang="nl">Effectief</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_Retired"/>
      </ess:State>
    </ess:successor>
  </ess:State>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Represented">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Represented_1">
        <ess:description xml:lang="nl">De stakeholdervertegenwoordigers hebben ingestemd met de rol die zij op zich nemen.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Represented_2">
        <ess:description xml:lang="nl">De stakeholdervertegenwoordigers hebben mandaat om hun taken uit te voeren.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Represented_3">
        <ess:description xml:lang="nl">Vastgelegd is hoe de stakeholdervertegenwoordigers onderling samenwerken.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Represented_4">
        <ess:description xml:lang="nl">De stakeholdervertegenwoordigers staan achter de werkwijze van het team en respecteren die.</ess:description>
        <ess:name>4</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="nl">Er is afgesproken hoe de stakeholders worden betrokken, en hun vertegenwoordigers zijn aangewezen.</ess:description>
    <ess:name xml:lang="nl">Vertegenwoordigd</ess:name>
    <ess:successor>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Involved">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Involved_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Involved_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Involved_3"/>
        <ess:description xml:lang="nl">De stakeholdervertegenwoordigers doen actief mee aan het werk en maken hun verantwoordelijkheden waar.</ess:description>
        <ess:name xml:lang="nl">Betrokken</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement"/>
      </ess:State>
    </ess:successor>
  </ess:State>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_Retired">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_Retired_1">
        <ess:description xml:lang="nl">De werkwijze van het team is buiten gebruik gesteld.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_Retired_2">
        <ess:description xml:lang="nl">Opgedane lessen zijn vastgelegd voor toekomstig gebruik.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="nl">Het team gebruikt deze werkwijze niet meer.</ess:description>
    <ess:name xml:lang="nl">Uitgefaseerd</ess:name>
  </ess:State>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_FoundationEstablished_4">
    <ess:description xml:lang="nl">Geanalyseerd is welke practices en hulpmiddelen nog ontbreken ten opzichte van wat beschikbaar is.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_ValueEstablished_4">
    <ess:description xml:lang="nl">Vastligt waaraan wordt afgemeten of de uitrol van het systeem geslaagd is.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#StoptheWork_CC_3">
    <ess:description xml:lang="nl">Werk::Gesloten</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed"/>
  </ess:CompletionCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Retired_4">
    <ess:description xml:lang="nl">Er komen geen updates meer voor het systeem.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_2">
    <ess:description xml:lang="nl">Duidelijk is waar elke requirement vandaan komt.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Addressed_3">
    <ess:description xml:lang="nl">De gerealiseerde requirements leveren de stakeholders aantoonbare waarde op.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#SupporttheTeam_CC_1">
    <ess:description xml:lang="nl">Team::Samenwerkend</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Collaborating"/>
  </ess:CompletionCriterion>
  <ess:EntryCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#UsetheSystem_EC_2">
    <ess:description xml:lang="nl">Uitdaging::Geadresseerd</ess:description>
    <ess:state>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Addressed">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Addressed_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Addressed_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Addressed_3"/>
        <ess:description xml:lang="nl">Er ligt een oplossing die de uitdaging aantoonbaar aanpakt.</ess:description>
        <ess:name xml:lang="nl">Geadresseerd</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_BenefitAccrued"/>
      </ess:State>
    </ess:state>
  </ess:EntryCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Involved_2">
    <ess:description xml:lang="nl">De stakeholdervertegenwoordigers leveren op tijd feedback en denken mee in de besluitvorming.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Seeded_7">
    <ess:description xml:lang="nl">Duidelijk is hoezeer het team zich committeert.</ess:description>
    <ess:name>7</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Addressed">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Addressed_1">
        <ess:description xml:lang="nl">Er is genoeg van de requirements gerealiseerd om het systeem voor de stakeholders acceptabel te maken.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Addressed_2">
        <ess:description xml:lang="nl">De stakeholders erkennen dat de requirements precies weergeven wat het systeem wel en niet doet.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Addressed_3"/>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Addressed_4">
        <ess:description xml:lang="nl">De stakeholders vinden het systeem dat de requirements invult de moeite waard om in productie te nemen.</ess:description>
        <ess:name>4</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="nl">Er is genoeg van de requirements gerealiseerd om, naar tevredenheid van de stakeholders, in de behoefte aan een nieuw systeem te voorzien.</ess:description>
    <ess:name xml:lang="nl">Geadresseerd</ess:name>
    <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Fulfilled"/>
  </ess:State>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_4">
    <ess:description xml:lang="nl">De grens van het systeem is vastgesteld.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Operational">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Operational_1">
        <ess:description xml:lang="nl">De beoogde gebruikers hebben toegang tot het systeem.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Operational_2">
        <ess:description xml:lang="nl">Er draait minstens één volledig werkend exemplaar van het systeem.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Operational_3"/>
    <ess:description xml:lang="nl">Het systeem draait en wordt gebruikt in de productieomgeving.</ess:description>
    <ess:name xml:lang="nl">Operationeel</ess:name>
    <ess:successor>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Retired">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Retired_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Retired_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Retired_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Retired_4"/>
        <ess:description xml:lang="nl">Het systeem wordt niet meer onderhouden of ondersteund.</ess:description>
        <ess:name xml:lang="nl">Uitgefaseerd</ess:name>
      </ess:State>
    </ess:successor>
  </ess:State>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Addressed_3">
    <ess:description xml:lang="nl">De stakeholders zijn ervan overtuigd dat de opgeleverde oplossing de uitdaging daadwerkelijk aanpakt.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Bounded_2">
    <ess:description xml:lang="nl">De stakeholders zijn het eens over waar het nieuwe systeem voor dient.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_6">
    <ess:description xml:lang="nl">Vaststaat dat het de moeite waard is om deze uitdaging aan te gaan.</ess:description>
    <ess:name>6</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_2">
    <ess:description xml:lang="nl">De kernconcepten en eigenschappen van de architectuur staan helder omschreven.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Retired_2">
    <ess:description xml:lang="nl">Er wordt geen ondersteuning meer geboden op het systeem.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_1">
        <ess:description xml:lang="nl">De requirements staan op papier en zijn gedeeld met team en stakeholders.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_2"/>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_3">
        <ess:description xml:lang="nl">De onderliggende motivatie van de requirements is helder.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_4">
        <ess:description xml:lang="nl">Tegenstrijdigheden tussen requirements zijn opgespoord en opgelost.</ess:description>
        <ess:name>4</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_5"/>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_6">
        <ess:description xml:lang="nl">De belangrijkste gebruiksscenario's van het systeem zijn uit te leggen.</ess:description>
        <ess:name>6</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_7">
        <ess:description xml:lang="nl">Duidelijk is welke requirements voorrang krijgen.</ess:description>
        <ess:name>7</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_8">
        <ess:description xml:lang="nl">Helder is wat het realiseren van de requirements teweegbrengt.</ess:description>
        <ess:name>8</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_9">
        <ess:description xml:lang="nl">Het team weet wat er moet worden opgeleverd en zegt dat toe.</ess:description>
        <ess:name>9</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="nl">De requirements schetsen samen een consistent beeld van wat het nieuwe systeem wezenlijk moet kunnen.</ess:description>
    <ess:name xml:lang="nl">Samenhangend</ess:name>
    <ess:successor>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable_3"/>
