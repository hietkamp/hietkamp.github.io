        <ess:description xml:lang="nl">De verantwoordelijkheden van de stakeholdervertegenwoordigers zijn vastgelegd.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="en">Stakeholders have been identified.</ess:description>
    <ess:description xml:lang="nl">Stakeholders zijn geïdentificeerd.</ess:description>
    <ess:name>Recognized</ess:name>
    <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Represented"/>
  </ess:State>
