        <ess:name xml:lang="nl">Werk afronden</ess:name>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EndeavorAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#SupporttheTeam">
        <ess:briefDescription xml:lang="nl">Teamleden worden hier geholpen om zelfredzaam te zijn, goed samen te werken, en hun manier van werken te verbeteren.</ess:briefDescription>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SupporttheTeam_CC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SupporttheTeam_CC_2"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SupporttheTeam_EC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SupporttheTeam_EC_2"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work"/>
        <ess:name xml:lang="nl">Team ondersteunen</ess:name>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EndeavorAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:Alpha rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System">
        <ess:briefDescription xml:lang="nl">Een System bestaat uit elementen die samenwerken om een vastgesteld doel te bereiken — denk aan hardware, software, data, mensen, processen, diensten, procedures, voorzieningen, materialen, en van nature voorkomende elementen, in elke combinatie.</ess:briefDescription>
        <ess:name xml:lang="nl">Systeem</ess:name>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Demonstrable"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Operational"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Retired"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable"/>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SolutionAreaOfConcern"/>
      </ess:Alpha>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:AlphaAssociation rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_fulfills_Requirements">
            <ess:description xml:lang="nl">Het System is er om aan de Requirements te voldoen.</ess:description>
        <ess:end1 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System"/>
        <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements"/>
        <ess:name xml:lang="nl">voldoet aan</ess:name>
      </ess:AlphaAssociation>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:AlphaAssociation rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_helpstoaddress_Opportunity">
            <ess:description xml:lang="nl">Het System draagt eraan bij dat de uitdaging wordt aangepakt.</ess:description>
        <ess:end1 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System"/>
        <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity"/>
        <ess:name xml:lang="nl">draagt bij aan het benutten van</ess:name>
      </ess:AlphaAssociation>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:Alpha rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team">
        <ess:briefDescription xml:lang="nl">Het Team is de groep mensen die zich actief bezighoudt met het bouwen, onderhouden, opleveren of ondersteunen van een specifiek systeem.</ess:briefDescription>
        <ess:name xml:lang="nl">Team</ess:name>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Adjourned"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Collaborating"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Performing"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Seeded"/>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EndeavorAreaOfConcern"/>
      </ess:Alpha>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:AlphaAssociation rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_applies_WayofWorking">
            <ess:description xml:lang="nl">Het Team zet de Werkwijze in de praktijk in.</ess:description>
        <ess:end1 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team"/>
        <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking"/>
        <ess:name xml:lang="nl">past toe</ess:name>
      </ess:AlphaAssociation>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:AlphaAssociation rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_performsandplans_Work">
            <ess:description xml:lang="nl">Het Team plant het Work en voert het uit.</ess:description>
        <ess:end1 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team"/>
        <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work"/>
        <ess:name xml:lang="nl">voert uit en plant</ess:name>
      </ess:AlphaAssociation>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:AlphaAssociation rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_produces_System">
            <ess:description xml:lang="nl">Het Team is verantwoordelijk voor het opleveren van het System.</ess:description>
        <ess:end1 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team"/>
        <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System"/>
        <ess:name xml:lang="nl">brengt voort</ess:name>
      </ess:AlphaAssociation>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:Competency rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Testing">
        <ess:briefDescription xml:lang="nl">Testen is het vermogen om een systeem te beproeven: zowel valideren — voldoet het aan wat gebruikers nodig hebben — als verifiëren — voldoet het aan de vastgelegde requirements.</ess:briefDescription>
        <ess:name xml:lang="nl">Testen</ess:name>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Adapts"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Applies"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Assists"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Innovates"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Masters"/>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SolutionAreaOfConcern"/>
      </ess:Competency>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#TesttheSystem">
        <ess:briefDescription xml:lang="nl">Hier wordt geverifieerd of het opgeleverde systeem aan de requirements van de stakeholders voldoet.</ess:briefDescription>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#TesttheSystem_CC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#TesttheSystem_CC_2"/>
