  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Conceived_1">
    <ess:description xml:lang="en">The initial set of stakeholders agrees that a system is to be produced.</ess:description>
    <ess:description xml:lang="nl">De eerste groep stakeholders is het erover eens dat er een systeem moet worden gerealiseerd.</ess:description>
    <ess:name>1</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Conceived_3">
    <ess:description xml:lang="en">The stakeholders that will fund the initial work on the new system are identified.</ess:description>
    <ess:description xml:lang="nl">De stakeholders die het initiële werk aan het nieuwe systeem financieren zijn geïdentificeerd.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell_1">
    <ess:description xml:lang="en">Team members are making progress as planned by using and adapting the way-of-working to suit their current context.</ess:description>
    <ess:description xml:lang="nl">Teamleden boeken voortgang volgens plan door de werkwijze te gebruiken en aan te passen aan hun huidige context.</ess:description>
    <ess:name>1</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Prepared_3">
    <ess:description xml:lang="en">Resource availability is understood.</ess:description>
    <ess:description xml:lang="nl">Beschikbaarheid van resources is bekend.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_4">
    <ess:description xml:lang="en">The indicative (ball-park) costs of the solution are less than the anticipated value of the opportunity.</ess:description>
    <ess:description xml:lang="nl">De indicatieve (grove) kosten van de oplossing zijn lager dan de verwachte waarde van de kans.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Prepared_12">
    <ess:description xml:lang="en">Integration and delivery points are defined.</ess:description>
    <ess:description xml:lang="nl">Integratie- en opleverpunten zijn vastgelegd.</ess:description>
    <ess:name>12</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded_2">
    <ess:description xml:lang="en">The stakeholders' needs that generate the opportunity have been established.</ess:description>
    <ess:description xml:lang="nl">De behoeften van de stakeholders die aanleiding geven tot de kans zijn vastgesteld.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Involved_1">
    <ess:description xml:lang="en">The stakeholder representatives assist the team in accordance with their responsibilities.</ess:description>
    <ess:description xml:lang="nl">De stakeholdervertegenwoordigers ondersteunen het team overeenkomstig hun verantwoordelijkheden.</ess:description>
    <ess:name>1</ess:name>
  </ess:Checkpoint>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#EnsureStakeholderSatisfaction_CC_2">
    <ess:description xml:lang="en">Opportunity::Addressed</ess:description>
    <ess:description xml:lang="nl">Opportunity::Geadresseerd</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Addressed"/>
  </ess:CompletionCriterion>
  <ess:EntryCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#StoptheWork_EC_3">
    <ess:description xml:lang="en">Work::Concluded</ess:description>
    <ess:description xml:lang="nl">Work::Afgerond</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Concluded"/>
  </ess:EntryCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Started_3">
    <ess:description xml:lang="en">The work is being broken down into actionable work items with clear definitions of done.</ess:description>
    <ess:description xml:lang="nl">Het werk wordt opgedeeld in uitvoerbare werkitems met duidelijke definities van "klaar".</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Started_2">
    <ess:description xml:lang="en">Work progress is monitored.</ess:description>
    <ess:description xml:lang="nl">Voortgang van het werk wordt gevolgd.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#DeploytheSystem_CC_1">
    <ess:description xml:lang="en">System::Operational</ess:description>
    <ess:description xml:lang="nl">System::Operationeel</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Operational"/>
  </ess:CompletionCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_3">
    <ess:description xml:lang="en">The selected architecture is clearly conceived.</ess:description>
    <ess:description xml:lang="nl">De gekozen architectuur is duidelijk doordacht.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Adjourned_2">
    <ess:description xml:lang="en">The team members are available for assignment to other teams.</ess:description>
    <ess:description xml:lang="nl">De teamleden zijn beschikbaar voor toewijzing aan andere teams.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_SatisfiedinUse_2">
    <ess:description xml:lang="en">The stakeholders confirm that the new system meets their expectations.</ess:description>
    <ess:description xml:lang="nl">De stakeholders bevestigen dat het nieuwe systeem aan hun verwachtingen voldoet.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Conceived">
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Conceived_1"/>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Conceived_2"/>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Conceived_3"/>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Conceived_4"/>
    <ess:description xml:lang="en">The need for a new system has been agreed.</ess:description>
    <ess:description xml:lang="nl">De behoefte aan een nieuw systeem is overeengekomen.</ess:description>
    <ess:name>Conceived</ess:name>
    <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Bounded"/>
  </ess:State>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_2">
    <ess:description xml:lang="en">The indications are that the solution can be developed and deployed within constraints.</ess:description>
    <ess:description xml:lang="nl">Er zijn aanwijzingen dat de oplossing binnen de randvoorwaarden kan worden ontwikkeld en uitgerold.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_3">
    <ess:description xml:lang="en">The risks associated with the solution are acceptable and manageable.</ess:description>
    <ess:description xml:lang="nl">De risico's van de oplossing zijn acceptabel en beheersbaar.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:EntryCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#UsetheSystem_EC_1">
    <ess:description xml:lang="en">Stakeholders::Satisfied for Deployment</ess:description>
    <ess:description xml:lang="nl">Stakeholders::Tevreden voor uitrol</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_SatisfiedforDeployment"/>
  </ess:EntryCriterion>
  <ess:EntryCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#ShapetheSystem_EC_1">
    <ess:description xml:lang="en">Requirements::Coherent</ess:description>
    <ess:description xml:lang="nl">Requirements::Samenhangend</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent"/>
  </ess:EntryCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed_6">
    <ess:description xml:lang="en">There are no outstanding, uncompleted tasks.</ess:description>
    <ess:description xml:lang="nl">Er zijn geen openstaande, onvoltooide taken meer.</ess:description>
    <ess:name>6</ess:name>
  </ess:Checkpoint>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#ImplementtheSystem_CC_1">
    <ess:description xml:lang="en">System::Ready</ess:description>
    <ess:description xml:lang="nl">System::Gereed</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready"/>
  </ess:CompletionCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell_2">
    <ess:description xml:lang="en">The team naturally applies the practices without thinking about them.</ess:description>
    <ess:description xml:lang="nl">Het team past de practices vanzelfsprekend toe, zonder erover na te denken.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_7">
    <ess:description xml:lang="en">Key technical risks agreed to.</ess:description>
    <ess:description xml:lang="nl">Overeenstemming over de belangrijkste technische risico's.</ess:description>
    <ess:name>7</ess:name>
  </ess:Checkpoint>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#EnsureStakeholderSatisfaction_CC_1">
    <ess:description xml:lang="en">Stakeholders::Satisfied for Deployment</ess:description>
    <ess:description xml:lang="nl">Stakeholders::Tevreden voor uitrol</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_SatisfiedforDeployment"/>
  </ess:CompletionCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Prepared_4">
    <ess:description xml:lang="en">Governance policies and procedures are clear.</ess:description>
    <ess:description xml:lang="nl">Governancebeleid en -procedures zijn duidelijk.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Addressed_2">
    <ess:description xml:lang="en">The stakeholders agree that the available solution is worth deploying.</ess:description>
    <ess:description xml:lang="nl">De stakeholders zijn het erover eens dat het uitrollen van de beschikbare oplossing de moeite waard is.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Collaborating_4">
    <ess:description xml:lang="en">The team members know and trust each other.</ess:description>
    <ess:description xml:lang="nl">De teamleden kennen en vertrouwen elkaar.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Retired_1">
    <ess:description xml:lang="en">The system has been replaced or discontinued.</ess:description>
    <ess:description xml:lang="nl">Het systeem is vervangen of buiten gebruik gesteld.</ess:description>
    <ess:name>1</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Prepared_8">
    <ess:description xml:lang="en">Tasks have been identified and prioritized by the team and stakeholders.</ess:description>
    <ess:description xml:lang="nl">Taken zijn geïdentificeerd en geprioriteerd door het team en de stakeholders.</ess:description>
    <ess:name>8</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable_4">
    <ess:description xml:lang="en">The parts of the opportunity satisfied by the requirements are clear.</ess:description>
    <ess:description xml:lang="nl">De onderdelen van de kans die door de requirements worden ingevuld, zijn duidelijk.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:CompetencyLevel rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Masters">
    <ess:briefDescription xml:lang="en">Able to apply the concepts in most contexts and has the experience to work without supervision.</ess:briefDescription>
    <ess:briefDescription xml:lang="nl">In staat om de concepten in de meeste contexten toe te passen en heeft de ervaring om zonder toezicht te werken.</ess:briefDescription>
    <ess:level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</ess:level>
    <ess:name>Masters</ess:name>
  </ess:CompetencyLevel>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable_1">
    <ess:description xml:lang="en">The stakeholders accept that the requirements describe an acceptable solution.</ess:description>
    <ess:description xml:lang="nl">De stakeholders accepteren dat de requirements een acceptabele oplossing beschrijven.</ess:description>
    <ess:name>1</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement_4">
    <ess:description xml:lang="en">The team members agree that their input is valued by the stakeholder representatives and treated with respect.</ess:description>
    <ess:description xml:lang="nl">De teamleden zijn het erover eens dat hun inbreng door de stakeholdervertegenwoordigers wordt gewaardeerd en met respect wordt behandeld.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell_3">
    <ess:description xml:lang="en">The tools naturally support the way that the team works.</ess:description>
    <ess:description xml:lang="nl">De hulpmiddelen ondersteunen vanzelfsprekend de manier waarop het team werkt.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:EntryCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#StoptheWork_EC_2">
    <ess:description xml:lang="en">Way-of-Working::Working Well</ess:description>
    <ess:description xml:lang="nl">Way-of-Working::Werkt goed</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell"/>
  </ess:EntryCriterion>
  <ess:EntryCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#DeploytheSystem_EC_1">
    <ess:description xml:lang="en">System::Ready</ess:description>
    <ess:description xml:lang="nl">System::Gereed</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready"/>
  </ess:EntryCriterion>
  <ess:EntryCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#UnderstandStakeholderNeeds_EC_1">
    <ess:description xml:lang="en">Stakeholders::Recognized</ess:description>
    <ess:description xml:lang="nl">Stakeholders::Herkend</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Recognized"/>
  </ess:EntryCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready_2">
    <ess:description xml:lang="en">The stakeholder representatives want to make the system available for use.</ess:description>
    <ess:description xml:lang="nl">De stakeholdervertegenwoordigers willen het systeem beschikbaar maken voor gebruik.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#TesttheSystem_CC_1">
    <ess:description xml:lang="en">Requirements::Fulfilled</ess:description>
    <ess:description xml:lang="nl">Requirements::Vervuld</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Fulfilled"/>
  </ess:CompletionCriterion>
  <ess:EntryCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#SupporttheTeam_EC_2">
    <ess:description xml:lang="en">Way-of-Working::Foundation Established</ess:description>
    <ess:description xml:lang="nl">Way-of-Working::Fundament gelegd</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_FoundationEstablished"/>
  </ess:EntryCriterion>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#PreparetodotheWork_CC_1">
    <ess:description xml:lang="en">Team::Seeded</ess:description>
    <ess:description xml:lang="nl">Team::Gekiemd</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Seeded"/>
  </ess:CompletionCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Prepared_11">
    <ess:description xml:lang="en">The team or at least some of the team members are ready to start the work.</ess:description>
    <ess:description xml:lang="nl">Het team, of ten minste een deel van de teamleden, is klaar om het werk te starten.</ess:description>
    <ess:name>11</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable_2">
    <ess:description xml:lang="en">The rate of change to the agreed requirements is relatively low and under control.</ess:description>
    <ess:description xml:lang="nl">De mate van verandering in de overeengekomen requirements is relatief laag en onder controle.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded_3">
    <ess:description xml:lang="en">Any underlying problems and their root causes have been identified.</ess:description>
    <ess:description xml:lang="nl">Eventuele onderliggende problemen en hun grondoorzaken zijn geïdentificeerd.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_FoundationEstablished_5">
    <ess:description xml:lang="en">The capability gaps that exist between what is needed to execute the desired way of working and the capability levels of the team have been analyzed and understood.</ess:description>
    <ess:description xml:lang="nl">De competentiekloof tussen wat nodig is om de gewenste werkwijze uit te voeren en het competentieniveau van het team is geanalyseerd en begrepen.</ess:description>
    <ess:name>5</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_5">
    <ess:description xml:lang="en">The reasons for the development of a system-based solution are understood by all members of the team.</ess:description>
    <ess:description xml:lang="nl">De redenen voor het ontwikkelen van een systeemgebaseerde oplossing worden door alle teamleden begrepen.</ess:description>
    <ess:name>5</ess:name>
  </ess:Checkpoint>
  <ess:EntryCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#SupporttheTeam_EC_1">
    <ess:description xml:lang="en">Team::Formed</ess:description>
    <ess:description xml:lang="nl">Team::Gevormd</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed"/>
  </ess:EntryCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Prepared_1">
    <ess:description xml:lang="en">Commitment is made.</ess:description>
    <ess:description xml:lang="nl">Er is toezegging gedaan.</ess:description>
    <ess:name>1</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Prepared_5">
    <ess:description xml:lang="en">Risk exposure is understood.</ess:description>
    <ess:description xml:lang="nl">Risicoblootstelling is bekend.</ess:description>
    <ess:name>5</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Involved_3">
    <ess:description xml:lang="en">The stakeholder representatives promptly communicate changes that are relevant for their stakeholder groups.</ess:description>
    <ess:description xml:lang="nl">De stakeholdervertegenwoordigers communiceren wijzigingen die relevant zijn voor hun stakeholdergroepen tijdig.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#ExplorePossibilities_CC_2">
    <ess:description xml:lang="en">Opportunity::Value Established</ess:description>
    <ess:description xml:lang="nl">Opportunity::Waarde vastgesteld</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_ValueEstablished"/>
  </ess:CompletionCriterion>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#TrackProgress_CC_3">
    <ess:description xml:lang="en">Work::Concluded</ess:description>
    <ess:description xml:lang="nl">Work::Afgerond</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Concluded"/>
  </ess:CompletionCriterion>
</rdf:RDF>
