    <ess:description xml:lang="nl">Alle niet-onderhandelbare practices en hulpmiddelen zijn geïdentificeerd.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_FoundationEstablished_1">
