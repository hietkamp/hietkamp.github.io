        <ess:description xml:lang="nl">De stakeholdervertegenwoordigers becommentariëren het systeem vanuit het oogpunt van hun achterban.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_SatisfiedforDeployment_2">
