        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SolutionAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#TrackProgress">
        <ess:briefDescription xml:lang="en">Measure and assess the progress made by the team.</ess:briefDescription>
        <ess:briefDescription xml:lang="nl">Meet en beoordeel de voortgang die het team heeft geboekt.</ess:briefDescription>
