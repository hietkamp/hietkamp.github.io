        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SolutionAreaOfConcern"/>
      </ess:Alpha>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:AlphaAssociation rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_fulfills_Requirements">
