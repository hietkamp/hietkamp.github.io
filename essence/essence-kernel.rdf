    <ess:ownedElements>
      <ess:Competency rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Testing">
        <ess:briefDescription xml:lang="en">The ability to test a system, including validating that the system meets the needs of users and verifying that the system meets the requirements.</ess:briefDescription>
        <ess:briefDescription xml:lang="nl">Het vermogen om een systeem te testen, inclusief het valideren dat het systeem voldoet aan de behoeften van gebruikers en het verifiëren dat het systeem aan de requirements voldoet.</ess:briefDescription>
        <ess:name>Testing</ess:name>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Adapts"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Applies"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Assists"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Innovates"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Masters"/>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SolutionAreaOfConcern"/>
      </ess:Competency>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#TesttheSystem">
        <ess:briefDescription xml:lang="en">Verify that the system produced meets the stakeholders' requirements.</ess:briefDescription>
        <ess:briefDescription xml:lang="nl">Verifieer dat het opgeleverde systeem voldoet aan de requirements van de stakeholders.</ess:briefDescription>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#TesttheSystem_CC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#TesttheSystem_CC_2"/>
