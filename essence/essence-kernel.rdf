    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Performing"/>
  </ess:CompletionCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement_1">
    <ess:description xml:lang="en">The stakeholder representatives have agreed upon their minimal expectations for the next deployment of the new system.</ess:description>
    <ess:description xml:lang="nl">De stakeholdervertegenwoordigers zijn het eens over hun minimale verwachtingen voor de volgende uitrol van het nieuwe systeem.</ess:description>
    <ess:name>1</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Seeded_1">
    <ess:description xml:lang="en">The team mission has been defined in terms of the opportunities and outcomes.</ess:description>
    <ess:description xml:lang="nl">De teammissie is gedefinieerd in termen van kansen en uitkomsten.</ess:description>
    <ess:name>1</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_ValueEstablished">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_ValueEstablished_1">
        <ess:description xml:lang="en">The value of addressing the opportunity has been quantified either in absolute terms or in returns or savings per time period.</ess:description>
        <ess:description xml:lang="nl">De waarde van het adresseren van de kans is gekwantificeerd, hetzij in absolute termen, hetzij in rendement of besparingen per periode.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_ValueEstablished_2">
        <ess:description xml:lang="en">The impact of the solution on the stakeholders is understood.</ess:description>
        <ess:description xml:lang="nl">De impact van de oplossing op de stakeholders is begrepen.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_ValueEstablished_3">
        <ess:description xml:lang="en">The value that the system offers to the stakeholders that fund and use the system is understood.</ess:description>
        <ess:description xml:lang="nl">De waarde die het systeem biedt aan de stakeholders die het financieren en gebruiken, is begrepen.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_ValueEstablished_4"/>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_ValueEstablished_5"/>
    <ess:description xml:lang="en">The value of a successful solution has been established.</ess:description>
    <ess:description xml:lang="nl">De waarde van een succesvolle oplossing is vastgesteld.</ess:description>
    <ess:name>Value Established</ess:name>
    <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable"/>
  </ess:State>
  <ess:CompetencyLevel rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Innovates">
    <ess:briefDescription xml:lang="en">A recognized expert, able to extend the concepts to new contexts and inspire others.</ess:briefDescription>
    <ess:briefDescription xml:lang="nl">Een erkend expert, in staat om de concepten naar nieuwe contexten uit te breiden en anderen te inspireren.</ess:briefDescription>
