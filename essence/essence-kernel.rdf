        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking"/>
        <ess:name xml:lang="nl">Systeem testen</ess:name>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SolutionAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#TrackProgress">
        <ess:briefDescription xml:lang="nl">De voortgang van het team wordt hier gemeten en beoordeeld.</ess:briefDescription>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#TrackProgress_CC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#TrackProgress_CC_2"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#TrackProgress_CC_3"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#TrackProgress_EC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#TrackProgress_EC_2"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#TrackProgress_EC_3"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements"/>
