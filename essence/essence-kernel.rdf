        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_SatisfiedinUse_2"/>
        <ess:description xml:lang="nl">In de praktijk haalt of overtreft het systeem de minimale verwachtingen van de stakeholders.</ess:description>
        <ess:name xml:lang="nl">Voldoende in gebruik</ess:name>
      </ess:State>
    </ess:successor>
  </ess:State>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement_5">
