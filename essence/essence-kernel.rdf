        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable_5"/>
        <ess:description xml:lang="nl">Het systeem zoals de requirements dat beschrijven, kan op instemming van de stakeholders rekenen.</ess:description>
