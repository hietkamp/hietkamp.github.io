    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#StoptheWork">
        <ess:briefDescription xml:lang="en">Shut down the engineering endeavor and hand over the team's responsibilities.</ess:briefDescription>
        <ess:briefDescription xml:lang="nl">Sluit het ontwikkeltraject af en draag de verantwoordelijkheden van het team over.</ess:briefDescription>
