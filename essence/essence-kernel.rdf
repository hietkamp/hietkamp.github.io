    <ess:ownedElements>
      <ess:Alpha rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System">
        <ess:briefDescription xml:lang="en">A set of elements interacting to achieve a defined purpose, including one or more of: hardware, software, data, humans, processes, services, procedures, facilities, materials and naturally occurring entities.</ess:briefDescription>
        <ess:briefDescription xml:lang="nl">Een verzameling elementen die met elkaar interacteren om een bepaald doel te bereiken, waaronder een of meer van: hardware, software, data, mensen, processen, diensten, procedures, faciliteiten, materialen en natuurlijk voorkomende entiteiten.</ess:briefDescription>
        <ess:name>System</ess:name>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Demonstrable"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Operational"/>
