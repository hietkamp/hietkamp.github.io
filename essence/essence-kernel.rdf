  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InUse_6">
    <ess:description xml:lang="en">The practices and tools support team communication and collaboration.</ess:description>
    <ess:description xml:lang="nl">De practices en hulpmiddelen ondersteunen de communicatie en samenwerking binnen het team.</ess:description>
    <ess:name>6</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Fulfilled">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Fulfilled_1">
        <ess:description xml:lang="en">The stakeholders accept the requirements as accurately capturing what they require to fully satisfy the need for a new system.</ess:description>
        <ess:description xml:lang="nl">De stakeholders accepteren dat de requirements nauwkeurig vastleggen wat nodig is om volledig te voldoen aan de behoefte aan een nieuw systeem.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Fulfilled_2">
        <ess:description xml:lang="en">There are no outstanding requirement items preventing the system from being accepted as fully satisfying the requirements.</ess:description>
        <ess:description xml:lang="nl">Er zijn geen openstaande requirement-items die verhinderen dat het systeem wordt geaccepteerd als volledig voldoend aan de requirements.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Fulfilled_3">
        <ess:description xml:lang="en">The system is accepted by the stakeholders as fully satisfying the requirements.</ess:description>
        <ess:description xml:lang="nl">Het systeem wordt door de stakeholders geaccepteerd als volledig voldoend aan de requirements.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="en">The requirements that have been addressed fully satisfy the need for a new system.</ess:description>
    <ess:description xml:lang="nl">De geadresseerde requirements voldoen volledig aan de behoefte aan een nieuw systeem.</ess:description>
    <ess:name>Fulfilled</ess:name>
  </ess:State>
  <ess:EntryCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#TrackProgress_EC_3">
    <ess:description xml:lang="en">Work::Started</ess:description>
    <ess:description xml:lang="nl">Work::Gestart</ess:description>
    <ess:state>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Started">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Started_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Started_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Started_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Started_4"/>
        <ess:description xml:lang="en">The work is proceeding.</ess:description>
        <ess:description xml:lang="nl">Het werk vordert.</ess:description>
        <ess:name>Started</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl"/>
      </ess:State>
    </ess:state>
  </ess:EntryCriterion>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#TesttheSystem_CC_2">
    <ess:description xml:lang="en">System::Ready</ess:description>
    <ess:description xml:lang="nl">System::Gereed</ess:description>
    <ess:state>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready_3"/>
        <ess:description xml:lang="en">The system (as a whole) has been accepted for deployment in a live environment.</ess:description>
        <ess:description xml:lang="nl">Het systeem (als geheel) is geaccepteerd voor uitrol in een productieomgeving.</ess:description>
        <ess:name>Ready</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Operational"/>
      </ess:State>
    </ess:state>
  </ess:CompletionCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Demonstrable_1">
    <ess:description xml:lang="en">Key architectural characteristics have been demonstrated.</ess:description>
    <ess:description xml:lang="nl">Belangrijke architectuurkenmerken zijn aangetoond.</ess:description>
    <ess:name>1</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_1">
        <ess:description xml:lang="en">Individual responsibilities are understood.</ess:description>
        <ess:description xml:lang="nl">Individuele verantwoordelijkheden zijn begrepen.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_10">
        <ess:description xml:lang="en">Each team member commits to working on the team as defined.</ess:description>
        <ess:description xml:lang="nl">Elk teamlid committeert zich aan het werken in het team zoals gedefinieerd.</ess:description>
        <ess:name>10</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_2">
        <ess:description xml:lang="en">Enough team members have been recruited to enable the work to progress.</ess:description>
        <ess:description xml:lang="nl">Er zijn voldoende teamleden geworven om het werk te laten vorderen.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_3">
        <ess:description xml:lang="en">Every team member understands how the team is organized and what their individual role is.</ess:description>
        <ess:description xml:lang="nl">Elk teamlid begrijpt hoe het team is georganiseerd en wat zijn individuele rol is.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_4">
        <ess:description xml:lang="en">All team members understand how to perform their work.</ess:description>
        <ess:description xml:lang="nl">Alle teamleden begrijpen hoe ze hun werk moeten uitvoeren.</ess:description>
        <ess:name>4</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_5">
        <ess:description xml:lang="en">The team members have met (perhaps virtually) and are beginning to get to know each other.</ess:description>
        <ess:description xml:lang="nl">De teamleden hebben elkaar ontmoet (eventueel virtueel) en beginnen elkaar te leren kennen.</ess:description>
        <ess:name>5</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_6">
        <ess:description xml:lang="en">The team members understand their responsibilities and how they align with their competencies.</ess:description>
        <ess:description xml:lang="nl">De teamleden begrijpen hun verantwoordelijkheden en hoe deze aansluiten bij hun competenties.</ess:description>
        <ess:name>6</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_7">
        <ess:description xml:lang="en">Team members are accepting work.</ess:description>
        <ess:description xml:lang="nl">Teamleden accepteren werk.</ess:description>
        <ess:name>7</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_8">
        <ess:description xml:lang="en">Any external collaborators (organizations, teams and individuals) are identified.</ess:description>
        <ess:description xml:lang="nl">Eventuele externe samenwerkingspartners (organisaties, teams en individuen) zijn geïdentificeerd.</ess:description>
        <ess:name>8</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed_9">
        <ess:description xml:lang="en">Team communication mechanisms have been defined.</ess:description>
        <ess:description xml:lang="nl">Communicatiemechanismen voor het team zijn vastgelegd.</ess:description>
        <ess:name>9</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="en">The team has been populated with enough committed people to start to pursue the team mission.</ess:description>
    <ess:description xml:lang="nl">Het team is bemenst met voldoende toegewijde mensen om de teammissie te kunnen nastreven.</ess:description>
    <ess:name>Formed</ess:name>
    <ess:successor>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Collaborating">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Collaborating_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Collaborating_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Collaborating_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Collaborating_4"/>
        <ess:description xml:lang="en">The team members are working together as one unit.</ess:description>
        <ess:description xml:lang="nl">De teamleden werken samen als één eenheid.</ess:description>
        <ess:name>Collaborating</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Performing"/>
      </ess:State>
    </ess:successor>
  </ess:State>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_5">
    <ess:description xml:lang="en">The system is sufficiently documented.</ess:description>
    <ess:description xml:lang="nl">Het systeem is voldoende gedocumenteerd.</ess:description>
    <ess:name>5</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Prepared_6">
    <ess:description xml:lang="en">Acceptance criteria are defined and agreed with client.</ess:description>
    <ess:description xml:lang="nl">Acceptatiecriteria zijn gedefinieerd en overeengekomen met de klant.</ess:description>
    <ess:name>6</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Operational_3">
    <ess:description xml:lang="en">The system is fully supported to the agreed service levels.</ess:description>
    <ess:description xml:lang="nl">Het systeem wordt volledig ondersteund conform de overeengekomen serviceniveaus.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_1">
        <ess:description xml:lang="en">The system can be operated by stakeholders who use it.</ess:description>
        <ess:description xml:lang="nl">Het systeem kan worden bediend door de stakeholders die het gebruiken.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_2">
        <ess:description xml:lang="en">The functionality provided by the system has been tested.</ess:description>
        <ess:description xml:lang="nl">De functionaliteit van het systeem is getest.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_3">
        <ess:description xml:lang="en">The performance of the system is acceptable to the stakeholders.</ess:description>
        <ess:description xml:lang="nl">De prestaties van het systeem zijn acceptabel voor de stakeholders.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_4">
        <ess:description xml:lang="en">Defect levels are acceptable to the stakeholders.</ess:description>
        <ess:description xml:lang="nl">De hoeveelheid defecten is acceptabel voor de stakeholders.</ess:description>
        <ess:name>4</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_5"/>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_6">
        <ess:description xml:lang="en">Released system elements are known.</ess:description>
        <ess:description xml:lang="nl">Uitgebrachte systeemelementen zijn bekend.</ess:description>
        <ess:name>6</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_7">
        <ess:description xml:lang="en">The added value provided by the system is clear.</ess:description>
        <ess:description xml:lang="nl">De toegevoegde waarde van het systeem is duidelijk.</ess:description>
        <ess:name>7</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable_8">
        <ess:description xml:lang="en">Documentation on how to deploy and use the system in its intended environment is available.</ess:description>
        <ess:description xml:lang="nl">Documentatie over het uitrollen en gebruiken van het systeem in de beoogde omgeving is beschikbaar.</ess:description>
        <ess:name>8</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="en">The system is usable and demonstrates all of the quality characteristics of an operational system.</ess:description>
    <ess:description xml:lang="nl">Het systeem is bruikbaar en toont alle kwaliteitskenmerken van een operationeel systeem.</ess:description>
    <ess:name>Usable</ess:name>
    <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready"/>
  </ess:State>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Prepared_7">
    <ess:description xml:lang="en">The work is broken down sufficiently for productive work to start.</ess:description>
    <ess:description xml:lang="nl">Het werk is voldoende opgedeeld om productief te kunnen starten.</ess:description>
    <ess:name>7</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InPlace_3">
    <ess:description xml:lang="en">The whole team is involved in the inspection and adaptation of the way-of-working.</ess:description>
    <ess:description xml:lang="nl">Het hele team is betrokken bij het inspecteren en aanpassen van de werkwijze.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded_1">
    <ess:description xml:lang="en">The stakeholders in the opportunity and the proposed solution have been identified.</ess:description>
    <ess:description xml:lang="nl">De stakeholders bij de kans en de voorgestelde oplossing zijn geïdentificeerd.</ess:description>
    <ess:name>1</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Started_4">
    <ess:description xml:lang="en">Team members are accepting and progressing tasks.</ess:description>
    <ess:description xml:lang="nl">Teamleden accepteren en voeren taken uit.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:EntryCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#OperatetheSystem_EC_1">
    <ess:description xml:lang="en">System::Ready</ess:description>
    <ess:description xml:lang="nl">System::Gereed</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready"/>
  </ess:EntryCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_FoundationEstablished_2">
    <ess:description xml:lang="en">Enough practices for work to start are agreed to by the team.</ess:description>
    <ess:description xml:lang="nl">Het team is het eens over voldoende practices om het werk te kunnen starten.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_ValueEstablished_5">
    <ess:description xml:lang="en">The desired outcomes required of the solution are clear and quantified.</ess:description>
    <ess:description xml:lang="nl">De gewenste uitkomsten van de oplossing zijn duidelijk en gekwantificeerd.</ess:description>
    <ess:name>5</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_PrinciplesEstablished_4">
    <ess:description xml:lang="en">A recommendation for the approach to be taken is available.</ess:description>
    <ess:description xml:lang="nl">Er is een aanbeveling beschikbaar voor de te volgen aanpak.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_5">
    <ess:description xml:lang="en">The requirements communicate the essential characteristics of the system to be delivered.</ess:description>
    <ess:description xml:lang="nl">De requirements communiceren de essentiële kenmerken van het op te leveren systeem.</ess:description>
    <ess:name>5</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable_3">
    <ess:description xml:lang="en">The value provided by implementing the requirements is clear.</ess:description>
    <ess:description xml:lang="nl">De waarde van het implementeren van de requirements is duidelijk.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#UnderstandStakeholderNeeds_CC_2">
    <ess:description xml:lang="en">Opportunity::Viable</ess:description>
    <ess:description xml:lang="nl">Opportunity::Haalbaar</ess:description>
    <ess:state>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_4"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_5"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_6"/>
        <ess:description xml:lang="en">It is agreed that a solution can be produced quickly and cheaply enough to successfully address the opportunity.</ess:description>
        <ess:description xml:lang="nl">Er is overeenstemming dat een oplossing snel en goedkoop genoeg kan worden gerealiseerd om de kans succesvol te adresseren.</ess:description>
        <ess:name>Viable</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Addressed"/>
      </ess:State>
    </ess:state>
  </ess:CompletionCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InUse_4">
    <ess:description xml:lang="en">The use of the practices and tools is supported by the team.</ess:description>
    <ess:description xml:lang="nl">Het gebruik van de practices en hulpmiddelen wordt gedragen door het team.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:EntryCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#ImplementtheSystem_EC_1">
    <ess:description xml:lang="en">System::Architecture Selected</ess:description>
    <ess:description xml:lang="nl">System::Architectuur gekozen</ess:description>
    <ess:state>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_4"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_5"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_6"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_7"/>
        <ess:description xml:lang="en">An architecture has been selected that addresses the key technical risks and any applicable organizational constraints.</ess:description>
        <ess:description xml:lang="nl">Er is een architectuur gekozen die de belangrijkste technische risico's en eventuele relevante organisatorische randvoorwaarden adresseert.</ess:description>
        <ess:name>Architecture Selected</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Demonstrable"/>
      </ess:State>
    </ess:state>
  </ess:EntryCriterion>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#UnderstandStakeholderNeeds_CC_1">
    <ess:description xml:lang="en">Stakeholders::In Agreement</ess:description>
    <ess:description xml:lang="nl">Stakeholders::Eensgezind</ess:description>
    <ess:state>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement_4"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement_5"/>
        <ess:description xml:lang="en">The stakeholder representatives are in agreement.</ess:description>
        <ess:description xml:lang="nl">De stakeholdervertegenwoordigers zijn het met elkaar eens.</ess:description>
        <ess:name>In Agreement</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_SatisfiedforDeployment"/>
      </ess:State>
    </ess:state>
  </ess:CompletionCriterion>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Concluded">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Concluded_1">
        <ess:description xml:lang="en">All outstanding tasks are administrative housekeeping or related to preparing the next piece of work.</ess:description>
        <ess:description xml:lang="nl">Alle openstaande taken betreffen administratieve afronding of de voorbereiding van het volgende werk.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Concluded_2">
        <ess:description xml:lang="en">Work results have been achieved.</ess:description>
        <ess:description xml:lang="nl">Werkresultaten zijn behaald.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Concluded_3">
        <ess:description xml:lang="en">The stakeholder(s) has accepted the resulting system.</ess:description>
        <ess:description xml:lang="nl">De stakeholder(s) heeft/hebben het resulterende systeem geaccepteerd.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="en">The work to produce the results has been concluded.</ess:description>
    <ess:description xml:lang="nl">Het werk om de resultaten op te leveren is afgerond.</ess:description>
    <ess:name>Concluded</ess:name>
    <ess:successor>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed_4"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed_5"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed_6"/>
        <ess:description xml:lang="en">All remaining housekeeping tasks have been completed and the work has been officially closed.</ess:description>
        <ess:description xml:lang="nl">Alle resterende afrondingstaken zijn voltooid en het werk is officieel afgesloten.</ess:description>
        <ess:name>Closed</ess:name>
      </ess:State>
    </ess:successor>
  </ess:State>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Initiated_7">
    <ess:description xml:lang="en">The priority of the work is clear.</ess:description>
    <ess:description xml:lang="nl">De prioriteit van het werk is duidelijk.</ess:description>
    <ess:name>7</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_1">
    <ess:description xml:lang="en">A solution has been outlined.</ess:description>
    <ess:description xml:lang="nl">Er is een oplossing op hoofdlijnen geschetst.</ess:description>
    <ess:name>1</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl_1">
        <ess:description xml:lang="en">Tasks are being completed.</ess:description>
        <ess:description xml:lang="nl">Taken worden afgerond.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl_2">
        <ess:description xml:lang="en">Unplanned work is under control.</ess:description>
        <ess:description xml:lang="nl">Ongepland werk is onder controle.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl_3">
        <ess:description xml:lang="en">Risks are under control as the impact if they occur and the likelihood of them occurring have been reduced to acceptable levels.</ess:description>
        <ess:description xml:lang="nl">Risico's zijn onder controle doordat de impact bij optreden en de kans op optreden zijn teruggebracht tot acceptabele niveaus.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl_4">
        <ess:description xml:lang="en">Estimates are revised to reflect the team's performance.</ess:description>
        <ess:description xml:lang="nl">Schattingen zijn bijgesteld op basis van de prestaties van het team.</ess:description>
        <ess:name>4</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl_5">
        <ess:description xml:lang="en">Measures are available to show progress and velocity.</ess:description>
        <ess:description xml:lang="nl">Er zijn meetwaarden beschikbaar om voortgang en snelheid te tonen.</ess:description>
        <ess:name>5</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl_6">
        <ess:description xml:lang="en">Re-work is under control.</ess:description>
        <ess:description xml:lang="nl">Herwerk is onder controle.</ess:description>
        <ess:name>6</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_UnderControl_7">
        <ess:description xml:lang="en">Tasks are consistently completed on time and within their estimates.</ess:description>
        <ess:description xml:lang="nl">Taken worden consistent op tijd en binnen de schatting afgerond.</ess:description>
        <ess:name>7</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="en">The work is going well, risks are under control, and productivity levels are sufficient to achieve a satisfactory result.</ess:description>
    <ess:description xml:lang="nl">Het werk verloopt goed, risico's zijn onder controle, en de productiviteit is voldoende om een bevredigend resultaat te behalen.</ess:description>
    <ess:name>Under Control</ess:name>
    <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Concluded"/>
  </ess:State>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Identified">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Identified_1">
        <ess:description xml:lang="en">An idea for a way of improving current ways of working, increasing market share, or applying a new or innovative system has been identified.</ess:description>
        <ess:description xml:lang="nl">Er is een idee geïdentificeerd om de huidige werkwijze te verbeteren, het marktaandeel te vergroten, of een nieuw of innovatief systeem toe te passen.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Identified_2">
        <ess:description xml:lang="en">At least one of the stakeholders wishes to make an investment in better understanding the opportunity and the value associated with addressing it.</ess:description>
        <ess:description xml:lang="nl">Ten minste één van de stakeholders wil investeren om de kans en de waarde van het adresseren ervan beter te begrijpen.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Identified_3">
        <ess:description xml:lang="en">The other stakeholders who share the opportunity have been identified.</ess:description>
        <ess:description xml:lang="nl">De andere stakeholders die de kans delen zijn geïdentificeerd.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="en">A commercial, social, or business opportunity has been identified that could be addressed by a system-based solution.</ess:description>
    <ess:description xml:lang="nl">Er is een commerciële, sociale of zakelijke kans geïdentificeerd die met een systeemgebaseerde oplossing kan worden aangepakt.</ess:description>
    <ess:name>Identified</ess:name>
    <ess:successor>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded_4"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded_5"/>
        <ess:description xml:lang="en">The need for a system-based solution has been confirmed.</ess:description>
        <ess:description xml:lang="nl">De behoefte aan een systeemgebaseerde oplossing is bevestigd.</ess:description>
        <ess:name>Solution Needed</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_ValueEstablished"/>
      </ess:State>
    </ess:successor>
  </ess:State>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Performing">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Performing_1">
        <ess:description xml:lang="en">The team consistently meets its commitments.</ess:description>
        <ess:description xml:lang="nl">Het team komt zijn toezeggingen consistent na.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Performing_2">
        <ess:description xml:lang="en">The team continuously adapts to the changing context.</ess:description>
        <ess:description xml:lang="nl">Het team past zich voortdurend aan de veranderende context aan.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Performing_3">
        <ess:description xml:lang="en">The team identifies and addresses problems without outside help.</ess:description>
        <ess:description xml:lang="nl">Het team identificeert en pakt problemen op zonder hulp van buitenaf.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Performing_4">
        <ess:description xml:lang="en">Effective progress is being achieved with minimal avoidable backtracking and reworking.</ess:description>
        <ess:description xml:lang="nl">Er wordt effectieve voortgang geboekt met minimale, vermijdbare herhaling en herwerk.</ess:description>
        <ess:name>4</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Performing_5">
        <ess:description xml:lang="en">Wasted work and the potential for wasted work are continuously identified and eliminated.</ess:description>
        <ess:description xml:lang="nl">Verspild werk en de kans op verspild werk worden voortdurend geïdentificeerd en weggenomen.</ess:description>
        <ess:name>5</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="en">The team is working effectively and efficiently.</ess:description>
    <ess:description xml:lang="nl">Het team werkt effectief en efficiënt.</ess:description>
    <ess:name>Performing</ess:name>
    <ess:successor>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Adjourned">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Adjourned_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Adjourned_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Adjourned_3"/>
        <ess:description xml:lang="en">The team is no longer accountable for carrying out its mission.</ess:description>
        <ess:description xml:lang="nl">Het team is niet langer verantwoordelijk voor het uitvoeren van zijn missie.</ess:description>
        <ess:name>Adjourned</ess:name>
      </ess:State>
    </ess:successor>
  </ess:State>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InPlace">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InPlace_1">
        <ess:description xml:lang="en">The practices and tools are being used by the whole team to perform their work.</ess:description>
        <ess:description xml:lang="nl">De practices en hulpmiddelen worden door het hele team gebruikt om hun werk uit te voeren.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InPlace_2">
        <ess:description xml:lang="en">All team members have access to the practices and tools required to do their work.</ess:description>
        <ess:description xml:lang="nl">Alle teamleden hebben toegang tot de practices en hulpmiddelen die nodig zijn om hun werk te doen.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InPlace_3"/>
    <ess:description xml:lang="en">All team members are using the way of working to accomplish their work.</ess:description>
    <ess:description xml:lang="nl">Alle teamleden gebruiken de werkwijze om hun werk uit te voeren.</ess:description>
    <ess:name>In Place</ess:name>
    <ess:successor>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell_4"/>
        <ess:description xml:lang="en">The team's way of working is working well for the team.</ess:description>
        <ess:description xml:lang="nl">De werkwijze van het team werkt goed voor het team.</ess:description>
        <ess:name>Working Well</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_Retired"/>
      </ess:State>
    </ess:successor>
  </ess:State>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Represented">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Represented_1">
        <ess:description xml:lang="en">The stakeholder representatives have agreed to take on their responsibilities.</ess:description>
        <ess:description xml:lang="nl">De stakeholdervertegenwoordigers hebben ingestemd met het op zich nemen van hun verantwoordelijkheden.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Represented_2">
        <ess:description xml:lang="en">The stakeholder representatives are authorized to carry out their responsibilities.</ess:description>
        <ess:description xml:lang="nl">De stakeholdervertegenwoordigers zijn gemachtigd om hun verantwoordelijkheden uit te voeren.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Represented_3">
        <ess:description xml:lang="en">The collaboration approach among the stakeholder representatives has been agreed.</ess:description>
        <ess:description xml:lang="nl">De samenwerkingsaanpak tussen de stakeholdervertegenwoordigers is overeengekomen.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Represented_4">
        <ess:description xml:lang="en">The stakeholder representatives support and respect the team's way of working.</ess:description>
        <ess:description xml:lang="nl">De stakeholdervertegenwoordigers ondersteunen en respecteren de werkwijze van het team.</ess:description>
        <ess:name>4</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="en">The mechanisms for involving the stakeholders are agreed and the stakeholder representatives have been appointed.</ess:description>
    <ess:description xml:lang="nl">De mechanismen om stakeholders te betrekken zijn overeengekomen en de stakeholdervertegenwoordigers zijn benoemd.</ess:description>
    <ess:name>Represented</ess:name>
    <ess:successor>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Involved">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Involved_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Involved_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Involved_3"/>
        <ess:description xml:lang="en">The stakeholder representatives are actively involved in the work and fulfilling their responsibilities.</ess:description>
        <ess:description xml:lang="nl">De stakeholdervertegenwoordigers zijn actief betrokken bij het werk en vervullen hun verantwoordelijkheden.</ess:description>
        <ess:name>Involved</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement"/>
      </ess:State>
    </ess:successor>
  </ess:State>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_Retired">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_Retired_1">
        <ess:description xml:lang="en">The team's way of working is no longer being used.</ess:description>
        <ess:description xml:lang="nl">De werkwijze van het team wordt niet langer gebruikt.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_Retired_2">
        <ess:description xml:lang="en">Lessons learned are shared for future use.</ess:description>
        <ess:description xml:lang="nl">Geleerde lessen worden gedeeld voor toekomstig gebruik.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="en">The way of working is no longer in use by the team.</ess:description>
    <ess:description xml:lang="nl">De werkwijze wordt niet langer gebruikt door het team.</ess:description>
    <ess:name>Retired</ess:name>
  </ess:State>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_FoundationEstablished_4">
    <ess:description xml:lang="en">The gaps that exist between the practices and tools that are needed and the practices and tools that are available have been analyzed and understood.</ess:description>
    <ess:description xml:lang="nl">De verschillen tussen de benodigde en de beschikbare practices en hulpmiddelen zijn geanalyseerd en begrepen.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_ValueEstablished_4">
    <ess:description xml:lang="en">The success criteria by which the deployment of the system is to be judged are clear.</ess:description>
    <ess:description xml:lang="nl">De succescriteria waarmee de uitrol van het systeem wordt beoordeeld, zijn duidelijk.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#StoptheWork_CC_3">
    <ess:description xml:lang="en">Work::Closed</ess:description>
    <ess:description xml:lang="nl">Work::Afgesloten</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed"/>
  </ess:CompletionCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Retired_4">
    <ess:description xml:lang="en">Updates to the system will no longer be produced.</ess:description>
    <ess:description xml:lang="nl">Er worden geen updates meer voor het systeem gemaakt.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_2">
    <ess:description xml:lang="en">The origin of the requirements is clear.</ess:description>
    <ess:description xml:lang="nl">De herkomst van de requirements is duidelijk.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Addressed_3">
    <ess:description xml:lang="en">The set of requirement items implemented provide clear value to the stakeholders.</ess:description>
    <ess:description xml:lang="nl">De set geïmplementeerde requirements levert duidelijke waarde op voor de stakeholders.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#SupporttheTeam_CC_1">
    <ess:description xml:lang="en">Team::Collaborating</ess:description>
    <ess:description xml:lang="nl">Team::Samenwerkend</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Collaborating"/>
  </ess:CompletionCriterion>
  <ess:EntryCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#UsetheSystem_EC_2">
    <ess:description xml:lang="en">Opportunity::Addressed</ess:description>
    <ess:description xml:lang="nl">Opportunity::Geadresseerd</ess:description>
    <ess:state>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Addressed">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Addressed_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Addressed_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Addressed_3"/>
        <ess:description xml:lang="en">A solution has been produced that demonstrably addresses the opportunity.</ess:description>
        <ess:description xml:lang="nl">Er is een oplossing opgeleverd die aantoonbaar de kans adresseert.</ess:description>
        <ess:name>Addressed</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_BenefitAccrued"/>
      </ess:State>
    </ess:state>
  </ess:EntryCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Involved_2">
    <ess:description xml:lang="en">The stakeholder representatives provide feedback and take part in decision making in a timely manner.</ess:description>
    <ess:description xml:lang="nl">De stakeholdervertegenwoordigers geven tijdig feedback en nemen deel aan besluitvorming.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Seeded_7">
    <ess:description xml:lang="en">The level of team commitment is clear.</ess:description>
    <ess:description xml:lang="nl">Het niveau van betrokkenheid van het team is duidelijk.</ess:description>
    <ess:name>7</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Addressed">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Addressed_1">
        <ess:description xml:lang="en">Enough of the requirements are addressed for the resulting system to be acceptable to the stakeholders.</ess:description>
        <ess:description xml:lang="nl">Voldoende requirements zijn geadresseerd om het resulterende systeem acceptabel te maken voor de stakeholders.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Addressed_2">
        <ess:description xml:lang="en">The stakeholders accept the requirements as accurately reflecting what the system does and does not do.</ess:description>
        <ess:description xml:lang="nl">De stakeholders accepteren dat de requirements nauwkeurig weergeven wat het systeem wel en niet doet.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Addressed_3"/>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Addressed_4">
        <ess:description xml:lang="en">The system implementing the requirements is accepted by the stakeholders as worth making operational.</ess:description>
        <ess:description xml:lang="nl">Het systeem dat de requirements implementeert wordt door de stakeholders geaccepteerd als de moeite waard om operationeel te maken.</ess:description>
        <ess:name>4</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="en">Enough of the requirements have been addressed to satisfy the need for a new system in a way that is acceptable to the stakeholders.</ess:description>
    <ess:description xml:lang="nl">Voldoende requirements zijn geadresseerd om de behoefte aan een nieuw systeem op een voor de stakeholders acceptabele manier in te vullen.</ess:description>
    <ess:name>Addressed</ess:name>
    <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Fulfilled"/>
  </ess:State>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_4">
    <ess:description xml:lang="en">System boundary is known.</ess:description>
    <ess:description xml:lang="nl">Systeemgrens is bekend.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Operational">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Operational_1">
        <ess:description xml:lang="en">The system has been made available to the stakeholders intended to use it.</ess:description>
        <ess:description xml:lang="nl">Het systeem is beschikbaar gesteld aan de stakeholders die het moeten gebruiken.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Operational_2">
        <ess:description xml:lang="en">At least one example of the system is fully operational.</ess:description>
        <ess:description xml:lang="nl">Ten minste één voorbeeld van het systeem is volledig operationeel.</ess:description>
        <ess:name>2</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Operational_3"/>
    <ess:description xml:lang="en">The system is in use in an operational environment.</ess:description>
    <ess:description xml:lang="nl">Het systeem is in gebruik in een operationele omgeving.</ess:description>
    <ess:name>Operational</ess:name>
    <ess:successor>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Retired">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Retired_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Retired_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Retired_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Retired_4"/>
        <ess:description xml:lang="en">The system is no longer supported.</ess:description>
        <ess:description xml:lang="nl">Het systeem wordt niet langer ondersteund.</ess:description>
        <ess:name>Retired</ess:name>
      </ess:State>
    </ess:successor>
  </ess:State>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Addressed_3">
    <ess:description xml:lang="en">The stakeholders are satisfied that the solution produced addresses the opportunity.</ess:description>
    <ess:description xml:lang="nl">De stakeholders zijn tevreden dat de opgeleverde oplossing de kans adresseert.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Bounded_2">
    <ess:description xml:lang="en">The stakeholders agree on the purpose of the new system.</ess:description>
    <ess:description xml:lang="nl">De stakeholders zijn het eens over het doel van het nieuwe systeem.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable_6">
    <ess:description xml:lang="en">It is clear that the pursuit of the opportunity is viable.</ess:description>
    <ess:description xml:lang="nl">Het is duidelijk dat het nastreven van de kans haalbaar is.</ess:description>
    <ess:name>6</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected_2">
    <ess:description xml:lang="en">The architecture's key concepts and properties are clearly defined.</ess:description>
    <ess:description xml:lang="nl">De belangrijkste concepten en eigenschappen van de architectuur zijn duidelijk vastgelegd.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#System_Retired_2">
    <ess:description xml:lang="en">The system is no longer supported.</ess:description>
    <ess:description xml:lang="nl">Het systeem wordt niet langer ondersteund.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_1">
        <ess:description xml:lang="en">The requirements are captured and shared with the team and the stakeholders.</ess:description>
        <ess:description xml:lang="nl">De requirements zijn vastgelegd en gedeeld met het team en de stakeholders.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_2"/>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_3">
        <ess:description xml:lang="en">The rationale behind the requirements is clear.</ess:description>
        <ess:description xml:lang="nl">De onderbouwing achter de requirements is duidelijk.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_4">
        <ess:description xml:lang="en">Conflicting requirements are identified and attended to.</ess:description>
        <ess:description xml:lang="nl">Tegenstrijdige requirements zijn geïdentificeerd en opgepakt.</ess:description>
        <ess:name>4</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_5"/>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_6">
        <ess:description xml:lang="en">The most important usage scenarios for the system can be explained.</ess:description>
        <ess:description xml:lang="nl">De belangrijkste gebruiksscenario's voor het systeem kunnen worden toegelicht.</ess:description>
        <ess:name>6</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_7">
        <ess:description xml:lang="en">The priority of the requirements is clear.</ess:description>
        <ess:description xml:lang="nl">De prioriteit van de requirements is duidelijk.</ess:description>
        <ess:name>7</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_8">
        <ess:description xml:lang="en">The impact of implementing the requirements is understood.</ess:description>
        <ess:description xml:lang="nl">De impact van het implementeren van de requirements is begrepen.</ess:description>
        <ess:name>8</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent_9">
        <ess:description xml:lang="en">The team understands what has to be delivered and agrees to deliver it.</ess:description>
        <ess:description xml:lang="nl">Het team begrijpt wat er opgeleverd moet worden en stemt ermee in dit te leveren.</ess:description>
        <ess:name>9</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="en">The requirements provide a consistent description of the essential characteristics of the new system.</ess:description>
    <ess:description xml:lang="nl">De requirements geven een samenhangende beschrijving van de essentiële kenmerken van het nieuwe systeem.</ess:description>
    <ess:name>Coherent</ess:name>
    <ess:successor>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable_4"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable_5"/>
        <ess:description xml:lang="en">The requirements describe a system that is acceptable to the stakeholders.</ess:description>
        <ess:description xml:lang="nl">De requirements beschrijven een systeem dat acceptabel is voor de stakeholders.</ess:description>
        <ess:name>Acceptable</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Addressed"/>
      </ess:State>
    </ess:successor>
  </ess:State>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell_4">
    <ess:description xml:lang="en">The team continually tunes their use of the practices and tools.</ess:description>
    <ess:description xml:lang="nl">Het team stemt het gebruik van practices en hulpmiddelen voortdurend bij.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#PreparetodotheWork_CC_2">
    <ess:description xml:lang="en">Way-of-Working::Foundation Established</ess:description>
    <ess:description xml:lang="nl">Way-of-Working::Fundament gelegd</ess:description>
    <ess:state>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_FoundationEstablished">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_FoundationEstablished_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_FoundationEstablished_2"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_FoundationEstablished_3"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_FoundationEstablished_4"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_FoundationEstablished_5"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_FoundationEstablished_6"/>
        <ess:description xml:lang="en">The key practices, and tools, that form the foundation of the way of working are selected and ready for use.</ess:description>
        <ess:description xml:lang="nl">De belangrijkste practices en hulpmiddelen die de basis vormen van de werkwijze zijn gekozen en gereed voor gebruik.</ess:description>
        <ess:name>Foundation Established</ess:name>
        <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InUse"/>
      </ess:State>
    </ess:state>
  </ess:CompletionCriterion>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#UsetheSystem_CC_2">
    <ess:description xml:lang="en">Opportunity::Benefit Accrued</ess:description>
    <ess:description xml:lang="nl">Opportunity::Baten gerealiseerd</ess:description>
    <ess:state>
      <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_BenefitAccrued">
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_BenefitAccrued_1"/>
        <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_BenefitAccrued_2"/>
        <ess:description xml:lang="en">The operational use or sale of the solution is creating tangible benefits.</ess:description>
        <ess:description xml:lang="nl">Het operationele gebruik of de verkoop van de oplossing levert tastbare baten op.</ess:description>
        <ess:name>Benefit Accrued</ess:name>
      </ess:State>
    </ess:state>
  </ess:CompletionCriterion>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#CoordinateActivity_CC_1">
    <ess:description xml:lang="en">Team::Formed</ess:description>
    <ess:description xml:lang="nl">Team::Gevormd</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team_Formed"/>
  </ess:CompletionCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Conceived_2">
    <ess:description xml:lang="en">The stakeholders that will use the new system are identified.</ess:description>
    <ess:description xml:lang="nl">De stakeholders die het nieuwe systeem zullen gebruiken zijn geïdentificeerd.</ess:description>
    <ess:name>2</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Initiated_4">
    <ess:description xml:lang="en">The initiator of the work is clearly identified.</ess:description>
    <ess:description xml:lang="nl">De initiatiefnemer van het werk is duidelijk geïdentificeerd.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_InUse_3">
    <ess:description xml:lang="en">The practices and tools are being adapted to the team's context.</ess:description>
    <ess:description xml:lang="nl">De practices en hulpmiddelen worden aangepast aan de context van het team.</ess:description>
    <ess:name>3</ess:name>
  </ess:Checkpoint>
  <ess:CompletionCriterion rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#TrackProgress_CC_2">
    <ess:description xml:lang="en">Way-of-Working::Working Well</ess:description>
    <ess:description xml:lang="nl">Way-of-Working::Werkt goed</ess:description>
    <ess:state rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_WorkingWell"/>
  </ess:CompletionCriterion>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded_4">
    <ess:description xml:lang="en">It has been confirmed that a system-based solution is needed.</ess:description>
    <ess:description xml:lang="nl">Er is bevestigd dat een systeemgebaseerde oplossing nodig is.</ess:description>
    <ess:name>4</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking_PrinciplesEstablished_5">
    <ess:description xml:lang="en">The context within which the team will operate is understood.</ess:description>
    <ess:description xml:lang="nl">De context waarbinnen het team zal opereren is begrepen.</ess:description>
    <ess:name>5</ess:name>
  </ess:Checkpoint>
  <ess:State rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Bounded">
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Bounded_1">
        <ess:description xml:lang="en">The stakeholders involved in developing the new system are identified.</ess:description>
        <ess:description xml:lang="nl">De stakeholders die betrokken zijn bij het ontwikkelen van het nieuwe systeem zijn geïdentificeerd.</ess:description>
        <ess:name>1</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Bounded_2"/>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Bounded_3">
        <ess:description xml:lang="en">It is clear what success is for the new system.</ess:description>
        <ess:description xml:lang="nl">Het is duidelijk wat succes is voor het nieuwe systeem.</ess:description>
        <ess:name>3</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Bounded_4">
        <ess:description xml:lang="en">The stakeholders have a shared understanding of the extent of the proposed solution.</ess:description>
        <ess:description xml:lang="nl">De stakeholders hebben een gedeeld begrip van de omvang van de voorgestelde oplossing.</ess:description>
        <ess:name>4</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Bounded_5">
        <ess:description xml:lang="en">The way the requirements will be described is agreed upon.</ess:description>
        <ess:description xml:lang="nl">De manier waarop de requirements worden beschreven is overeengekomen.</ess:description>
        <ess:name>5</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Bounded_6">
        <ess:description xml:lang="en">The mechanisms for managing the requirements are in place.</ess:description>
        <ess:description xml:lang="nl">De mechanismen voor het beheren van de requirements zijn ingericht.</ess:description>
        <ess:name>6</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Bounded_7">
        <ess:description xml:lang="en">The prioritization scheme is clear.</ess:description>
        <ess:description xml:lang="nl">Het prioriteringsschema is duidelijk.</ess:description>
        <ess:name>7</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Bounded_8">
        <ess:description xml:lang="en">Constraints are identified and considered.</ess:description>
        <ess:description xml:lang="nl">Randvoorwaarden zijn geïdentificeerd en meegewogen.</ess:description>
        <ess:name>8</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:checkListItem>
      <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Bounded_9">
        <ess:description xml:lang="en">Assumptions are clearly stated.</ess:description>
        <ess:description xml:lang="nl">Aannames zijn duidelijk vastgelegd.</ess:description>
        <ess:name>9</ess:name>
      </ess:Checkpoint>
    </ess:checkListItem>
    <ess:description xml:lang="en">The purpose and extent of the new system are clear.</ess:description>
    <ess:description xml:lang="nl">Het doel en de omvang van het nieuwe systeem zijn duidelijk.</ess:description>
    <ess:name>Bounded</ess:name>
    <ess:successor rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent"/>
  </ess:State>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed_5">
    <ess:description xml:lang="en">The team has been released.</ess:description>
    <ess:description xml:lang="nl">Het team is vrijgegeven.</ess:description>
    <ess:name>5</ess:name>
  </ess:Checkpoint>
  <ess:Checkpoint rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Work_Closed_3">
    <ess:description xml:lang="en">Everything has been archived.</ess:description>
