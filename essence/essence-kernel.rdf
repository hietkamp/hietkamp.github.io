<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:ess="https://www.hietkamp.nl/ontologies/essence-language#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel">
    <rdfs:label xml:lang="en">Essence Kernel (RDF data)</rdfs:label>
    <dcterms:source>OMG document ptc/25-05-01, Kernel and Language for Engineering Methods (Essence), v2.0 beta 2</dcterms:source>
    <rdfs:comment xml:lang="en">The Essence Kernel (clause 8 of OMG Essence v2.0 beta 2) expressed as plain RDF instance data in the vocabulary of the Essence language ontology (https://www.hietkamp.nl/ontologies/essence-language). Not an OWL ontology: the kernel is a model written IN the Essence language, not an extension OF it.</rdfs:comment>
    <dcterms:conformsTo rdf:resource="https://www.hietkamp.nl/ontologies/essence-language"/>
  </rdf:Description>
  <ess:Kernel rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#EssenceKernel">
    <ess:briefDescription>The Essence Kernel: the alphas, activity spaces and competencies that form a common ground for software/system engineering endeavors (OMG Essence v2.0 beta 2, clause 8).</ess:briefDescription>
    <ess:name>Essence Kernel</ess:name>
    <ess:ownedElements>
      <ess:Competency rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Analysis">
        <ess:briefDescription>The ability to understand opportunities and their related stakeholder needs, and transform them into an agreed and consistent set of requirements; includes providing input to decisions during system design.</ess:briefDescription>
        <ess:name>Analysis</ess:name>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Adapts"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Applies"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Assists"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Innovates"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Masters"/>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SolutionAreaOfConcern"/>
      </ess:Competency>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#CoordinateActivity">
        <ess:briefDescription>Co-ordinate and direct the team's work, including all ongoing planning and re-planning of the work.</ess:briefDescription>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#CoordinateActivity_CC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#CoordinateActivity_CC_2"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#CoordinateActivity_EC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#CoordinateActivity_EC_2"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work"/>
        <ess:name>Coordinate Activity</ess:name>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EndeavorAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:Tag rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#CustomerAreaOfConcern">
        <ess:value>Customer area of concern</ess:value>
      </ess:Tag>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#DeploytheSystem">
        <ess:briefDescription>Take the tested system and make it available for use outside the development team.</ess:briefDescription>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#DeploytheSystem_CC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#DeploytheSystem_EC_1"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking"/>
        <ess:name>Deploy the System</ess:name>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SolutionAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:Competency rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Development">
        <ess:briefDescription>The ability to design and produce effective systems following the standards and norms agreed by the team.</ess:briefDescription>
        <ess:name>Development</ess:name>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Adapts"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Applies"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Assists"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Innovates"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Masters"/>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SolutionAreaOfConcern"/>
      </ess:Competency>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:Tag rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#EndeavorAreaOfConcern">
        <ess:value>Endeavor area of concern</ess:value>
      </ess:Tag>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#EnsureStakeholderSatisfaction">
        <ess:briefDescription>Share the results of the development work with the stakeholders to gain their acceptance of the system produced and verify that the opportunity has been successfully addressed.</ess:briefDescription>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EnsureStakeholderSatisfaction_CC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EnsureStakeholderSatisfaction_CC_2"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EnsureStakeholderSatisfaction_EC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EnsureStakeholderSatisfaction_EC_2"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System"/>
        <ess:name>Ensure Stakeholder Satisfaction</ess:name>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#CustomerAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#ExplorePossibilities">
        <ess:briefDescription>Explore the possibilities presented by the creation of a new or improved system, including analysis of the opportunity and identification of the stakeholders.</ess:briefDescription>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#ExplorePossibilities_CC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#ExplorePossibilities_CC_2"/>
        <ess:name>Explore Possibilities</ess:name>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#CustomerAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#ImplementtheSystem">
        <ess:briefDescription>Build a system by implementing, testing, and integrating one or more system elements, including defect fixing and system element testing.</ess:briefDescription>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#ImplementtheSystem_CC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#ImplementtheSystem_EC_1"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking"/>
        <ess:name>Implement the System</ess:name>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SolutionAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:Competency rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Leadership">
        <ess:briefDescription>The ability to inspire and motivate a group of people to achieve a successful conclusion to their work and to meet their objectives.</ess:briefDescription>
        <ess:name>Leadership</ess:name>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Adapts"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Applies"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Assists"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Innovates"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Masters"/>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EndeavorAreaOfConcern"/>
      </ess:Competency>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:Competency rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Management">
        <ess:briefDescription>The ability to coordinate, plan, and track the work done by a team.</ess:briefDescription>
        <ess:name>Management</ess:name>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Adapts"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Applies"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Assists"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Innovates"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Masters"/>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EndeavorAreaOfConcern"/>
      </ess:Competency>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#OperatetheSystem">
        <ess:briefDescription>Support the use of the system in the live environment.</ess:briefDescription>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#OperatetheSystem_CC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#OperatetheSystem_EC_1"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking"/>
        <ess:name>Operate the System</ess:name>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SolutionAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:Alpha rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity">
        <ess:briefDescription>The set of circumstances that makes it appropriate to develop or change a system.</ess:briefDescription>
        <ess:name>Opportunity</ess:name>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Addressed"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_BenefitAccrued"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Identified"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_ValueEstablished"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_Viable"/>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#CustomerAreaOfConcern"/>
      </ess:Alpha>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:AlphaAssociation rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_focuses_Requirements">
        <ess:description>Opportunity focuses Requirements.</ess:description>
        <ess:end1 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity"/>
        <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements"/>
        <ess:name>focuses</ess:name>
      </ess:AlphaAssociation>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#PreparetodotheWork">
        <ess:briefDescription>Set up the team and its working environment; understand and commit to completing the work.</ess:briefDescription>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#PreparetodotheWork_CC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#PreparetodotheWork_CC_2"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#PreparetodotheWork_CC_3"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders"/>
        <ess:name>Prepare to do the Work</ess:name>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EndeavorAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:Alpha rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements">
        <ess:briefDescription>What the system must do to address the opportunity and satisfy the stakeholders.</ess:briefDescription>
        <ess:name>Requirements</ess:name>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Acceptable"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Addressed"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Bounded"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Coherent"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Conceived"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_Fulfilled"/>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SolutionAreaOfConcern"/>
      </ess:Alpha>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:AlphaAssociation rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements_scopesandconstrains_Work">
        <ess:description>Requirements scopes and constrains Work.</ess:description>
        <ess:end1 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements"/>
        <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work"/>
        <ess:name>scopes and constrains</ess:name>
      </ess:AlphaAssociation>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#ShapetheSystem">
        <ess:briefDescription>Shape the system so that it is easy to develop, change and maintain, and can cope with current and expected future demands; includes overall design and architecting.</ess:briefDescription>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#ShapetheSystem_CC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#ShapetheSystem_CC_2"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#ShapetheSystem_EC_1"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work"/>
        <ess:name>Shape the System</ess:name>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SolutionAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:Tag rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#SolutionAreaOfConcern">
        <ess:value>Solution area of concern</ess:value>
      </ess:Tag>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:Competency rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#StakeholderRepresentation">
        <ess:briefDescription>The ability to gather, communicate, and balance the needs of other stakeholders, and accurately represent their views.</ess:briefDescription>
        <ess:name>Stakeholder Representation</ess:name>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Adapts"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Applies"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Assists"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Innovates"/>
        <ess:possibleLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Masters"/>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#CustomerAreaOfConcern"/>
      </ess:Competency>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:Alpha rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders">
        <ess:briefDescription>The people, groups, or organizations who affect or are affected by a system.</ess:briefDescription>
        <ess:name>Stakeholders</ess:name>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_InAgreement"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Involved"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Recognized"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_Represented"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_SatisfiedforDeployment"/>
        <ess:states rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_SatisfiedinUse"/>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#CustomerAreaOfConcern"/>
      </ess:Alpha>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:AlphaAssociation rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_demand_Requirements">
        <ess:description>Stakeholders demand Requirements.</ess:description>
        <ess:end1 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders"/>
        <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements"/>
        <ess:name>demand</ess:name>
      </ess:AlphaAssociation>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:AlphaAssociation rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_provide_Opportunity">
        <ess:description>Stakeholders provide Opportunity.</ess:description>
        <ess:end1 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders"/>
        <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity"/>
        <ess:name>provide</ess:name>
      </ess:AlphaAssociation>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:AlphaAssociation rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_support_Team">
        <ess:description>Stakeholders support Team.</ess:description>
        <ess:end1 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders"/>
        <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team"/>
        <ess:name>support</ess:name>
      </ess:AlphaAssociation>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:AlphaAssociation rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders_useandconsume_System">
        <ess:description>Stakeholders use and consume System.</ess:description>
        <ess:end1 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Stakeholders"/>
        <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System"/>
        <ess:name>use and consume</ess:name>
      </ess:AlphaAssociation>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#StoptheWork">
        <ess:briefDescription>Shut down the engineering endeavor and hand over the team's responsibilities.</ess:briefDescription>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#StoptheWork_CC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#StoptheWork_CC_2"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#StoptheWork_CC_3"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#StoptheWork_EC_1"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#StoptheWork_EC_2"/>
        <ess:criterion rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#StoptheWork_EC_3"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Requirements"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Team"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#WayofWorking"/>
        <ess:input rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Work"/>
        <ess:name>Stop the Work</ess:name>
        <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EndeavorAreaOfConcern"/>
      </ess:ActivitySpace>
    </ess:ownedElements>
    <ess:ownedElements>
      <ess:ActivitySpace rdf:about="https://www.hietkamp.nl/ontologies/essence-kernel#SupporttheTeam">
        <ess:briefDescription>Help the team members to help themselves, collaborate, and improve their way of working.</ess:briefDescription>
