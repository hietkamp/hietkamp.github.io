    <ess:ownedElements rdf:resource="pattern/portfolio/gate-bruikbaar"/>
    <ess:ownedElements rdf:resource="pattern/portfolio/gate-gevestigd"/>
    <ess:ownedElements rdf:resource="activity-association/portfolio/enterprise-envision/end-before-start/governance-govern-delivery"/>
