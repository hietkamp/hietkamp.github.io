  <!-- ================= Gate 1 — Solution Needed ================= -->
  <ess:Pattern rdf:about="pattern/project-lifecycle/gate-1-gericht">
    <ess:name xml:lang="nl">Gate 1 — Solution Needed</ess:name>
    <ess:briefDescription xml:lang="nl">Deze gate is gehaald als: de stakeholders bij de opportunity en de voorgestelde oplossing zijn geïdentificeerd; hun onderliggende behoeften zijn vastgesteld; eventuele onderliggende problemen en hun oorzaken zijn geïdentificeerd; is bevestigd dat een systeemgebaseerde oplossing nodig is; en er minstens één systeemgebaseerde oplossing is voorgesteld.</ess:briefDescription>
    <ess:description xml:lang="nl">Deze gate is gehaald als: de stakeholders bij de opportunity en de voorgestelde oplossing zijn geïdentificeerd; hun onderliggende behoeften zijn vastgesteld; eventuele onderliggende problemen en hun oorzaken zijn geïdentificeerd; is bevestigd dat een systeemgebaseerde oplossing nodig is; en er minstens één systeemgebaseerde oplossing is voorgesteld.</ess:description>
   <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:associations rdf:resource="pattern-association/project-lifecycle/gate-1-gericht/aligns"/>
  </ess:Pattern>

  <ess:PatternAssociation rdf:about="pattern-association/project-lifecycle/gate-1-gericht/aligns">
    <ess:name xml:lang="nl">sluit aan op</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:elements rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Opportunity_SolutionNeeded"/>
    <ess:elements rdf:resource="activity/governance-govern-delivery"/>
  </ess:PatternAssociation>


  <!-- ================= Gate 2 — Architecture Selected ================= -->
  <ess:Pattern rdf:about="pattern/project-lifecycle/gate-2-omschreven">
    <ess:name xml:lang="nl">Gate 2 — Architecture Selected</ess:name>
    <ess:briefDescription xml:lang="nl">Deze gate is gehaald als: de criteria voor het selecteren van de architectuur zijn overeengekomen; de kernconcepten en eigenschappen van de architectuur zijn helder gedefinieerd; de gekozen architectuur is duidelijk doordacht; de systeemgrens is bekend; belangrijke beslissingen over de opbouw van het systeem zijn genomen; buy/build/reuse-beslissingen zijn gemaakt; en de belangrijkste technische risico's zijn onderkend en geaccepteerd.</ess:briefDescription>
    <ess:description xml:lang="nl">Deze gate is gehaald als: de criteria voor het selecteren van de architectuur zijn overeengekomen; de kernconcepten en eigenschappen van de architectuur zijn helder gedefinieerd; de gekozen architectuur is duidelijk doordacht; de systeemgrens is bekend; belangrijke beslissingen over de opbouw van het systeem zijn genomen; buy/build/reuse-beslissingen zijn gemaakt; en de belangrijkste technische risico's zijn onderkend en geaccepteerd.</ess:description>
   <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:associations rdf:resource="pattern-association/project-lifecycle/gate-2-omschreven/aligns"/>
  </ess:Pattern>

  <ess:PatternAssociation rdf:about="pattern-association/project-lifecycle/gate-2-omschreven/aligns">
    <ess:name xml:lang="nl">sluit aan op</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:elements rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_ArchitectureSelected"/>
    <ess:elements rdf:resource="activity/governance-govern-delivery"/>
  </ess:PatternAssociation>


  <!-- ================= Gate 3 — System Usable (closes Phase 3 + Phase 4 jointly) ================= -->
  <ess:Pattern rdf:about="pattern/project-lifecycle/gate-3-bewezen">
    <ess:name xml:lang="nl">Gate 3 — System Usable</ess:name>
    <ess:briefDescription xml:lang="nl">Deze gate is gehaald als: de belangrijkste architectuurkenmerken zijn aangetoond; het systeem kan worden bevraagd en de prestaties kunnen worden gemeten; kritieke configuraties en interfaces van de architectuur zijn gedemonstreerd; de integratie met bestaande systemen is aangetoond; en de relevante stakeholders zijn het erover eens dat de gedemonstreerde architectuur passend is (Demonstrable) — én aanvullend: het systeem kan door de gebruikersstakeholders zelf worden bediend; de geboden functionaliteit is getest; de prestaties en het aantal defecten zijn acceptabel voor de stakeholders; het systeem is voldoende gedocumenteerd; de opgeleverde systeemonderdelen zijn bekend; en de toegevoegde waarde van het systeem is duidelijk (Usable).</ess:briefDescription>
    <ess:description xml:lang="nl">Deze gate is gehaald als: de belangrijkste architectuurkenmerken zijn aangetoond; het systeem kan worden bevraagd en de prestaties kunnen worden gemeten; kritieke configuraties en interfaces van de architectuur zijn gedemonstreerd; de integratie met bestaande systemen is aangetoond; en de relevante stakeholders zijn het erover eens dat de gedemonstreerde architectuur passend is (Demonstrable) — én aanvullend: het systeem kan door de gebruikersstakeholders zelf worden bediend; de geboden functionaliteit is getest; de prestaties en het aantal defecten zijn acceptabel voor de stakeholders; het systeem is voldoende gedocumenteerd; de opgeleverde systeemonderdelen zijn bekend; en de toegevoegde waarde van het systeem is duidelijk (Usable).</ess:description>
   <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:associations rdf:resource="pattern-association/project-lifecycle/gate-3-bewezen/aligns"/>
  </ess:Pattern>

  <ess:PatternAssociation rdf:about="pattern-association/project-lifecycle/gate-3-bewezen/aligns">
    <ess:name xml:lang="nl">sluit aan op</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:elements rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Usable"/>
    <ess:elements rdf:resource="activity/governance-govern-delivery"/>
  </ess:PatternAssociation>


  <!-- ================= Gate 4 — System Ready ================= -->
  <ess:Pattern rdf:about="pattern/project-lifecycle/gate-4-bruikbaar">
    <ess:name xml:lang="nl">Gate 4 — System Ready</ess:name>
    <ess:briefDescription xml:lang="nl">Deze gate is gehaald als: documentatie over het inzetten en gebruiken van het systeem in de beoogde omgeving beschikbaar is; de stakeholder-vertegenwoordigers het systeem accepteren als geschikt voor het doel; zij het systeem daadwerkelijk beschikbaar willen maken voor gebruik; en de operationele ondersteuning is ingericht.</ess:briefDescription>
    <ess:description xml:lang="nl">Deze gate is gehaald als: documentatie over het inzetten en gebruiken van het systeem in de beoogde omgeving beschikbaar is; de stakeholder-vertegenwoordigers het systeem accepteren als geschikt voor het doel; zij het systeem daadwerkelijk beschikbaar willen maken voor gebruik; en de operationele ondersteuning is ingericht.</ess:description>
   <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:associations rdf:resource="pattern-association/project-lifecycle/gate-4-bruikbaar/aligns"/>
  </ess:Pattern>

  <ess:PatternAssociation rdf:about="pattern-association/project-lifecycle/gate-4-bruikbaar/aligns">
    <ess:name xml:lang="nl">sluit aan op</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:elements rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#System_Ready"/>
    <ess:elements rdf:resource="activity/governance-govern-delivery"/>
  </ess:PatternAssociation>


  <!-- ================= Gate 5 — System Operational ================= -->
  <ess:Pattern rdf:about="pattern/project-lifecycle/gate-5-gevestigd">
    <ess:name xml:lang="nl">Gate 5 — System Operational</ess:name>
    <ess:briefDescription xml:lang="nl">Deze gate is gehaald als: het systeem beschikbaar is gesteld aan de beoogde gebruikers; er minstens één instantie van het systeem volledig operationeel is; en het systeem volledig wordt ondersteund conform de afgesproken servicelevels.</ess:briefDescription>
    <ess:description xml:lang="nl">Deze gate is gehaald als: het systeem beschikbaar is gesteld aan de beoogde gebruikers; er minstens één instantie van het systeem volledig operationeel is; en het systeem volledig wordt ondersteund conform de afgesproken servicelevels.</ess:description>
  <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:associations rdf:resource="pattern-association/project-lifecycle/gate-5-gevestigd/aligns"/>
  </ess:Pattern>

