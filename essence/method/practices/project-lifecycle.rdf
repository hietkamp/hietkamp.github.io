    <ess:elements rdf:resource="activity/governance-govern-delivery"/>
  </ess:PatternAssociation>


  <!-- ================= Gate 4 — System Ready ================= -->
  <ess:Pattern rdf:about="pattern/project-lifecycle/gate-4-bruikbaar">
    <ess:name xml:lang="nl">Gate 4 — Systeem gereed</ess:name>
    <ess:briefDescription xml:lang="nl">Bijdrage geleverd zodra de conformance aan het low-level design is aangetoond voor het opgeleverde systeem als geheel. Afwijkingen worden beoordeeld via de architectuursturing.</ess:briefDescription>
    <ess:description xml:lang="nl">Bijdrage geleverd zodra de conformance aan het low-level design is aangetoond voor het opgeleverde systeem als geheel. Afwijkingen worden beoordeeld via de architectuursturing.</ess:description>
   <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:associations rdf:resource="pattern-association/project-lifecycle/gate-4-bruikbaar/aligns"/>
  </ess:Pattern>

  <ess:PatternAssociation rdf:about="pattern-association/project-lifecycle/gate-4-bruikbaar/aligns">
    <ess:name xml:lang="nl">sluit aan op</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
