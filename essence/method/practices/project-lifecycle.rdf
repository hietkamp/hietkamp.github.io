  <!-- ================= Gate 2 — Architecture Selected ================= -->
  <ess:Pattern rdf:about="pattern/project-lifecycle/gate-2-omschreven">
    <ess:name xml:lang="nl">Gate 2 — Architectuur gekozen</ess:name>
    <ess:briefDescription xml:lang="nl">Bijdrage geleverd zodra het low-level design de architectuur onderbouwd heeft vastgelegd, getoetst aan de architectuurbepalende eisen. Afwijkingen worden beoordeeld via de architectuursturing.</ess:briefDescription>
    <ess:description xml:lang="nl">Bijdrage geleverd zodra het low-level design de architectuur onderbouwd heeft vastgelegd, getoetst aan de architectuurbepalende eisen. Afwijkingen worden beoordeeld via de architectuursturing.</ess:description>
   <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:associations rdf:resource="pattern-association/project-lifecycle/gate-2-omschreven/aligns"/>
  </ess:Pattern>

