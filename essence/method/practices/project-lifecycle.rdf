  <!-- ================= Gate 3 — System Usable (closes Phase 3 + Phase 4 jointly) ================= -->
  <ess:Pattern rdf:about="pattern/project-lifecycle/gate-3-bewezen">
    <ess:name xml:lang="nl">Gate 3 — Systeem bruikbaar</ess:name>
    <ess:briefDescription xml:lang="nl">Bijdrage geleverd zodra de oplossing is gerealiseerd conform de vastgestelde architectuur, met elke afwijking vastgelegd als architectuurbeslissing of dispensatie. De architectuursturing beoordeelt deze afwijkingen.</ess:briefDescription>
    <ess:description xml:lang="nl">Bijdrage geleverd zodra de oplossing is gerealiseerd conform de vastgestelde architectuur, met elke afwijking vastgelegd als architectuurbeslissing of dispensatie. De architectuursturing beoordeelt deze afwijkingen.</ess:description>
   <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:associations rdf:resource="pattern-association/project-lifecycle/gate-3-bewezen/aligns"/>
  </ess:Pattern>

