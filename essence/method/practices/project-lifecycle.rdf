  <!-- ================= Gate 1 — Solution Needed ================= -->
  <ess:Pattern rdf:about="pattern/project-lifecycle/gate-1-gericht">
    <ess:name xml:lang="nl">Gate 1 — Uitdaging haalbaar</ess:name>
    <ess:briefDescription xml:lang="nl">Bijdrage geleverd zodra het high-level design is vastgesteld en stakeholders achter de gekozen richting staan. Afwijkingen van de guardrails worden beoordeeld via de architectuursturing.</ess:briefDescription>
    <ess:description xml:lang="nl">Bijdrage geleverd zodra het high-level design is vastgesteld en stakeholders achter de gekozen richting staan. Afwijkingen van de guardrails worden beoordeeld via de architectuursturing.</ess:description>
