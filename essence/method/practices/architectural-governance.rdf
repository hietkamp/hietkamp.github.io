  <ess:Practice rdf:about="practice/architectural-governance">
    <ess:name xml:lang="nl">Architectuursturing</ess:name>
    <ess:name xml:lang="en">Architectural Governance</ess:name>
    <ess:briefDescription xml:lang="nl">Architectuursturing</ess:briefDescription>
    <ess:description xml:lang="nl">Stuurt architectuurkwaliteit via guardrails en uitzonderingen — geen stage gates. Biedt governance-activiteiten, een governance-alpha en koppeling met de goedgekeurde route.</ess:description>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:objective>Stuurt architectuurkwaliteit via guardrails en uitzonderingen — geen stage gates. Biedt governance-activiteiten, een governance-alpha en koppeling met de goedgekeurde route.</ess:objective>
    <ess:measures/>
    <ess:entry/>
    <ess:result/>
    <ess:consistencyRules/>
    <ess:ownedElements rdf:resource="activity/governance-establish-governance"/>
    <ess:ownedElements rdf:resource="activity/governance-engage-cadence"/>
    <ess:ownedElements rdf:resource="activity/governance-govern-delivery"/>
    <ess:ownedElements rdf:resource="activity/governance-assure-evidence"/>
    <ess:ownedElements rdf:resource="activity/governance-tune-governance"/>
    <ess:ownedElements rdf:resource="workproduct/architecture-principles"/>
    <ess:ownedElements rdf:resource="workproduct/architecture-working-agreement"/>
    <ess:ownedElements rdf:resource="workproduct/architecture-repository"/>
    <ess:ownedElements rdf:resource="workproduct/conformance-evidence"/>
    <ess:ownedElements rdf:resource="workproduct/statement-of-architecture-work"/>
    <ess:associations rdf:resource="pattern-association/architectural-governance/performed-by"/>
  </ess:Practice>

