  <ess:Practice rdf:about="practice/enterprise-architecture">
    <ess:name xml:lang="nl">Enterprise architectuur</ess:name>
    <ess:briefDescription xml:lang="nl">Richt, kies en bouw de enterprise-architectuurkaders: drivers, richting, paved road en transitie.</ess:briefDescription>
    <ess:description xml:lang="nl">Stelt enterprise-brede architectuurkaders vast: identificeert business goals en drivers, bepaalt de architectuurrichting, maakt en beheert de paved road en plant de transitie op enterprise-niveau. Levert de kaders waarbinnen solution-architectuur opereert.</ess:description>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:objective>Stelt enterprise-brede architectuurkaders vast die elke solution erft.</ess:objective>
    <ess:measures/>
    <ess:entry xml:lang="nl">Een Opdrachtgever heeft de noodzaak voor enterprise-architectuurwerk erkend en opdracht gegeven; strategische doelen en business drivers zijn op hoofdlijnen bekend.</ess:entry>
    <ess:result/>
    <ess:consistencyRules/>
    <ess:ownedElements rdf:resource="activity/enterprise-understand"/>
    <ess:ownedElements rdf:resource="activity/enterprise-envision"/>
    <ess:ownedElements rdf:resource="activity/enterprise-design"/>
    <ess:ownedElements rdf:resource="activity/enterprise-build-paved-road"/>
    <ess:ownedElements rdf:resource="activity/enterprise-plan"/>
    <ess:ownedElements rdf:resource="activity/enterprise-learn-and-improve"/>
    <ess:ownedElements rdf:resource="workproduct/architecture-vision"/>
    <ess:ownedElements rdf:resource="workproduct/paved-road"/>
    <ess:ownedElements rdf:resource="workproduct/architecture-roadmap"/>
    <ess:associations rdf:resource="pattern-association/enterprise-architecture/performed-by"/>
  </ess:Practice>

  <ess:PatternAssociation rdf:about="pattern-association/enterprise-architecture/performed-by">
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:elements rdf:resource="role/enterprise-architect"/>
