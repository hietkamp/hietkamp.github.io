  <ess:ActivityAssociation rdf:about="activity-association/solution-lead-implementation/end-before-start/solution-monitor-performance">
    <ess:name>solution-lead-implementation end-before-start solution-monitor-performance</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
