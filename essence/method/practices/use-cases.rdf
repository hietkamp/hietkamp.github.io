    <ess:elements rdf:resource="activity/usecase-specify"/>
  </ess:PatternAssociation>

  <ess:PatternAssociation rdf:about="pattern-association/requirements-engineer/responsible-for">
    <ess:name xml:lang="nl">verantwoordelijk voor</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:elements rdf:resource="workproduct/use-casemodel"/>
