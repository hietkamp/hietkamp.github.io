<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
  xml:base="https://hietkamp.nl/essence/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:ess="https://www.hietkamp.nl/ontologies/essence-language#"
>

  <ess:Pattern rdf:about="pattern/c4-archimate-viewpoints">
    <ess:name xml:lang="nl">C4-ArchiMate-weergaven</ess:name>
    <ess:briefDescription xml:lang="nl">Gebruik C4-niveaus om de informatiedichtheid van architectuurweergaven te sturen en map de elementen expliciet naar ArchiMate-lagen.</ess:briefDescription>
    <ess:description xml:lang="nl"><![CDATA[<p>C4 is goed leesbaar voor teams, ArchiMate is de formele taal van de architectuurrepository — maar zonder een expliciete koppeling tussen beide ontstaan al snel twee losse modelwerelden die uit elkaar gaan lopen.</p>
<p>Dit patroon lost dat op door per werkproduct, van Architecture Vision tot Architecture Definition op enterprise-, solution- en componentniveau, het juiste C4-niveau te kiezen voor de informatiedichtheid van de weergave, en per elementtype vast te leggen welk ArchiMate-element of stereotype daarbij hoort.</p>
<p>Zo krijgen teams begrijpelijke diagrammen om mee te werken, terwijl de architectuurrepository en governance dezelfde onderliggende semantiek behouden.</p>]]></ess:description>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:associations rdf:resource="pattern-association/c4-archimate-viewpoints/uses"/>
    <ess:associations rdf:resource="pattern-association/c4-archimate-viewpoints/related-workproducts"/>
    <ess:tags rdf:resource="tag/c4"/>
    <ess:tags rdf:resource="tag/archimate"/>
  </ess:Pattern>

  <ess:Tag rdf:about="tag/c4">
    <ess:value>C4</ess:value>
  </ess:Tag>

  <ess:Tag rdf:about="tag/archimate">
