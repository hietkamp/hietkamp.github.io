    <ess:elements rdf:resource="activity/solution-low-level-design"/>
  </ess:PatternAssociation>

  <ess:PatternAssociation rdf:about="pattern-association/c4-archimate-viewpoints/related-workproducts">
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
