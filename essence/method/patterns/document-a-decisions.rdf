<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
  xml:base="https://hietkamp.nl/essence/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:ess="https://www.hietkamp.nl/ontologies/essence-language#"
>

  <ess:Pattern rdf:about="pattern/document-a-decisions">
    <ess:name xml:lang="nl">ADR-gedreven besluitvorming</ess:name>
    <ess:briefDescription xml:lang="nl">Leg elke significante architectuurkeuze vast als een klein, traceerbaar beslissingsrecord met context, opties, keuze, rationale en consequenties.</ess:briefDescription>
    <ess:description xml:lang="nl"><![CDATA[<p>Belangrijke architectuurbeslissingen — over COTS-keuzes, integraties, platforms of afwijkingen van de paved road — worden vaak genomen in overleggen of vendorselecties. Zodra het overleg voorbij is, verdwijnt meestal ook de rationale: waarom is voor deze optie gekozen, en welke alternatieven zijn afgewogen?</p>
<p>ADR-gedreven besluitvorming behandelt de Architecture Decision Record (ADR) als de minimale eenheid van architectuurbesluitvorming: een klein, traceerbaar record met context, overwogen opties, de gemaakte keuze, de rationale erachter en de consequenties. Elke significante keuze wordt op deze manier vastgelegd en gekoppeld aan de drivers, architectuurbepalende eisen, reviewrecords en architectuurweergaven waar hij bij hoort.</p>
<p>Zo blijven beslissingen toetsbaar, ook lang nadat de discussie is verstomd, en kunnen ze later worden gevalideerd, vervangen of herzien zonder dat de oorspronkelijke overwegingen verloren gaan.</p>]]></ess:description>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:associations rdf:resource="pattern-association/document-a-decisions/uses"/>
    <ess:associations rdf:resource="pattern-association/document-a-decisions/related-workproducts"/>
    <ess:tags rdf:resource="tag/mva"/>
    <ess:tags rdf:resource="tag/decision"/>
  </ess:Pattern>

  <ess:Tag rdf:about="tag/mva">
    <ess:value>MVA</ess:value>
  </ess:Tag>

  <ess:Tag rdf:about="tag/decision">
    <ess:value>Decision</ess:value>
  </ess:Tag>

  <ess:PatternAssociation rdf:about="pattern-association/document-a-decisions/uses">
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:elements rdf:resource="activity/enterprise-design"/>
    <ess:elements rdf:resource="activity/solution-design"/>
  </ess:PatternAssociation>

  <ess:PatternAssociation rdf:about="pattern-association/document-a-decisions/related-workproducts">
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:elements rdf:resource="workproduct/architecture-decisions"/>
  </ess:PatternAssociation>

</rdf:RDF>
