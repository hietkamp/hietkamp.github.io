<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
  xml:base="https://hietkamp.nl/essence/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:ess="https://www.hietkamp.nl/ontologies/essence-language#"
>

  <ess:Pattern rdf:about="pattern/on-road-off-road">
    <ess:name xml:lang="nl">On-road/off-road governance</ess:name>
    <ess:name xml:lang="en">On-road/off-road Governance</ess:name>
    <ess:briefDescription xml:lang="nl">Laat standaardkeuzes vrij stromen en review alleen afwijkingen, significante onomkeerbare beslissingen en uitzonderingen.</ess:briefDescription>
    <ess:description xml:lang="nl"><![CDATA[<p>Laat standaardkeuzes vrij stromen en review alleen afwijkingen, significante onomkeerbare beslissingen en uitzonderingen.</p>
<p><strong>Doel:</strong> Houd governance licht zonder architectuurcontrole te verliezen.</p>
<p><strong>Context:</strong> Organisaties met een paved road, meerdere teams en beperkte architectuurcapaciteit.</p>
<p><strong>Probleem:</strong> Stage gates vertragen teams, terwijl volledig vrije keuzes leiden tot versnippering en verborgen risico.</p>
<p><strong>Oplossing:</strong> Definieer on-road keuzes als zelfbediening. Leg off-road keuzes vast via ADR en beoordeel ze via Review Record of Exception Request.</p>
<p><strong>Resultaat:</strong> Architectuursturing focust op uitzonderingen en bewijs, niet op papierwerk.</p>]]></ess:description>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:associations rdf:resource="pattern-association/on-road-off-road/uses"/>
    <ess:associations rdf:resource="pattern-association/on-road-off-road/related-workproducts"/>
    <ess:tags rdf:resource="tag/mvg"/>
    <ess:tags rdf:resource="tag/governance"/>
  </ess:Pattern>

  <ess:Tag rdf:about="tag/mvg">
    <ess:value>MVG</ess:value>
  </ess:Tag>

  <ess:Tag rdf:about="tag/governance">
    <ess:value>Governance</ess:value>
  </ess:Tag>

  <ess:PatternAssociation rdf:about="pattern-association/on-road-off-road/uses">
