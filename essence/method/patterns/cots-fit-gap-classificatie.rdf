    <ess:name xml:lang="en">uses</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:elements rdf:resource="activity/enterprise-plan"/>
    <ess:elements rdf:resource="activity/solution-develop-roadmap"/>
  </ess:PatternAssociation>

  <ess:PatternAssociation rdf:about="pattern-association/cots-fit-gap-classificatie/related-workproducts">
    <ess:name xml:lang="en">related-workproducts</ess:name>
