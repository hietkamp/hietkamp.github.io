  <ess:Alpha rdf:about="alpha/governance">
    <ess:name xml:lang="nl">Governance</ess:name>
    <ess:name xml:lang="en">Governance</ess:name>
    <ess:briefDescription/>
    <ess:description xml:lang="nl">Het systeem van guardrails, beslissingsrechten en ritmes dat architectuurkwaliteit stuurt zonder stage gates. Beslissingen stromen binnen guardrails; alleen uitzonderingen worden beoordeeld.</ess:description>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:owner rdf:resource="practice/architectural-governance"/>
    <ess:states rdf:resource="state/governance/initiated"/>
    <ess:states rdf:resource="state/governance/engaged"/>
    <ess:states rdf:resource="state/governance/guiding"/>
    <ess:states rdf:resource="state/governance/assured"/>
    <ess:states rdf:resource="state/governance/effective"/>
  </ess:Alpha>

