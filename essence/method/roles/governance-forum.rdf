<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
  xml:base="https://hietkamp.nl/essence/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:ess="https://www.hietkamp.nl/ontologies/essence-language#"
  xmlns:ewow="https://hietkamp.nl/essence/vocab#"
>

  <ess:Pattern rdf:about="role/governance-forum">
    <ess:name xml:lang="nl">Architectuurforum</ess:name>
    <ess:name xml:lang="en">Architecture Forum</ess:name>
    <ess:briefDescription xml:lang="nl">Een kleine, snelle, op principes gebaseerde instantie — een lean Architecture Board of gilde. Beoordeelt uitsluitend uitzonderingen en off-road ADRs. …</ess:briefDescription>
    <ess:description xml:lang="nl">Een kleine, snelle, op principes gebaseerde instantie — een lean Architecture Board of gilde. Beoordeelt uitsluitend uitzonderingen en off-road ADRs. Borgt uitkomsten, geen papierwerk. Vergadert alleen als er iets te beoordelen is.</ess:description>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:associations rdf:resource="pattern-association/governance-forum/requires-competency"/>
    <ess:associations rdf:resource="pattern-association/governance-forum/participates-in"/>
  </ess:Pattern>

  <ess:PatternAssociation rdf:about="pattern-association/governance-forum/requires-competency">
    <ess:name xml:lang="en">requires competency</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:elements rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Leadership"/>
    <ess:elements rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Management"/>
    <ess:elements rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Masters"/>
  </ess:PatternAssociation>

  <ess:PatternAssociation rdf:about="pattern-association/governance-forum/participates-in">
    <ess:name xml:lang="en">participates in</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:elements rdf:resource="activity/governance-assure-evidence"/>
    <ess:elements rdf:resource="activity/governance-govern-delivery"/>
    <ess:elements rdf:resource="activity/governance-tune-governance"/>
  </ess:PatternAssociation>

</rdf:RDF>
