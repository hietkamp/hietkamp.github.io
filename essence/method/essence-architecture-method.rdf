<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
  xml:base="https://hietkamp.nl/essence/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:ess="https://www.hietkamp.nl/ontologies/essence-language#"
>

  <ess:Method rdf:about="method/essence-architecture-method">
    <ess:name xml:lang="nl">Architectuurwerkwijze</ess:name>
    <ess:briefDescription xml:lang="nl">Stuur architectuurkeuzes, paved road-adoptie en governance voor implementaties op enterprise en solution niveau.</ess:briefDescription>
    <ess:description xml:lang="nl"><![CDATA[<p>Een gecomponeerde methode die het Essence-kernel combineert met de MVA- en MVG-praktijken voor enterprise architectuur in een standaardsoftware buy-and-configure context.</p>
<p>De methode bestaat uit zes practices: <strong>Enterprise architectuur</strong> (sturen van architectuurkeuzes op enterprise niveau), <strong>Use cases</strong> (vastleggen van de eisen aan het systeem rond het gebruik ervan), <strong>Solution architectuur</strong> (sturen van architectuurkeuzes op solution niveau), <strong>Architectuursturing</strong> (governance via guardrails en uitzonderingen), <strong>Verandermanagement levenscyclus</strong> (COEF-ritme waarmee een verandering onder architectuur wordt doorgevoerd en geadopteerd) en <strong>Watervalaanpak</strong> (sequentieel V-model voor project-specifieke solution-architectuur).</p>]]></ess:description>
    <ess:purpose xml:lang="nl">Stuur architectuurkeuzes, paved road-adoptie en governance voor implementaties op enterprise en solution niveau.</ess:purpose>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:baseKernel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EssenceKernel"/>
    <ess:ownedElements rdf:resource="practice/enterprise-architecture"/>
    <ess:ownedElements rdf:resource="practice/use-cases"/>
    <ess:ownedElements rdf:resource="practice/solution-architecture"/>
    <ess:ownedElements rdf:resource="practice/architectural-governance"/>
    <ess:ownedElements rdf:resource="practice/change-management-lifecycle"/>
    <ess:ownedElements rdf:resource="practice/project-lifecycle"/>
    <ess:ownedElements rdf:resource="resource/method/ea-alpha-assessment"/>
  </ess:Method>

  <ess:UserDefinedType rdf:about="type/template">
    <ess:name xml:lang="nl">Sjabloon</ess:name>
    <ess:constraint>Content must be a resolvable URL to a downloadable file.</ess:constraint>
  </ess:UserDefinedType>

  <!-- Essence kent geen Role-klasse: een rol is een Pattern dat competenties,
       activiteiten en werkproducten samenbrengt (Essence v2.0, §9.3.2.13).
       Dit type onderscheidt rolpatronen van fase- en gatepatronen. -->
  <ess:UserDefinedType rdf:about="type/role">
    <ess:name xml:lang="nl">Rol</ess:name>
    <ess:constraint>A role pattern associates required competencies, the activities it participates in, and the work products it is responsible for.</ess:constraint>
  </ess:UserDefinedType>

  <ess:TypedResource rdf:about="resource/method/ea-alpha-assessment">
    <ess:name xml:lang="nl">EA Alpha Assessment</ess:name>
    <ess:briefDescription xml:lang="nl">Zelfassessment-werkblad: vink per alpha — kernel en method-specifiek — de checklistitems af, en het dashboard berekent automatisch de huidige status, voortgang en volledigheid per Customer/Solution/Endeavor-domein.</ess:briefDescription>
    <ess:kind rdf:resource="type/template"/>
    <ess:content>downloads/EA_Alpha_Assessment.xlsx</ess:content>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
  </ess:TypedResource>

</rdf:RDF>
