    <ess:action rdf:resource="action/solution-lead-implementation/read/review-records"/>
    <ess:action rdf:resource="action/solution-lead-implementation/update-alpha/architecture"/>
    <ess:action rdf:resource="action/solution-lead-implementation/update-alpha/architecture-decisions"/>
    <ess:requiredCompetencyLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Masters"/>
    <ess:criterion rdf:resource="criterion/solution-lead-implementation/completion/architecture"/>
    <ess:criterion rdf:resource="criterion/solution-lead-implementation/completion/architecture-decisions"/>
