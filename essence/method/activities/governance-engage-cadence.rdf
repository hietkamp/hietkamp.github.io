  xmlns:ewow="https://hietkamp.nl/essence/vocab#"
>

  <ess:Activity rdf:about="activity/governance-engage-cadence">
    <ess:name xml:lang="nl">Ritme Inrichten</ess:name>
    <ess:name xml:lang="en">Engage the Cadence</ess:name>
    <ess:briefDescription xml:lang="nl">Zet een lean ritme op: korte, frequente synchronisatiemomenten tussen de Enterprise Architect, Architecture Owners en het Architectuurforum. Publiceer …</ess:briefDescription>
    <ess:description xml:lang="nl">Zet een lean ritme op: korte, frequente synchronisatiemomenten tussen de Enterprise Architect, Architecture Owners en het Architectuurforum. Publiceer de guardrails en de paved road zodat elk team ze kent en direct kan toepassen. Governance die niet bekend is, bestaat niet.</ess:description>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:owner rdf:resource="practice/architectural-governance"/>
    <ess:approach rdf:resource="approach/governance-engage-cadence/default"/>
    <ess:action rdf:resource="action/governance-engage-cadence/read/architecture-roadmap"/>
    <ess:action rdf:resource="action/governance-engage-cadence/read/paved-road"/>
    <ess:action rdf:resource="action/governance-engage-cadence/create/statement-of-architecture-work"/>
    <ess:action rdf:resource="action/governance-engage-cadence/update-alpha/governance"/>
    <ess:requiredCompetencyLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Masters"/>
    <ess:requiredCompetencyLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Masters"/>
    <ess:criterion rdf:resource="criterion/governance-engage-cadence/completion/governance"/>
    <ess:tags rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#EndeavorAreaOfConcern"/>
  </ess:Activity>

  <ess:Approach rdf:about="approach/governance-engage-cadence/default">
    <ess:name xml:lang="nl">Ritme Inrichten</ess:name>
    <ess:name xml:lang="en">Engage the Cadence</ess:name>
    <ess:briefDescription/>
    <ess:description xml:lang="nl">Zet een lean ritme op: korte, frequente synchronisatiemomenten tussen de Enterprise Architect, Architecture Owners en het Architectuurforum. Publiceer de guardrails en de paved road zodat elk team ze kent en direct kan toepassen. Governance die niet bekend is, bestaat niet.</ess:description>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
  </ess:Approach>

  <ess:Action rdf:about="action/governance-engage-cadence/read/architecture-roadmap">
    <ess:name>Read Architecture Roadmap</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:kind rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#read"/>
    <ess:workProduct rdf:resource="workproduct/architecture-roadmap"/>
  </ess:Action>

  <ess:Action rdf:about="action/governance-engage-cadence/read/paved-road">
    <ess:name>Read Paved Road</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:kind rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#read"/>
    <ess:workProduct rdf:resource="workproduct/paved-road"/>
  </ess:Action>

  <ess:Action rdf:about="action/governance-engage-cadence/create/statement-of-architecture-work">
    <ess:name>Create Statement Of Architecture Work</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:kind rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#create"/>
    <ess:workProduct rdf:resource="workproduct/statement-of-architecture-work"/>
  </ess:Action>

  <ess:Action rdf:about="action/governance-engage-cadence/update-alpha/governance">
    <ess:name>Update Governance</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:kind rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#update"/>
    <ess:alpha rdf:resource="alpha/governance"/>
  </ess:Action>

  <ess:ActivityAssociation rdf:about="activity-association/governance-engage-cadence/part-of/coordinate-activity">
    <ess:name>Engage the Cadence part-of Coordinate Activity</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:end1 rdf:resource="activity/governance-engage-cadence"/>
    <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#CoordinateActivity"/>
    <ess:associationKind>part-of</ess:associationKind>
  </ess:ActivityAssociation>

  <ess:CompletionCriterion rdf:about="criterion/governance-engage-cadence/completion/governance">
    <ess:name>Completion: Governance</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:state rdf:resource="state/governance/engaged"/>
  </ess:CompletionCriterion>

</rdf:RDF>
