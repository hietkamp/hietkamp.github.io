  xmlns:esk="https://www.hietkamp.nl/ontologies/essence-kernel#"
>

  <ess:Activity rdf:about="activity/governance-tune-governance">
    <ess:name xml:lang="nl">Governance Bijstellen</ess:name>
    <ess:name xml:lang="en">Tune the Governance</ess:name>
    <ess:briefDescription xml:lang="nl">Verwijder of verlicht continu elke governance die zijn bestaansreden heeft verloren. Actualiseer Architecture Principles wanneer de context verandert,…</ess:briefDescription>
    <ess:description xml:lang="nl">Verwijder of verlicht continu elke governance die zijn bestaansreden heeft verloren. Actualiseer Architecture Principles wanneer de context verandert, verbreed de paved road op basis van reviewinzichten.</ess:description>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:owner rdf:resource="practice/architectural-governance"/>
    <ess:approach rdf:resource="approach/governance-tune-governance/default"/>
    <ess:action rdf:resource="action/governance-tune-governance/create/architecture-principles"/>
    <ess:action rdf:resource="action/governance-tune-governance/create/architecture-working-agreement"/>
    <ess:action rdf:resource="action/governance-tune-governance/read/conformance-evidence"/>
    <ess:action rdf:resource="action/governance-tune-governance/read/review-records"/>
    <ess:action rdf:resource="action/governance-tune-governance/update-alpha/governance"/>
    <ess:requiredCompetencyLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Masters"/>
    <ess:requiredCompetencyLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Masters"/>
    <ess:criterion rdf:resource="criterion/governance-tune-governance/completion/governance"/>
  </ess:Activity>

  <ess:Approach rdf:about="approach/governance-tune-governance/default">
    <ess:name xml:lang="nl">Governance Bijstellen</ess:name>
    <ess:name xml:lang="en">Tune the Governance</ess:name>
    <ess:briefDescription/>
    <ess:description xml:lang="nl">Verwijder of verlicht continu elke governance die zijn bestaansreden heeft verloren. Actualiseer Architecture Principles wanneer de context verandert, verbreed de paved road op basis van reviewinzichten.</ess:description>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
  </ess:Approach>

  <ess:Action rdf:about="action/governance-tune-governance/create/architecture-principles">
    <ess:name>Create Architecture Principles</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:kind rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#create"/>
    <ess:workProduct rdf:resource="workproduct/architecture-principles"/>
  </ess:Action>

  <ess:Action rdf:about="action/governance-tune-governance/create/architecture-working-agreement">
    <ess:name>Create Architecture Working Agreement</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:kind rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#create"/>
    <ess:workProduct rdf:resource="workproduct/architecture-working-agreement"/>
  </ess:Action>

  <ess:Action rdf:about="action/governance-tune-governance/read/conformance-evidence">
    <ess:name>Read Conformance Evidence</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:kind rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#read"/>
    <ess:workProduct rdf:resource="workproduct/conformance-evidence"/>
  </ess:Action>

  <ess:Action rdf:about="action/governance-tune-governance/read/review-records">
    <ess:name>Read Review Records</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:kind rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#read"/>
    <ess:workProduct rdf:resource="workproduct/review-records"/>
  </ess:Action>

  <ess:Action rdf:about="action/governance-tune-governance/update-alpha/governance">
    <ess:name>Update Governance</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:kind rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#update"/>
    <ess:alpha rdf:resource="alpha/governance"/>
  </ess:Action>

  <ess:ActivityAssociation rdf:about="activity-association/governance-tune-governance/part-of/support-the-team">
    <ess:name>Tune the Governance part-of Support The Team</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:end1 rdf:resource="activity/governance-tune-governance"/>
    <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#SupporttheTeam"/>
    <ess:associationKind>part-of</ess:associationKind>
  </ess:ActivityAssociation>

  <ess:CompletionCriterion rdf:about="criterion/governance-tune-governance/completion/governance">
    <ess:name>Completion: Governance</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:state rdf:resource="state/governance/effective"/>
  </ess:CompletionCriterion>

</rdf:RDF>
