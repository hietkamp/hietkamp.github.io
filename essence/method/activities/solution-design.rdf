<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
  xml:base="https://hietkamp.nl/essence/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:ess="https://www.hietkamp.nl/ontologies/essence-language#"
  xmlns:esk="https://www.hietkamp.nl/ontologies/essence-kernel#"
>

  <ess:Activity rdf:about="activity/solution-design">
    <ess:name xml:lang="nl">Bepaal de oplossingsbouwstenen</ess:name>
    <ess:name xml:lang="en">Define the solution building blocks</ess:name>
    <ess:briefDescription xml:lang="nl">Hero. Definieer solution-bouwstenen en interfaces binnen enterprise-kaders. Selecteer COTS-componenten op basis van sturende eisen. Documenteer afwijkingen …</ess:briefDescription>
    <ess:description xml:lang="nl">Beschrijving. Definieer solution-bouwstenen en interfaces binnen enterprise-kaders. Selecteer COTS-componenten op basis van sturende eisen. Documenteer afwijkingen van enterprise-standaarden als beslissingsrecord op C4 Level 2–3.</ess:description>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:owner rdf:resource="practice/solution-architecture"/>
    <ess:approach rdf:resource="approach/solution-design/default"/>
    <ess:action rdf:resource="action/solution-design/create/architecture-decisions"/>
    <ess:action rdf:resource="action/solution-design/create/architecture-model"/>
    <ess:action rdf:resource="action/solution-design/read/architecture-vision"/>
    <ess:action rdf:resource="action/solution-design/read/paved-road"/>
    <ess:action rdf:resource="action/solution-design/update-alpha/architecture"/>
    <ess:action rdf:resource="action/solution-design/update-alpha/architecture-decisions"/>
    <ess:requiredCompetencyLevel rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#Masters"/>
    <ess:criterion rdf:resource="criterion/solution-design/completion/architecture"/>
    <ess:criterion rdf:resource="criterion/solution-design/completion/architecture-decisions"/>
  </ess:Activity>

  <ess:Approach rdf:about="approach/solution-design/default">
    <ess:name xml:lang="nl">Kiezen</ess:name>
    <ess:name xml:lang="en">Design</ess:name>
    <ess:briefDescription/>
    <ess:description xml:lang="nl">De aanpak is dat de ... Definieer solution-bouwstenen en interfaces binnen enterprise-kaders. Selecteer COTS-componenten op basis van sturende eisen. Documenteer afwijkingen van enterprise-standaarden als beslissingsrecord op C4 Level 2–3.</ess:description>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
  </ess:Approach>

  <ess:Action rdf:about="action/solution-design/create/architecture-decisions">
    <ess:name>Create Architecture Decisions</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:kind rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#create"/>
    <ess:workProduct rdf:resource="workproduct/architecture-decisions"/>
  </ess:Action>

  <ess:Action rdf:about="action/solution-design/create/architecture-model">
    <ess:name>Create Architecture Model</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:kind rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#create"/>
    <ess:workProduct rdf:resource="workproduct/architecture-model"/>
  </ess:Action>

  <ess:Action rdf:about="action/solution-design/read/paved-road">
    <ess:name>Read Paved Road</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:kind rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#read"/>
    <ess:workProduct rdf:resource="workproduct/paved-road"/>
  </ess:Action>

  <ess:Action rdf:about="action/solution-design/update-alpha/architecture">
    <ess:name>Update Architecture</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:kind rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#update"/>
    <ess:alpha rdf:resource="alpha/architecture"/>
  </ess:Action>

  <ess:Action rdf:about="action/solution-design/update-alpha/architecture-decisions">
    <ess:name>Update Architecture Decisions</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:kind rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#update"/>
    <ess:alpha rdf:resource="alpha/architecture-decisions"/>
  </ess:Action>

  <ess:ActivityAssociation rdf:about="activity-association/solution-design/part-of/shape-the-system">
    <ess:name>Kiezen part-of Shape The System</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:end1 rdf:resource="activity/solution-design"/>
    <ess:end2 rdf:resource="https://www.hietkamp.nl/ontologies/essence-kernel#ShapetheSystem"/>
    <ess:associationKind>part-of</ess:associationKind>
  </ess:ActivityAssociation>

  <ess:CompletionCriterion rdf:about="criterion/solution-design/completion/architecture">
    <ess:name>Completion: Architecture</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:state rdf:resource="state/architecture/outlined"/>
  </ess:CompletionCriterion>

  <ess:CompletionCriterion rdf:about="criterion/solution-design/completion/architecture-decisions">
    <ess:name>Completion: Architecture Decisions</ess:name>
    <ess:isSuppressable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ess:isSuppressable>
    <ess:state rdf:resource="state/architecture-decisions/decided"/>
  </ess:CompletionCriterion>

</rdf:RDF>
