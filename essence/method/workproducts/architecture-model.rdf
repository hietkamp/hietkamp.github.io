    <ess:checkListItem rdf:nodeID="checkpoint_lod_code_1"/>
  </ess:LevelOfDetail>

  <ess:Checkpoint rdf:nodeID="checkpoint_lod_code_1">
    <ess:name>1</ess:name>
  </ess:Checkpoint>

  <ess:Resource rdf:about="resource/architecture-model/c4-reference">
