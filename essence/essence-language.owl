        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#targetElement"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <package>Foundation</package>
  </owl:Class>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#state">
    <rdfs:label>state</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Criterion"/>
    <rdfs:comment xml:lang="en">A state to be reached (alternative to a level of detail).</rdfs:comment>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#State"/>
  </owl:FunctionalProperty>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#TypedTag">
    <rdfs:comment xml:lang="en">A tag that has a user defined type.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Tag"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b32">
        <owl:allValuesFrom rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#UserDefinedType"/>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#kind"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b33">
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#kind"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">TypedTag</rdfs:label>
    <package>UserDefinedTypes</package>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#EndeavorAssociation">
    <rdfs:label xml:lang="en">EndeavorAssociation</rdfs:label>
    <package>Foundation</package>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b67">
        <owl:onClass rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#EndeavorProperty"/>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#memberEnd"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment xml:lang="en">Represents associations to be tracked during an endeavor, linking actual instances of elements on metalevel 0 (the endeavor level).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#WorkProductManifest">
    <rdfs:label xml:lang="en">WorkProductManifest</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b72">
        <owl:onClass rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#WorkProduct"/>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#workProduct"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b71">
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Alpha"/>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#alpha"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <package>AlphaAndWorkProduct</package>
    <rdfs:comment xml:lang="en">Binds a work product to an alpha, with multiplicities stating how many instances of the work product describe one instance of the alpha.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#EndeavorProperty">
    <rdfs:label xml:lang="en">EndeavorProperty</rdfs:label>
    <package>Foundation</package>
    <rdfs:comment xml:lang="en">A property to be tracked during an endeavor; can be simple or expressed via an endeavor association.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#ActivityAssociation">
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b40">
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#end2"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b38">
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#end2"/>
        <owl:allValuesFrom rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#AbstractActivity"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b39">
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#end1"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b37">
        <owl:allValuesFrom rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#AbstractActivity"/>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#end1"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <package>ActivitySpaceAndActivity</package>
    <rdfs:comment xml:lang="en">Represents a relationship or dependency between activities (kinds include part-of, start-before-start, start-before-end, end-before-start, end-before-end).</rdfs:comment>
    <rdfs:label xml:lang="en">ActivityAssociation</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#PatternAssociation">
    <package>Foundation</package>
    <rdfs:comment xml:lang="en">A named link between the elements of a pattern.</rdfs:comment>
    <rdfs:label xml:lang="en">PatternAssociation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#State">
    <rdfs:label xml:lang="en">State</rdfs:label>
    <owl:disjointWith rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LevelOfDetail"/>
    <package>AlphaAndWorkProduct</package>
    <rdfs:comment xml:lang="en">A specification of the state of progress of an alpha, determined by evaluating checklist items.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#MergeResolution">
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <rdfs:comment xml:lang="en">An element that provides a solution for a merge conflict by applying a resolution function to conflicting attributes.</rdfs:comment>
    <rdfs:label xml:lang="en">MergeResolution</rdfs:label>
    <package>Foundation</package>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#LevelOfDetail">
    <rdfs:label xml:lang="en">LevelOfDetail</rdfs:label>
    <package>AlphaAndWorkProduct</package>
    <rdfs:comment xml:lang="en">A specification of the amount of detail or range of content in a work product, determined by evaluating checklist items.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Kernel">
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#ElementGroup"/>
    <package>Foundation</package>
    <rdfs:comment xml:lang="en">An element group naming the basic concepts (alphas, activity spaces and competencies) that form a common ground for describing an engineering endeavor in a domain.</rdfs:comment>
    <rdfs:label xml:lang="en">Kernel</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#ElementGroup">
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <owl:disjointWith rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#BasicElement"/>
    <rdfs:label xml:lang="en">ElementGroup</rdfs:label>
    <rdfs:comment xml:lang="en">An Essence concept that names a collection of elements. Groups are recursive: a group may own other groups as well as other elements.</rdfs:comment>
    <package>Foundation</package>
    <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#FeatureSelection">
    <package>View</package>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b68">
        <owl:onClass rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#BasicElement"/>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#construct"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment xml:lang="en">A reference to a construct feature such as a particular attribute or association, to be included in a view.</rdfs:comment>
    <rdfs:label xml:lang="en">FeatureSelection</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#CompletionCriterion">
    <package>ActivitySpaceAndActivity</package>
    <rdfs:label xml:lang="en">CompletionCriterion</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Criterion"/>
    <rdfs:comment xml:lang="en">A criterion that must be satisfied to consider the work of an activity or activity space complete.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Activity">
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b64">
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#approach"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
        <owl:onClass rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Approach"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#AbstractActivity"/>
    <package>ActivitySpaceAndActivity</package>
    <rdfs:label xml:lang="en">Activity</rdfs:label>
    <rdfs:comment xml:lang="en">Defines one or more approaches for carrying out some work to be performed; can recommend actions on alphas and/or work products.</rdfs:comment>
  </owl:Class>
  <ActionKind rdf:about="https://www.hietkamp.nl/ontologies/essence-language#delete">
    <rdfs:comment xml:lang="en">The activity deletes the work product.</rdfs:comment>
    <rdfs:label>delete</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </ActionKind>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Resource">
    <rdfs:label xml:lang="en">Resource</rdfs:label>
    <package>Foundation</package>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <rdfs:comment xml:lang="en">A source of information or content, such as a website, outside the Essence model and referenced from it.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#levelOfDetail">
    <rdfs:comment xml:lang="en">The levels of detail defined for a work product, or the level of detail to be reached by a criterion.</rdfs:comment>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LevelOfDetail"/>
    <rdfs:domain>
      <owl:Class rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b34">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#WorkProduct"/>
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Criterion"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:label>levelOfDetail</rdfs:label>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#GraphicalElement">
    <rdfs:comment xml:lang="en">Placeholder for the graphical syntax type used for icons of basic elements and element groups.</rdfs:comment>
    <rdfs:label xml:lang="en">GraphicalElement</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Method">
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b42">
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Kernel"/>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#baseKernel"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#ElementGroup"/>
    <rdfs:comment xml:lang="en">The composition of a kernel and a set of practices to fulfill a specific purpose. A method may only contain practices.</rdfs:comment>
    <package>Foundation</package>
    <rdfs:label xml:lang="en">Method</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Pattern">
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#BasicElement"/>
    <rdfs:label xml:lang="en">Pattern</rdfs:label>
    <rdfs:comment xml:lang="en">A generic mechanism for naming complex concepts made up of several Essence elements, defined in terms of pattern associations (e.g. roles, phases, milestones).</rdfs:comment>
    <package>Foundation</package>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement">
    <package>Foundation</package>
    <rdfs:comment xml:lang="en">Abstract superclass for an Essence concept. Root for all basic elements, auxiliary elements and element groups.</rdfs:comment>
    <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
    <rdfs:label xml:lang="en">LanguageElement</rdfs:label>
  </owl:Class>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#end1">
    <rdfs:label>end1</rdfs:label>
    <rdfs:comment xml:lang="en">Endpoint 1 of the association: an alpha (AlphaAssociation) or an abstract activity (ActivityAssociation).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain>
      <owl:Class rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b73">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#AlphaAssociation"/>
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#ActivityAssociation"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range>
      <owl:Class rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b76">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Alpha"/>
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#AbstractActivity"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:range>
  </owl:FunctionalProperty>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Criterion">
    <package>ActivitySpaceAndActivity</package>
    <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
    <rdfs:comment xml:lang="en">A condition contributing to determining whether an activity or activity space may be entered or is complete, expressed in terms of the state of an alpha or the level of detail of a work product.</rdfs:comment>
    <rdfs:label xml:lang="en">Criterion</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b90">
        <owl:unionOf rdf:parseType="Collection">
          <owl:Class rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b91">
            <owl:intersectionOf rdf:parseType="Collection">
              <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b92">
                <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#state"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#State"/>
              </owl:Restriction>
              <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b93">
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LevelOfDetail"/>
                <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#levelOfDetail"/>
              </owl:Restriction>
            </owl:intersectionOf>
          </owl:Class>
          <owl:Class rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b96">
            <owl:intersectionOf rdf:parseType="Collection">
              <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b97">
                <owl:onClass rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LevelOfDetail"/>
                <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#levelOfDetail"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
              </owl:Restriction>
              <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b98">
                <owl:onClass rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#State"/>
                <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#state"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
              </owl:Restriction>
            </owl:intersectionOf>
          </owl:Class>
        </owl:unionOf>
      </owl:Class>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#TypedPattern">
    <package>UserDefinedTypes</package>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Pattern"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b29">
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#kind"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b28">
        <owl:allValuesFrom rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#UserDefinedType"/>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#kind"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">TypedPattern</rdfs:label>
    <rdfs:comment xml:lang="en">A pattern that has a user defined type.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#ActivitySpace">
    <package>ActivitySpaceAndActivity</package>
    <rdfs:label xml:lang="en">ActivitySpace</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#AbstractActivity"/>
    <owl:disjointWith rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Activity"/>
    <rdfs:comment xml:lang="en">A placeholder for something to be done in the engineering endeavor; a high-level abstraction using alphas as input.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#CompetencyLevel">
    <rdfs:label xml:lang="en">CompetencyLevel</rdfs:label>
    <rdfs:comment xml:lang="en">Defines a level of how competent or able a team member is with respect to a competency (typically 0 = no competence to 5 = expert).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <package>Competency</package>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#memberEnd">
    <rdfs:label>memberEnd</rdfs:label>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#EndeavorAssociation"/>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#EndeavorProperty"/>
    <rdfs:comment xml:lang="en">End properties of the endeavor association (2 or more).</rdfs:comment>
  </owl:ObjectProperty>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#end2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>end2</rdfs:label>
    <rdfs:domain>
      <owl:Class rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b79">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#AlphaAssociation"/>
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#ActivityAssociation"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range>
      <owl:Class rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b82">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Alpha"/>
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#AbstractActivity"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:range>
    <rdfs:comment xml:lang="en">Endpoint 2 of the association: an alpha (AlphaAssociation) or an abstract activity (ActivityAssociation).</rdfs:comment>
  </owl:FunctionalProperty>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Type">
    <rdfs:comment xml:lang="en">Placeholder for the (UML) type of an endeavor property.</rdfs:comment>
    <rdfs:label xml:lang="en">Type</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#TypedResource">
    <package>UserDefinedTypes</package>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Resource"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b31">
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#kind"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b30">
        <owl:allValuesFrom rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#UserDefinedType"/>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#kind"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment xml:lang="en">A resource that has a user defined type.</rdfs:comment>
    <rdfs:label xml:lang="en">TypedResource</rdfs:label>
  </owl:Class>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#superAlpha">
    <rdfs:comment xml:lang="en">The super alpha of the containment.</rdfs:comment>
    <rdfs:label>superAlpha</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#AlphaContainment"/>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Alpha"/>
  </owl:FunctionalProperty>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#AlphaContainment">
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b66">
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#superAlpha"/>
        <owl:onClass rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Alpha"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b65">
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#subordinateAlpha"/>
        <owl:onClass rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Alpha"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <rdfs:comment xml:lang="en">Represents a sub(ordinate)-alpha relationship between alphas; sub-alphas contribute to and drive the states of superordinate alphas.</rdfs:comment>
    <package>AlphaAndWorkProduct</package>
    <rdfs:label xml:lang="en">AlphaContainment</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#AbstractActivity">
    <rdfs:label xml:lang="en">AbstractActivity</rdfs:label>
    <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
    <package>ActivitySpaceAndActivity</package>
    <rdfs:comment xml:lang="en">Either a placeholder for something to be done or a concrete activity to be performed. Superclass of ActivitySpace and Activity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#BasicElement"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b103">
        <owl:onClass rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Criterion"/>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#criterion"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#UserDefinedType">
    <package>UserDefinedTypes</package>
    <rdfs:label xml:lang="en">UserDefinedType</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <rdfs:comment xml:lang="en">A named type containing a description and constraints, used to detail patterns, resources, and tags.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#AlphaAssociation">
    <rdfs:label xml:lang="en">AlphaAssociation</rdfs:label>
    <package>AlphaAndWorkProduct</package>
    <rdfs:comment xml:lang="en">Represents a relationship between alphas, generally defined by a practice. Has no defined semantics in Essence (unlike alpha containment).</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b114">
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#end1"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b115">
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#end2"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b112">
        <owl:allValuesFrom rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Alpha"/>
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#end1"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b113">
        <owl:onProperty rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#end2"/>
        <owl:allValuesFrom rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Alpha"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#constructSelection">
    <rdfs:comment xml:lang="en">The selected constructs to be included in the view.</rdfs:comment>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#ViewSelection"/>
    <rdfs:label>constructSelection</rdfs:label>
  </owl:ObjectProperty>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#targetElement">
    <rdfs:label>targetElement</rdfs:label>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <rdfs:comment xml:lang="en">The element to be extended. May not be an extension element or merge resolution.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#ExtensionElement"/>
  </owl:FunctionalProperty>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#BasicElement">
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isAbstract>
    <rdfs:label xml:lang="en">BasicElement</rdfs:label>
    <rdfs:comment xml:lang="en">Abstract superclass for all main concepts in Essence other than element groups.</rdfs:comment>
    <package>Foundation</package>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#criterion">
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#AbstractActivity"/>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Criterion"/>
    <rdfs:comment xml:lang="en">Criteria to be fulfilled for entering the activity or considering the activity completed.</rdfs:comment>
    <rdfs:label>criterion</rdfs:label>
  </owl:ObjectProperty>
  <ActionKind rdf:about="https://www.hietkamp.nl/ontologies/essence-language#read">
    <rdfs:comment xml:lang="en">The activity reads the work product but does not change it.</rdfs:comment>
    <rdfs:label>read</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </ActionKind>
  <owl:ObjectProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#states">
    <rdfs:label>states</rdfs:label>
    <rdfs:comment xml:lang="en">The states of the alpha (1 or more, with distinct names).</rdfs:comment>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#State"/>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Alpha"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#featureSelection">
    <rdfs:label>featureSelection</rdfs:label>
    <rdfs:comment xml:lang="en">The selected features (attributes and associations of constructs) to be included in the view.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#ViewSelection"/>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#FeatureSelection"/>
  </owl:ObjectProperty>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#kind">
    <rdfs:domain>
      <owl:Class rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b104">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Action"/>
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#TypedPattern"/>
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#TypedResource"/>
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#TypedTag"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:label>kind</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The kind of an action (ActionKind), or the user defined type of a typed pattern, resource, or tag.</rdfs:comment>
    <rdfs:range>
      <owl:Class rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b109">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#ActionKind"/>
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#UserDefinedType"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:range>
  </owl:FunctionalProperty>
  <ActionKind rdf:about="https://www.hietkamp.nl/ontologies/essence-language#create">
    <rdfs:comment xml:lang="en">The activity creates the work product or alpha.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label>create</rdfs:label>
  </ActionKind>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Checkpoint">
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <package>Foundation</package>
    <rdfs:label xml:lang="en">Checkpoint</rdfs:label>
    <rdfs:comment xml:lang="en">A condition that can be tested as true or false, contributing to determining whether a state of an alpha, a level of detail of a work product, or a competency level has been attained.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Approach">
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <rdfs:label xml:lang="en">Approach</rdfs:label>
    <package>ActivitySpaceAndActivity</package>
    <rdfs:comment xml:lang="en">Defines one way to accomplish some work, specified in the context of a specific activity.</rdfs:comment>
  </owl:Class>
</rdf:RDF>
