<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns="https://www.hietkamp.nl/ontologies/essence-language#"
  xmlns:dcterms="http://purl.org/dc/terms/"
>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#icon">
    <rdfs:comment xml:lang="en">The icon to be used when presenting the element or element group.</rdfs:comment>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#GraphicalElement"/>
    <rdfs:domain>
      <owl:Class rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b8">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#BasicElement"/>
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#ElementGroup"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>icon</rdfs:label>
  </owl:FunctionalProperty>
  <owl:ObjectProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#action">
    <rdfs:comment xml:lang="en">Actions on work products or alphas recommended by this activity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Activity"/>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Action"/>
    <rdfs:label>action</rdfs:label>
  </owl:ObjectProperty>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#upperBound">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>upperBound</rdfs:label>
    <rdfs:domain>
      <owl:Class rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b24">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#EndeavorProperty"/>
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#AlphaContainment"/>
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#WorkProductManifest"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:comment xml:lang="en">Upper bound (of the property, of the number of sub-alpha instances, or of the number of work product instances per alpha instance).</rdfs:comment>
  </owl:FunctionalProperty>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#association">
    <rdfs:comment xml:lang="en">The association used to express this property if it is not a simple property.</rdfs:comment>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#EndeavorAssociation"/>
    <rdfs:label>association</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#EndeavorProperty"/>
  </owl:FunctionalProperty>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#featureName">
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#FeatureSelection"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>featureName</rdfs:label>
    <rdfs:comment xml:lang="en">The name of the referred feature, such as the name of an attribute or the role name of an association.</rdfs:comment>
  </owl:FunctionalProperty>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#shortDescription">
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Checkpoint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>shortDescription</rdfs:label>
    <rdfs:comment xml:lang="en">An optional abbreviated version of the full description of a checkpoint.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:FunctionalProperty>
  <owl:DatatypeProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>description</rdfs:label>
    <rdfs:comment xml:lang="en">A more detailed description of the element; may be written in a markup language.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#isSuppressable">
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <rdfs:label>isSuppressable</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Whether this element may be suppressed in an extension or composition.</rdfs:comment>
  </owl:FunctionalProperty>
  <owl:DatatypeProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#level">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>level</rdfs:label>
    <rdfs:comment xml:lang="en">A numeric indicator for the competency level; higher means more/better competence.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#CompetencyLevel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#input">
    <rdfs:label>input</rdfs:label>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#ActivitySpace"/>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Alpha"/>
    <rdfs:comment xml:lang="en">Alphas that have to be present to be successful in fulfilling the objectives of this activity space.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#owningAssociation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#ownedEnd">
        <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#EndeavorProperty"/>
        <rdfs:comment xml:lang="en">The properties owned by this endeavor association.</rdfs:comment>
        <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#EndeavorAssociation"/>
        <rdfs:label>ownedEnd</rdfs:label>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#EndeavorProperty"/>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#EndeavorAssociation"/>
    <rdfs:comment xml:lang="en">The association owning this property.</rdfs:comment>
    <rdfs:label>owningAssociation</rdfs:label>
  </owl:ObjectProperty>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#objective">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Practice"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The objective of this practice, expressed as a concise and isolated phrase.</rdfs:comment>
    <rdfs:label>objective</rdfs:label>
  </owl:FunctionalProperty>
  <owl:ObjectProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#propertyType">
    <rdfs:comment xml:lang="en">The type of the endeavor property (attribute 'type' in the specification).</rdfs:comment>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Type"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#EndeavorProperty"/>
    <rdfs:label>type</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#ownedElements">
    <owl:inverseOf>
      <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#owner">
        <rdfs:label>owner</rdfs:label>
        <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
        <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#ElementGroup"/>
        <rdfs:comment xml:lang="en">The element group that owns this language element. All language elements that are not element groups need an owner.</rdfs:comment>
      </owl:FunctionalProperty>
    </owl:inverseOf>
    <rdfs:comment xml:lang="en">The language elements this group owns by value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#ElementGroup"/>
    <rdfs:label>ownedElements</rdfs:label>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#tags">
    <rdfs:comment xml:lang="en">Tags associated with this language element.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Tag"/>
    <rdfs:label>tags</rdfs:label>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#measures">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>measures</rdfs:label>
    <rdfs:comment xml:lang="en">Standard units used to evaluate the practice performance and the objectives' achievement.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Practice"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#value">
    <rdfs:comment xml:lang="en">The (non-empty) value of the tag.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Tag"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#extensionFunction">
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#ExtensionElement"/>
    <rdfs:comment xml:lang="en">The function applied to the target attribute.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>extensionFunction</rdfs:label>
  </owl:FunctionalProperty>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#lowerBound">
    <rdfs:comment xml:lang="en">Lower bound (of the property, of the number of sub-alpha instances, or of the number of work product instances per alpha instance).</rdfs:comment>
    <rdfs:label>lowerBound</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain>
      <owl:Class rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b11">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#EndeavorProperty"/>
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#AlphaContainment"/>
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#WorkProductManifest"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:FunctionalProperty>
  <owl:DatatypeProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#resolutionFunction">
    <rdfs:comment xml:lang="en">The function applied to the target attribute to resolve the merge conflict.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>resolutionFunction</rdfs:label>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#MergeResolution"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#end2LowerBound">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:comment xml:lang="en">Lower bound of association endpoint 2.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>end2LowerBound</rdfs:label>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#AlphaAssociation"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#targetAttribute">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The name of the attribute which is to be extended, or on which a merge conflict is solved.</rdfs:comment>
    <rdfs:domain>
      <owl:Class rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b21">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#ExtensionElement"/>
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#MergeResolution"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:label>targetAttribute</rdfs:label>
  </owl:DatatypeProperty>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#consistencyRules">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain>
      <owl:Class rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b5">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Kernel"/>
          <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Practice"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Rules on the consistency of a particular kernel or practice (plain text or OCL recommended).</rdfs:comment>
    <rdfs:label>consistencyRules</rdfs:label>
  </owl:FunctionalProperty>
  <owl:Ontology rdf:about="https://www.hietkamp.nl/ontologies/essence-language">
    <owl:versionInfo>1.0</owl:versionInfo>
    <rdfs:comment xml:lang="en">OWL ontology of the Essence language metamodel (packages Foundation, AlphaAndWorkProduct, ActivitySpaceAndActivity, Competency, UserDefinedTypes, View), derived from OMG Essence v2.0 beta 2 (ptc/25-05-01), clause 9.3.</rdfs:comment>
    <dcterms:source>OMG document ptc/25-05-01, Kernel and Language for Engineering Methods (Essence), v2.0 beta 2</dcterms:source>
    <rdfs:label xml:lang="en">Essence – Kernel and Language for Engineering Methods (Language Metamodel)</rdfs:label>
  </owl:Ontology>
  <owl:ObjectProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#possibleLevel">
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#CompetencyLevel"/>
    <rdfs:comment xml:lang="en">The levels defined for this competency (distinct names and numbers).</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Competency"/>
    <rdfs:label>possibleLevel</rdfs:label>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://www.hietkamp.nl/ontologies/essence-language#EntryCriterion">
    <package>ActivitySpaceAndActivity</package>
    <rdfs:comment xml:lang="en">A criterion that must be satisfied before the work of an activity can be started.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Criterion"/>
    <owl:disjointWith rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#CompletionCriterion"/>
    <rdfs:label xml:lang="en">EntryCriterion</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#elements">
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#LanguageElement"/>
    <rdfs:label>elements</rdfs:label>
    <rdfs:comment xml:lang="en">The elements taking part in the pattern via this association. May not refer to pattern associations, element groups, extension elements, or merge resolutions.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#PatternAssociation"/>
  </owl:ObjectProperty>
  <owl:AllDisjointClasses rdf:nodeID="n20f8e6de325b40e0aedb63bd63176f69b117">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Alpha"/>
      <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#WorkProduct"/>
      <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Pattern"/>
      <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#Competency"/>
      <rdf:Description rdf:about="https://www.hietkamp.nl/ontologies/essence-language#AbstractActivity"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#purpose">
    <rdfs:label>purpose</rdfs:label>
    <rdfs:comment xml:lang="en">The purpose of this method: a short statement describing the goal the method pursues.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Method"/>
  </owl:FunctionalProperty>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#targetName">
    <rdfs:label>targetName</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#MergeResolution"/>
    <rdfs:comment xml:lang="en">The name of the element on which the merge conflict is solved.</rdfs:comment>
  </owl:FunctionalProperty>
  <owl:DatatypeProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#entry">
    <rdfs:label>entry</rdfs:label>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Practice"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Expected characteristics of elements needed to start the execution of a practice.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#requiredCompetencyLevel">
    <rdfs:label>requiredCompetencyLevel</rdfs:label>
    <rdfs:comment xml:lang="en">Competency levels required for completing this activity successfully.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Activity"/>
    <rdfs:range rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#CompetencyLevel"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#content">
    <rdfs:label>content</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">A reference to the content of the resource, e.g. a hyperlink or a full text document.</rdfs:comment>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#Resource"/>
  </owl:DatatypeProperty>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#name">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>name</rdfs:label>
    <rdfs:comment xml:lang="en">The name of the element (defined on basic elements, element groups, checkpoints, states, levels of detail, competency levels, associations, approaches, user defined types, endeavor properties, and view selections).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </owl:FunctionalProperty>
  <owl:FunctionalProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#associationKind">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The kind of the activity association: part-of, start-before-start, start-before-end, end-before-start, or end-before-end. (Attribute 'kind' in the specification; renamed here to avoid a clash with the object property 'kind'.)</rdfs:comment>
    <rdfs:label>kind (ActivityAssociation)</rdfs:label>
    <rdfs:domain rdf:resource="https://www.hietkamp.nl/ontologies/essence-language#ActivityAssociation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </owl:FunctionalProperty>
  <owl:AnnotationProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#package">
    <rdfs:comment xml:lang="en">The Essence metamodel package in which the element is defined.</rdfs:comment>
    <rdfs:label>package</rdfs:label>
  </owl:AnnotationProperty>
  <owl:DatatypeProperty rdf:about="https://www.hietkamp.nl/ontologies/essence-language#briefDescription">
    <rdfs:comment xml:lang="en">A short and concise description of what the element is.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>briefDescription</rdfs:label>
  </owl:DatatypeProperty>
